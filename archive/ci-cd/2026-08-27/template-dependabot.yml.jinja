version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    target-branch: {% if branch_strategy == "delivery" %}dev/next{% else %}{{ branch_strategy }}{% endif %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      # Keep third-party and major Action upgrades isolated for review.
      official-actions:
        patterns: ["actions/*"]
        update-types: [minor, patch]
{%- if language in ["python", "python-typescript"] %}
  - package-ecosystem: uv
    directory: /
    target-branch: {% if branch_strategy == "delivery" %}dev/next{% else %}{{ branch_strategy }}{% endif %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      routine-updates:
        patterns: ["*"]
        update-types: [minor, patch]
{%- endif %}
{%- if language in ["typescript", "python-typescript"] %}
  - package-ecosystem: npm
    directory: /
    target-branch: {% if branch_strategy == "delivery" %}dev/next{% else %}{{ branch_strategy }}{% endif %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      routine-updates:
        patterns: ["*"]
        update-types: [minor, patch]
{%- endif %}
{%- if (container_mode | default("none")) != "none" %}
  - package-ecosystem: docker
    directory: /{% if "/" in containerfile_path %}{{ containerfile_path.rsplit("/", 1)[0] }}{% endif %}
    target-branch: {% if branch_strategy == "delivery" %}dev/next{% else %}{{ branch_strategy }}{% endif %}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
{%- endif %}

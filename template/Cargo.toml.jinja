[package]
name = "{{ project_slug }}"
version = "0.1.0-alpha.1"
edition = "2024"
rust-version = "1.98"
description = {{ project_description | tojson }}
repository = {{ repository_url | tojson }}
{% if documentation_mode != 'off' -%}
readme = "README.md"
{% endif -%}
{% if project_license == 'proprietary' %}license-file = "LICENSE"
{% else %}license = "{{ project_license }}"
{% endif %}

[dependencies]

name: Template update

on:
  schedule:
    - cron: "41 3 * * 1"
  workflow_dispatch:

permissions:
  contents: read
  issues: write

concurrency:
  group: template-update-{% raw %}${{ github.repository }}{% endraw %}
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
      - name: Install Copier
        run: uv tool install copier==9.17.2
      - name: Configure private template access
        env:
          TEMPLATE_TOKEN: {% raw %}${{ secrets.CSARC_TEMPLATE_READ_TOKEN }}{% endraw %}
        run: |
          if [[ -n "$TEMPLATE_TOKEN" ]]; then
            echo "::add-mask::$TEMPLATE_TOKEN"
            git config --global \
              url."https://x-access-token:${TEMPLATE_TOKEN}@github.com/".insteadOf \
              "https://github.com/"
          fi
      - name: Check for a template update
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: ./.csarc/scripts/check-template-update

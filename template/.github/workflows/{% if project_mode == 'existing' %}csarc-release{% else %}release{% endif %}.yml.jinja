      attestations: write
      contents: read
      id-token: write
      packages: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: {% raw %}${{ github.ref }}{% endraw %}
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: container-evidence
          path: container-evidence
      - name: Verify and load the preserved container bytes
        run: |
          (
            cd container-evidence
            shasum -a 256 -c SHA256SUMS
          )
          docker load --input container-evidence/image.tar
      - name: Publish immutable GHCR tags
        id: publish
        env:
          GHCR_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          image="ghcr.io/${GITHUB_REPOSITORY,,}"
          printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          docker tag "csarc-release:$GITHUB_SHA" "$image:$GITHUB_REF_NAME"
          docker tag "csarc-release:$GITHUB_SHA" "$image:sha-$GITHUB_SHA"
          docker push "$image:$GITHUB_REF_NAME"
          docker push "$image:sha-$GITHUB_SHA"
          digest="sha256:$(docker buildx imagetools inspect "$image:$GITHUB_REF_NAME" --raw | shasum -a 256 | cut -d ' ' -f 1)"
          commit_digest="sha256:$(docker buildx imagetools inspect "$image:sha-$GITHUB_SHA" --raw | shasum -a 256 | cut -d ' ' -f 1)"
          test "$digest" = "$commit_digest"
          echo "image=$image" >> "$GITHUB_OUTPUT"
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - name: Attest container build provenance
        uses: actions/attest-build-provenance@977bb373ede98d70efdf65b84cb5f73e068dcc2a # v3.0.0
        with:
          subject-name: {% raw %}${{ steps.publish.outputs.image }}{% endraw %}
          subject-digest: {% raw %}${{ steps.publish.outputs.digest }}{% endraw %}
          push-to-registry: true
      - name: Attest container software bill of materials
        uses: actions/attest-sbom@4651f806c01d8637787e274ac3bdf724ef169f34 # v3.0.0
        with:
          subject-name: {% raw %}${{ steps.publish.outputs.image }}{% endraw %}
          subject-digest: {% raw %}${{ steps.publish.outputs.digest }}{% endraw %}
          sbom-path: container-evidence/sbom.spdx.json
          push-to-registry: true
      - name: Verify and smoke-test the published digest
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          IMAGE: {% raw %}${{ steps.publish.outputs.image }}@${{ steps.publish.outputs.digest }}{% endraw %}
        run: |
          docker pull "$IMAGE"
{{ container_smoke_command | indent(10, true) }}
          gh attestation verify "oci://$IMAGE" \
            --repo "$GITHUB_REPOSITORY" \
            --signer-workflow "$GITHUB_REPOSITORY/.github/workflows/{{ release_workflow }}" \
            --source-digest "$GITHUB_SHA" \
            --source-ref "$GITHUB_REF"
      - name: Record publication failure
        if: {% raw %}${{ failure() }}{% endraw %}
        run: echo "Container publication failed; the verified build remains an Actions artifact and is not a successful release." >> "$GITHUB_STEP_SUMMARY"
{% endif %}
# This workflow creates release evidence; deployment remains project-specific.

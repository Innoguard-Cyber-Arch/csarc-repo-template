{% if publish_container %}
  container-build:
    name: build and verify container
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: {% raw %}${{ github.ref }}{% endraw %}
      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3.12.0
      - name: Build the release container once
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6.18.0
        with:
          context: .
          file: {{ containerfile_path }}
          load: true
          push: false
          tags: csarc-release:{% raw %}${{ github.sha }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Smoke-test the release container
        env:
          IMAGE: csarc-release:{% raw %}${{ github.sha }}{% endraw %}
        run: |
{{ container_smoke_command | indent(10, true) }}
      - name: Scan the release container
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: csarc-release:{% raw %}${{ github.sha }}{% endraw %}
          scan-type: image
          scanners: vuln
          vuln-type: os,library
          ignore-unfixed: true
          severity: HIGH,CRITICAL
          exit-code: 1
      - name: Prepare the container evidence directory
        run: mkdir -p container-evidence
      - name: Generate the container SBOM
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0.24.0
        with:
          image: csarc-release:{% raw %}${{ github.sha }}{% endraw %}
          format: spdx-json
          output-file: container-evidence/sbom.spdx.json
          syft-version: v1.50.0
          upload-artifact: false
          upload-release-assets: false
          dependency-snapshot: false
      - name: Preserve the verified container bytes
        run: |
          docker save csarc-release:"$GITHUB_SHA" --output container-evidence/image.tar
          (
            cd container-evidence
            shasum -a 256 image.tar sbom.spdx.json > SHA256SUMS
          )
      - name: Upload verified container evidence
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: container-evidence
          path: container-evidence/
          if-no-files-found: error
          retention-days: 30
{% endif %}
{% if has_python and publish_python %}
  publish-python:
    name: publish-python
    if: github.ref_type == 'tag'
    needs: publish-evidence
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: {{ pypi_environment | tojson }}
      url: https://pypi.org/p/{{ project_slug }}
    permissions:
      contents: read
      id-token: write
{% if enable_attestations %}
      attestations: read
{% endif %}
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-evidence
          path: release-evidence
      - name: Select Python distributions
        run: |
          mkdir pypi-dist
          find release-evidence -maxdepth 1 -type f \
            \( -name '*.whl' -o -name '*.tar.gz' \) \
            -exec cp {} pypi-dist/ \;
          find pypi-dist -maxdepth 1 -type f -print -quit | grep -q .
{% if enable_attestations %}
      - name: Verify Python build provenance before publishing
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          mapfile -t packages < <(
            find pypi-dist -maxdepth 1 -type f \
              \( -name '*.whl' -o -name '*.tar.gz' \)
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -gt 0 ]]
          for package in "{% raw %}${packages[@]}{% endraw %}"; do
            gh attestation verify "$package" \
              --repo "$GITHUB_REPOSITORY" \
              --signer-workflow \
                "$GITHUB_REPOSITORY/.github/workflows/{{ release_workflow }}" \
              --source-digest "$GITHUB_SHA" \
              --source-ref "$GITHUB_REF"
          done
{% endif %}
      - name: Publish to PyPI with OIDC
        uses: pypa/gh-action-pypi-publish@a892a5a61159132606e93a2fa6f4358831b04d26 # v1.14.2
        with:
          packages-dir: pypi-dist/
{% endif %}
{% if has_typescript and publish_npm %}
  publish-npm:
    name: publish-npm
    if: github.ref_type == 'tag'
    needs: publish-evidence
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: {{ npm_environment | tojson }}
      url: https://www.npmjs.com/package/{{ project_slug }}
    permissions:
      contents: read
      id-token: write
{% if enable_attestations %}

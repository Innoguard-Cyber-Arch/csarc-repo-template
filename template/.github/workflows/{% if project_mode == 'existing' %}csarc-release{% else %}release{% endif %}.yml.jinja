          package-manager-cache: false
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-evidence
          path: release-evidence
{% if enable_attestations %}
      - name: Verify npm build provenance before publishing
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          mapfile -t packages < <(
            find release-evidence -maxdepth 1 -type f -name '*.tgz'
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -eq 1 ]]
          gh attestation verify "{% raw %}${packages[0]}{% endraw %}" \
            --repo "$GITHUB_REPOSITORY" \
            --signer-workflow \
              "$GITHUB_REPOSITORY/.github/workflows/{{ release_workflow }}" \
            --source-digest "$GITHUB_SHA" \
            --source-ref "$GITHUB_REF"
{% endif %}
      - name: Publish to npm with OIDC
        run: |
          mapfile -t packages < <(
            find release-evidence -maxdepth 1 -type f -name '*.tgz'
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -eq 1 ]] || {
            echo "Expected exactly one npm package tarball." >&2
            exit 1
          }
          expected_repo_url="https://github.com/${GITHUB_REPOSITORY}.git"
          actual_repo_url="$(
            tar -xOf "${packages[0]}" package/package.json |
              node -e 'let input = ""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => console.log(JSON.parse(input).repository?.url ?? ""));'
          )"
          [[ "$actual_repo_url" == "$expected_repo_url" ]] || {
              echo "package.json repository.url must match ${expected_repo_url}." >&2
              exit 1
            }
          npm publish "${packages[0]}" --provenance --access public

{% set python_mode = python_support_mode | default("latest") -%}
{% set python_min = python_min_version | default("3.12") -%}
{% set python_latest = "3.14" -%}
{% set python_target = python_latest if python_mode == "latest" else python_min -%}
{% set python_min_minor = python_target.split(".")[1] | int -%}
{% set python_latest_minor = python_latest.split(".")[1] | int -%}
{% set has_python = language in ["python", "python-typescript"] -%}
{% set has_typescript = language in ["typescript", "python-typescript"] -%}
name: CI

on:
  pull_request:
  merge_group:
    types: [checks_requested]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' && !startsWith(github.event.pull_request.head.ref, 'dev') && !startsWith(github.event.pull_request.head.ref, 'release-please--') && !contains(github.event.pull_request.labels.*.name, 'promotion') && !contains(github.event.pull_request.labels.*.name, 'hotfix') }}{% endraw %}

permissions:
  actions: read
  contents: read
  issues: read
  pull-requests: read

jobs:
  fast:
    name: route and fast checks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    outputs:
      tier: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
      reason: {% raw %}${{ steps.plan.outputs.reason }}{% endraw %}
      scopes: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
      run_governance: {% raw %}${{ steps.plan.outputs.run_governance }}{% endraw %}
      run_osv: {% raw %}${{ steps.plan.outputs.run_osv }}{% endraw %}
      run_zizmor: {% raw %}${{ steps.plan.outputs.run_zizmor }}{% endraw %}
    steps:
      - name: Start timing
        id: started
        run: echo "epoch=$(date +%s)" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Select verification tier
        id: plan
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || '' }}{% endraw %}
          EVENT_NAME: {% raw %}${{ github.event_name }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          LABELS: {% raw %}${{ join(github.event.pull_request.labels.*.name, ',') }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref || github.event.merge_group.head_ref || '' }}{% endraw %}
        run: |
          files="$RUNNER_TEMP/changed-files"
          if [[ -n "$BASE_SHA" && -n "$HEAD_SHA" ]]; then
            git diff --name-only -z "$BASE_SHA" "$HEAD_SHA" > "$files"
          else
            git ls-files -z > "$files"
          fi
          args=()
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            args+=(--force-full)
          fi
          python3 scripts/ci_tier.py \
            --event "$EVENT_NAME" \
            --base "${PR_BASE#refs/heads/}" \
            --head "${PR_HEAD#refs/heads/}" \
            --labels "$LABELS" \
            --files-from "$files" \
            --output-json ci-plan.json \
            --github-output "$GITHUB_OUTPUT" \
            --summary "$GITHUB_STEP_SUMMARY" \
            "${args[@]}"
{%- if has_python %}
      - if: {% raw %}${{ steps.plan.outputs.tier == 'fast' }}{% endraw %}
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_target }}"
      - if: {% raw %}${{ steps.plan.outputs.tier == 'fast' }}{% endraw %}
        uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
{%- endif %}
{%- if has_typescript %}
      - if: {% raw %}${{ steps.plan.outputs.tier == 'fast' }}{% endraw %}
        uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - if: {% raw %}${{ steps.plan.outputs.tier == 'fast' }}{% endraw %}
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          cache: pnpm
{%- endif %}
      - name: Run change-aware checks
        if: {% raw %}${{ steps.plan.outputs.tier == 'docs' || steps.plan.outputs.tier == 'fast' }}{% endraw %}
        env:
          CSARC_CI_SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
          CSARC_CI_TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
{%- if has_python %}
          CSARC_PYTHON_VERSION: "{{ python_target }}"
{%- endif %}
        run: ./scripts/verify-fast
      - name: Verify portable decision site
        run: python3 scripts/render_site.py --check
      - name: Upload portable decision site
        if: {% raw %}${{ steps.plan.outputs.upload_site == 'true' }}{% endraw %}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: portable-decision-site
          path: docs/index.html
          if-no-files-found: error
          retention-days: 14
      - name: Record routing duration
        if: {% raw %}${{ always() }}{% endraw %}
        env:
          STARTED_AT: {% raw %}${{ steps.started.outputs.epoch }}{% endraw %}
        run: |
          duration=$(( $(date +%s) - STARTED_AT ))
          if [[ -f ci-plan.json ]]; then
            python3 - "$duration" <<'PY'
          import json
          import sys
          from pathlib import Path

          path = Path("ci-plan.json")
          plan = json.loads(path.read_text(encoding="utf-8"))
          plan["fast_job_seconds"] = int(sys.argv[1])
          path.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
          PY
          fi
          echo "- Fast job duration: \`${duration}s\`" >> "$GITHUB_STEP_SUMMARY"
      - name: Publish CI routing evidence
        if: {% raw %}${{ always() }}{% endraw %}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: ci-plan-{% raw %}${{ github.run_id }}-${{ github.run_attempt }}{% endraw %}
          path: ci-plan.json
          if-no-files-found: warn
          retention-days: 30

  full:
    name: full verification{% if not use_reusable_workflow %} ({% raw %}${{ matrix.runtime }}{% endraw %}){% endif %}
    needs: fast
    if: {% raw %}${{ needs.fast.outputs.tier == 'full' }}{% endraw %}
{%- if use_reusable_workflow %}
    uses: Innoguard-Cyber-Arch/csarc-repo-template/.github/workflows/reusable-ci.yml@{{ workflow_ref }}
    with:
      language-profile: "{{ language }}"
{%- if has_python %}
      python-versions: >-
        ["{{ python_target }}.0"{% for minor in range(python_min_minor, python_latest_minor + 1) %}, "3.{{ minor }}"{% endfor %}]
{%- else %}
      python-versions: '["none"]'
{%- endif %}
{%- if has_typescript %}
      node-version: "24"
{%- endif %}
{%- else %}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        runtime:
{%- if has_python %}
          - "{{ python_target }}.0"
{%- for minor in range(python_min_minor, python_latest_minor + 1) %}
          - "3.{{ minor }}"
{%- endfor %}
{%- else %}
          - "none"
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
{%- if has_python %}
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: {% raw %}${{ matrix.runtime }}{% endraw %}
{%- endif %}
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
{%- if has_typescript %}
      - uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          cache: pnpm
{%- endif %}
      - name: Verify declared language modules
        run: ./scripts/verify
{%- if has_python %}
        env:
          CSARC_PYTHON_VERSION: {% raw %}${{ matrix.runtime }}{% endraw %}
          UV_PROJECT_ENVIRONMENT: .venv-{% raw %}${{ matrix.runtime }}{% endraw %}
{%- endif %}
{%- endif %}

  governance:
    name: remote governance
    needs: fast
    if: {% raw %}${{ needs.fast.outputs.run_governance == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.base.sha || github.sha }}{% endraw %}
      - name: Check effective repository governance
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: ./scripts/apply-repository-settings.sh check

  osv:
    name: dependency vulnerability scan
    needs: fast
    if: {% raw %}${{ needs.fast.outputs.run_osv == 'true' }}{% endraw %}
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@6e4298ebc4db23e847df9b2e2de2939d6f066c67 # v2.5.1
    with:
      scan-args: |-
        --include-git-root
        -r
        ./
      upload-sarif: false
      fail-on-vuln: true

  zizmor:
    name: workflow audit
    needs: fast
    if: {% raw %}${{ needs.fast.outputs.run_zizmor == 'true' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
      - name: Audit workflow definitions
        run: uvx --from zizmor==1.29.0 zizmor . --format plain

  verify:
    name: verify
    if: {% raw %}${{ always() }}{% endraw %}
    needs: [fast, full, governance, osv, zizmor]
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Require every applicable check
        env:
          FAST_RESULT: {% raw %}${{ needs.fast.result }}{% endraw %}
          FULL_RESULT: {% raw %}${{ needs.full.result }}{% endraw %}
          GOVERNANCE_RESULT: {% raw %}${{ needs.governance.result }}{% endraw %}
          OSV_RESULT: {% raw %}${{ needs.osv.result }}{% endraw %}
          ZIZMOR_RESULT: {% raw %}${{ needs.zizmor.result }}{% endraw %}
        run: |
          test "$FAST_RESULT" = success
          for result in "$FULL_RESULT" "$GOVERNANCE_RESULT" "$OSV_RESULT" "$ZIZMOR_RESULT"; do
            [[ "$result" == success || "$result" == skipped ]]
          done

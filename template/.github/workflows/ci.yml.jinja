{% set python_target = "3.14" if python_floor == "latest" else python_floor -%}
{% set has_python = "python" in languages -%}
{% set has_typescript = "typescript" in languages -%}
{% set has_rust = "rust" in languages -%}
{% set has_go = "go" in languages -%}
name: CI

on:
  pull_request_target:
    types: [opened, reopened, synchronize, edited, labeled, unlabeled, ready_for_review, converted_to_draft]
  merge_group:
    types: [checks_requested]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  actions: read
  checks: read
  contents: read
  issues: read
  pull-requests: read

jobs:
  verify:
    # Every label event on a ready PR reports `verify`: a non-tier label reuses
    # the same-head evidence instead of leaving a newer CI run without it.
    name: verify
    if: >-
      {% raw %}${{
        github.event_name != 'pull_request_target' ||
        github.event.action == 'ready_for_review' ||
        (github.event.action != 'converted_to_draft' &&
        github.event.pull_request.draft != true)
      }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Check out the trusted verification policy
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.sha }}{% endraw %}
      - name: Set up Python 3.14 for the trusted verification policy
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.14"
      - name: Preserve the trusted verification policy
        id: trusted
        env:
          GUIDED_RELEASE: {% raw %}${{ github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') }}{% endraw %}
        run: |
          mkdir -p "$RUNNER_TEMP/trusted-verification"
          cp .csarc/scripts/*.py .csarc/scripts/check-trusted-verification \
            "$RUNNER_TEMP/trusted-verification/"
          # Issue #1325: release ownership decides which release checks
          # run, so it is read from this trusted base, not the candidate.
          cp .csarc/config.yml "$RUNNER_TEMP/trusted-verification/base-config.yml"
          # Issue #1086: the entry point, stage gate, router, and config
          # reader that decide the required result come from this trusted
          # base, never from the candidate checked out next.
          if [[ -f .csarc/scripts/trusted_executor.py ]]; then
            python3 .csarc/scripts/trusted_executor.py prepare \
              --source "$GITHUB_WORKSPACE" \
              --destination "$RUNNER_TEMP/trusted-executor"
            echo "executor=trusted-base" >> "$GITHUB_OUTPUT"
          else
            echo "::warning title=Trusted verification executor::This pull request base predates the trusted executor; verification runs the candidate entry point and is recorded as candidate-legacy until the base is synchronized."
            echo "executor=candidate-legacy" >> "$GITHUB_OUTPUT"
          fi
          # Issue #1106: the guided release candidate check comes from the
          # same trusted base; its step fails closed without this copy.
          if [[ "$GUIDED_RELEASE" == "true" && -f .csarc/scripts/verify-release-candidate ]]; then
            python3 .csarc/scripts/trusted_executor.py prepare \
              --control-set release \
              --source "$GITHUB_WORKSPACE" \
              --destination "$RUNNER_TEMP/trusted-release"
          fi
      - name: Check out the exact candidate
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
      - name: Read release ownership
        id: release
        # The trusted reader must accept the candidate configuration; a value
        # or schema it does not understand fails this step instead of
        # silently skipping the release checks below. The value itself
        # comes from the trusted base (Issue #1325).
        run: |
          python3 "$RUNNER_TEMP/trusted-verification/csarc_config.py" release_ownership >/dev/null
          ownership="$(python3 "$RUNNER_TEMP/trusted-verification/csarc_config.py" \
            --config "$RUNNER_TEMP/trusted-verification/base-config.yml" release_ownership)"
          echo "ownership=$ownership" >> "$GITHUB_OUTPUT"
      - name: Validate synchronization structure before verification
        id: sync
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          EVENT_NAME: {% raw %}${{ github.event_name }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || '' }}{% endraw %}
          PR_BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || '' }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref || '' }}{% endraw %}
          PR_HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || '' }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number || '' }}{% endraw %}
        run: |
          {
            echo "route=ordinary"
            echo "clean=false"
          } >> "$GITHUB_OUTPUT"
          if [[ "$EVENT_NAME" != "pull_request_target" || "$PR_HEAD" != sync/main-to-* ]]; then
            exit 0
          fi
          main_sha="$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)"
          sync_result="$(python3 "$RUNNER_TEMP/trusted-verification/delivery_sync.py" verify-sync \
            --repo "$GITHUB_REPOSITORY" \
            --pr-number "$PR_NUMBER" \
            --base "$PR_BASE" \
            --base-sha "$PR_BASE_SHA" \
            --head-ref "$PR_HEAD" \
            --head-sha "$PR_HEAD_SHA" \
            --main-sha "$main_sha" \
            --github-output "$GITHUB_OUTPUT")"
          if [[ "$sync_result" != "clean" ]]; then
            echo "route=manual" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          evidence="$RUNNER_TEMP/main-verification.json"
          python3 "$RUNNER_TEMP/trusted-verification/check-trusted-verification" \
            "$main_sha" \
            --github-repo "$GITHUB_REPOSITORY" \
            --resolve-merge-source \
            --required-tier full > "$evidence"
          source_run="$(jq -r 'if .reused then .source_run_id else .run_id end' "$evidence")"
          source_job="$(jq -r 'if .reused then .source_job_id else .job_id end' "$evidence")"
          source_check="$(jq -r 'if .reused then .source_check_run_id else .check_run_id end' "$evidence")"
          {
            echo "route=clean"
            echo "main_sha=$main_sha"
            echo "source_run=$source_run"
            echo "source_job=$source_job"
            echo "source_check=$source_check"
          } >> "$GITHUB_OUTPUT"
      - name: Select trusted verification plan
        id: plan
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || '' }}{% endraw %}
          EVENT_NAME: {% raw %}${{ github.event_name == 'pull_request_target' && 'pull_request' || github.event_name }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          LABELS: {% raw %}${{ join(github.event.pull_request.labels.*.name, ',') }}{% endraw %}
          PR_DRAFT: {% raw %}${{ github.event.pull_request.draft || false }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref || github.event.merge_group.head_ref || '' }}{% endraw %}
          SYNC_CLEAN: {% raw %}${{ steps.sync.outputs.clean }}{% endraw %}
        run: |
          files="$RUNNER_TEMP/changed-files"
          if [[ -n "$BASE_SHA" && -n "$HEAD_SHA" ]]; then
            merge_base="$(git merge-base "$BASE_SHA" "$HEAD_SHA")"
            git diff --no-renames --name-only -z "$merge_base" "$HEAD_SHA" > "$files"
          else
            git ls-files -z > "$files"
          fi
          args=()
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            args+=(--force-full)
          fi
          sync_args=()
          if [[ "$SYNC_CLEAN" == "true" ]]; then
            sync_args+=(--verified-sync)
          fi
          python3 "$RUNNER_TEMP/trusted-verification/ci_tier.py" \
            --event "$EVENT_NAME" \
            --base "${PR_BASE#refs/heads/}" \
            --head "${PR_HEAD#refs/heads/}" \
            --labels "$LABELS" \
            --draft "$PR_DRAFT" \
            --files-from "$files" \
            --output-json ci-plan.json \
            --github-output "$GITHUB_OUTPUT" \
            --summary "$GITHUB_STEP_SUMMARY" \
            "${args[@]}" \
            "${sync_args[@]}"
          cp ci-plan.json "$RUNNER_TEMP/trusted-ci-plan.json"
          printf '%s\0' --event "$EVENT_NAME" --base "${PR_BASE#refs/heads/}" --head "${PR_HEAD#refs/heads/}" --labels "$LABELS" --draft "$PR_DRAFT" --files-from "$files" "${args[@]}" "${sync_args[@]}" > "$RUNNER_TEMP/trusted-router-args"
      - name: Resolve release-level verification suite
        id: level
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PATH_TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number || '' }}{% endraw %}
        run: |
          if [[ -n "$PR_NUMBER" ]]; then
            python3 "$RUNNER_TEMP/trusted-verification/release_level.py" resolve-pr \
              --repo "$GITHUB_REPOSITORY" \
              --pr "$PR_NUMBER" \
              --path-tier "$PATH_TIER" \
              --github-output "$GITHUB_OUTPUT"
          else
            echo "suite=$PATH_TIER" >> "$GITHUB_OUTPUT"
          fi
      - name: Validate same-PR release materialization
        if: {% raw %}${{ github.event_name == 'pull_request_target' && steps.sync.outputs.route == 'ordinary' && !startsWith(github.event.pull_request.head.ref, 'promote/m') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          CHECKPOINT_ROLE: {% raw %}${{ steps.level.outputs.checkpoint }}{% endraw %}
          PR_TITLE: {% raw %}${{ github.event.pull_request.title }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.level.outputs.level }}{% endraw %}
        run: |
          # This workflow always comes from the default branch, while the
          # trusted scripts come from the PR base; pass a checkpoint role only
          # when that base reports one so older bases keep their interface.
          release_policy="$RUNNER_TEMP/trusted-verification/release_policy.py"
          checkpoint_args=()
          if [[ -n "$CHECKPOINT_ROLE" ]]; then
            checkpoint_args=(--checkpoint-role "$CHECKPOINT_ROLE")
          fi
          # The squash merge keeps only the PR title, so check its release
          # intent against the branch commits; older trusted bases without
          # --pr-title keep their earlier interface (#1137).
          title_args=()
          if grep -q -- '"--pr-title"' "$release_policy"; then
            title_args=(--pr-title "$PR_TITLE")
          fi
          python3 "$release_policy" \
            verify-delivery-version \
            --root "$GITHUB_WORKSPACE" \
            --base-sha "$BASE_SHA" \
            --head-sha "$HEAD_SHA" \
            --phase "$RELEASE_LEVEL" \
            "${checkpoint_args[@]}" \
            "${title_args[@]}"
      - name: Validate Milestone promotion version materialization
        if: {% raw %}${{ github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'promote/m') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.level.outputs.level }}{% endraw %}
        run: |
          source_sha="$(git rev-parse "$HEAD_SHA^1")"
          python3 "$RUNNER_TEMP/trusted-verification/release_policy.py" \
            verify-promotion-version \
            --root "$GITHUB_WORKSPACE" \
            --source-sha "$source_sha" \
            --head-sha "$HEAD_SHA" \
            --phase "$RELEASE_LEVEL"
      - name: Resolve effective verification suite
        id: effective
        env:
          PR_DRAFT: {% raw %}${{ github.event.pull_request.draft || false }}{% endraw %}
          RESOLVED_SUITE: {% raw %}${{ steps.level.outputs.suite }}{% endraw %}
          SYNC_ROUTE: {% raw %}${{ steps.sync.outputs.route }}{% endraw %}
        run: |
          suite="$RESOLVED_SUITE"
          if [[ "$suite" == "full" && ( "$PR_DRAFT" == "true" || "$SYNC_ROUTE" != "ordinary" ) ]]; then
            suite=fast
          fi
          echo "suite=$suite" >> "$GITHUB_OUTPUT"
      - name: Bind trusted verification identity
        id: identity
        env:
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || 'none' }}{% endraw %}
          PR_BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.sha }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.level.outputs.level || 'none' }}{% endraw %}
          TIER: {% raw %}${{ steps.effective.outputs.suite }}{% endraw %}
        run: |
          tree="$(git rev-parse "$HEAD_SHA^{tree}")"
          # Only labels that change the verification tier belong in evidence identity.
          labels="$(jq -c '[.pull_request.labels[].name | select(. == "promotion" or . == "hotfix" or . == "release-recovery")] | sort' "$GITHUB_EVENT_PATH" 2>/dev/null || printf '[]')"
          labels_sha="$(printf '%s' "$labels" | sha256sum | cut -d' ' -f1)"
          if [[ "$TIER" == "full" ]]; then
            command="./.csarc/scripts/verify"
          else
            command="./.csarc/scripts/verify-fast"
          fi
          {
            echo "tree=$tree"
            echo "command=$command"
            echo "base=$PR_BASE"
            echo "base_sha=$PR_BASE_SHA"
            echo "labels=$labels_sha"
            echo "release=$RELEASE_LEVEL"
          } >> "$GITHUB_OUTPUT"
      - name: Find reusable trusted verification
        id: reuse
        env:
          BASE: {% raw %}${{ steps.identity.outputs.base }}{% endraw %}
          BASE_SHA: {% raw %}${{ steps.identity.outputs.base_sha }}{% endraw %}
          COMMAND: {% raw %}${{ steps.identity.outputs.command }}{% endraw %}
          EVENT_ACTION: {% raw %}${{ github.event.action || '' }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || '' }}{% endraw %}
          LABELS_SHA: {% raw %}${{ steps.identity.outputs.labels }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.identity.outputs.release }}{% endraw %}
          SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
          SYNC_ROUTE: {% raw %}${{ steps.sync.outputs.route }}{% endraw %}
          TIER: {% raw %}${{ steps.effective.outputs.suite }}{% endraw %}
        run: |
          echo "reuse=false" >> "$GITHUB_OUTPUT"
          case "$EVENT_ACTION" in
            edited|labeled|unlabeled|ready_for_review|converted_to_draft) ;;
            *) exit 0 ;;
          esac
          if [[ "$SYNC_ROUTE" != "ordinary" ]]; then
            exit 0
          fi
          if ! python3 "$RUNNER_TEMP/trusted-verification/check-trusted-verification" \
            "$HEAD_SHA" \
            --github-repo "$GITHUB_REPOSITORY" \
            --find-reusable \
            --tier "$TIER" \
            --scopes "$SCOPES" \
            --command "$COMMAND" \
            --base "$BASE" \
            --base-sha "$BASE_SHA" \
            --labels "$LABELS_SHA" \
            --release-level "$RELEASE_LEVEL" \
            --exclude-run-id "$GITHUB_RUN_ID" \
            --github-output "$GITHUB_OUTPUT"; then
            echo "::notice::Reusable verification is unavailable; running the exact candidate instead."
          fi
      - name: Validate trusted clean sync
        if: {% raw %}${{ steps.sync.outputs.clean == 'true' }}{% endraw %}
        env:
          BASE: {% raw %}${{ steps.identity.outputs.base }}{% endraw %}
          BASE_SHA: {% raw %}${{ steps.identity.outputs.base_sha }}{% endraw %}
          LABELS_SHA: {% raw %}${{ steps.identity.outputs.labels }}{% endraw %}
          MAIN_SHA: {% raw %}${{ steps.sync.outputs.main_sha }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.identity.outputs.release }}{% endraw %}
          SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
          SOURCE_CHECK: {% raw %}${{ steps.sync.outputs.source_check }}{% endraw %}
          SOURCE_JOB: {% raw %}${{ steps.sync.outputs.source_job }}{% endraw %}
          SOURCE_RUN: {% raw %}${{ steps.sync.outputs.source_run }}{% endraw %}
          TREE: {% raw %}${{ steps.identity.outputs.tree }}{% endraw %}
        run: |
          evidence="$(jq -cn \
            --arg scopes "$SCOPES" \
            --arg tree "$TREE" \
            --arg base "$BASE" \
            --arg base_sha "$BASE_SHA" \
            --arg labels "$LABELS_SHA" \
            --arg release "$RELEASE_LEVEL" \
            --arg main "$MAIN_SHA" \
            --argjson source_run "$SOURCE_RUN" \
            --argjson source_job "$SOURCE_JOB" \
            --argjson source_check "$SOURCE_CHECK" \
            '{schema_version: 1, kind: "sync", tier: "fast", scopes: $scopes, tree: $tree, command: "./.csarc/scripts/verify-fast", base: $base, base_sha: $base_sha, labels: $labels, release: $release, main: $main, source_run: $source_run, source_job: $source_job, source_check: $source_check}')"
          evidence="${evidence//'%'/'%25'}"
          printf '::notice title=Trusted verification route evidence::%s\n' "$evidence"
      - name: Reuse trusted verification
        if: {% raw %}${{ steps.reuse.outputs.reuse == 'true' }}{% endraw %}
        env:
          BASE: {% raw %}${{ steps.identity.outputs.base }}{% endraw %}
          BASE_SHA: {% raw %}${{ steps.identity.outputs.base_sha }}{% endraw %}
          COMMAND: {% raw %}${{ steps.identity.outputs.command }}{% endraw %}
          LABELS_SHA: {% raw %}${{ steps.identity.outputs.labels }}{% endraw %}
          RELEASE_LEVEL: {% raw %}${{ steps.identity.outputs.release }}{% endraw %}
          SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
          SOURCE_CHECK: {% raw %}${{ steps.reuse.outputs.source_check }}{% endraw %}
          SOURCE_JOB: {% raw %}${{ steps.reuse.outputs.source_job }}{% endraw %}
          SOURCE_RUN: {% raw %}${{ steps.reuse.outputs.source_run }}{% endraw %}
          TIER: {% raw %}${{ steps.effective.outputs.suite }}{% endraw %}
          TREE: {% raw %}${{ steps.identity.outputs.tree }}{% endraw %}
        run: |
          evidence="$(jq -cn \
            --arg tier "$TIER" \
            --arg scopes "$SCOPES" \
            --arg tree "$TREE" \
            --arg command "$COMMAND" \
            --arg base "$BASE" \
            --arg base_sha "$BASE_SHA" \
            --arg labels "$LABELS_SHA" \
            --arg release "$RELEASE_LEVEL" \
            --argjson source_run "$SOURCE_RUN" \
            --argjson source_job "$SOURCE_JOB" \
            --argjson source_check "$SOURCE_CHECK" \
            '{schema_version: 1, kind: "reuse", tier: $tier, scopes: $scopes, tree: $tree, command: $command, base: $base, base_sha: $base_sha, labels: $labels, release: $release, source_run: $source_run, source_job: $source_job, source_check: $source_check}')"
          evidence="${evidence//'%'/'%25'}"
          printf '::notice title=Trusted verification route evidence::%s\n' "$evidence"
      - name: Validate the guided release candidate
        # Issue #1106: only this step holds the read-only token. It runs
        # before any candidate code in this job and executes the trusted-base
        # copy staged before checkout; the candidate tree is only data.
        if: {% raw %}${{ github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          CSARC_PUBLISH_CANDIDATE_STATUS: "false"
          CSARC_RELEASE_CANDIDATE_BUNDLE: "false"
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          PR_HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
        run: |
          trusted="$RUNNER_TEMP/trusted-release"
          if [[ ! -f "$trusted/trusted-executor.json" ]]; then
            echo "::error title=Guided release candidate::The trusted base did not stage verify-release-candidate; the candidate copy is never used."
            exit 1
          fi
          python3 "$RUNNER_TEMP/trusted-verification/trusted_executor.py" \
            verify --destination "$trusted"
          jq -n \
            --argjson number "$PR_NUMBER" \
            --arg sha "$PR_HEAD_SHA" \
            --arg head "$PR_HEAD" \
            --arg base "$PR_BASE" \
            '{number: $number, sha: $sha, headBranchName: $head, baseBranchName: $base}' \
            >"$RUNNER_TEMP/release-pr.json"
          CSARC_RELEASE_SUBJECT_ROOT="$GITHUB_WORKSPACE" \
            "$trusted/.csarc/scripts/verify-release-candidate" "$RUNNER_TEMP/release-pr.json"
{% if has_python %}
      - name: Set up Python {{ python_target }}
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && ((steps.reuse.outputs.reuse != 'true' && (steps.effective.outputs.suite == 'full' || steps.plan.outputs.run_project == 'true' || steps.plan.outputs.run_osv == 'true')) || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned')) }}{% endraw %}
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_target }}"
{% endif %}
      - name: Set up uv 0.12.15
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && (steps.reuse.outputs.reuse != 'true'{% endraw %}{% if has_python %}{% raw %} || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned'){% endraw %}{% endif %}{% raw %}) }}{% endraw %}
        uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.12.15"
{% if has_typescript %}
      - name: Set up pnpm 11.22.0
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && ((steps.reuse.outputs.reuse != 'true' && (steps.effective.outputs.suite == 'full' || steps.plan.outputs.run_project == 'true' || steps.plan.outputs.run_osv == 'true')) || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned')) }}{% endraw %}
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "11.22.0"
          run_install: false
      - name: Set up Node.js 24
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && ((steps.reuse.outputs.reuse != 'true' && (steps.effective.outputs.suite == 'full' || steps.plan.outputs.run_project == 'true' || steps.plan.outputs.run_osv == 'true')) || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned')) }}{% endraw %}
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "24"
{% endif %}
{% if has_rust %}
      - name: Set up Rust 1.98.0
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && ((steps.reuse.outputs.reuse != 'true' && (steps.effective.outputs.suite == 'full' || steps.plan.outputs.run_project == 'true')) || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned')) }}{% endraw %}
        run: |
          rustup toolchain install 1.98.0 --profile minimal --component clippy,rustfmt
          rustup default 1.98.0
{% endif %}{% if has_go %}
      - name: Set up Go 1.27.1
        if: {% raw %}${{ steps.sync.outputs.clean != 'true' && ((steps.reuse.outputs.reuse != 'true' && (steps.effective.outputs.suite == 'full' || steps.plan.outputs.run_project == 'true')) || (github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned')) }}{% endraw %}
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: "1.27.1"
          cache: false
{% endif %}
      - name: Execute trusted verification tier={% raw %}${{ steps.effective.outputs.suite }}{% endraw %} scopes={% raw %}${{ steps.plan.outputs.scopes }}{% endraw %} tree={% raw %}${{ steps.identity.outputs.tree }}{% endraw %} command={% raw %}${{ steps.identity.outputs.command }}{% endraw %} base={% raw %}${{ steps.identity.outputs.base }}{% endraw %} base-sha={% raw %}${{ steps.identity.outputs.base_sha }}{% endraw %} labels={% raw %}${{ steps.identity.outputs.labels }}{% endraw %} release={% raw %}${{ steps.identity.outputs.release }}${{ steps.trusted.outputs.executor == 'trusted-base' && ' executor=trusted-base' || '' }}{% endraw %}
        if: {% raw %}${{ steps.reuse.outputs.reuse != 'true' && steps.sync.outputs.clean != 'true' }}{% endraw %}
        env:
          CSARC_CI_SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
{%- if has_go %}
          GOTOOLCHAIN: local
{%- endif %}
          CSARC_CI_TIER: {% raw %}${{ steps.effective.outputs.suite }}{% endraw %}
          CSARC_CI_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          CSARC_CI_DRAFT: {% raw %}${{ github.event.pull_request.draft || false }}{% endraw %}
          CSARC_VERIFICATION_SUITE: {% raw %}${{ steps.effective.outputs.suite }}{% endraw %}
          EXECUTOR: {% raw %}${{ steps.trusted.outputs.executor }}{% endraw %}
        run: |
          # The authoritative entry point is the trusted-base copy staged
          # before checkout; it runs the checks inside the exact candidate
          # tree. Only a base that predates Issue #1086 falls back to the
          # candidate entry point, and its evidence omits executor=trusted-base.
          entry_root="$GITHUB_WORKSPACE"
          if [[ "$EXECUTOR" == "trusted-base" ]]; then
            entry_root="$RUNNER_TEMP/trusted-executor"
            python3 "$RUNNER_TEMP/trusted-verification/trusted_executor.py" \
              verify --destination "$entry_root"
            export CSARC_VERIFICATION_SUBJECT_ROOT="$GITHUB_WORKSPACE"
          fi
          if [[ "$CSARC_CI_TIER" == "full" ]]; then
            "$entry_root/.csarc/scripts/verify"
          else
            "$entry_root/.csarc/scripts/verify-fast"
          fi
      - name: Package the guided release candidate
        # Packaging runs candidate build code, so this step gets no token
        # and runs only after the trusted checks; the bundler itself is
        # still the trusted-base copy (Issue #1106).
        if: {% raw %}${{ github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          PR_HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
        run: |
          trusted="$RUNNER_TEMP/trusted-release"
          python3 "$RUNNER_TEMP/trusted-verification/trusted_executor.py" \
            verify --destination "$trusted"
          worktree="$RUNNER_TEMP/release-candidate-package"
          git worktree add --detach --force "$worktree" "$PR_HEAD_SHA"
          python3 "$trusted/.csarc/scripts/release_bundle.py" candidate \
            --root "$worktree" \
            --output "$RUNNER_TEMP/release-candidate-assets"
      - name: Candidate gate self-test (non-authoritative)
        # Runs after the required result is decided. The trusted helper
        # replays the trusted router arguments through the candidate's own
        # router and config reader, without tokens or file-command variables,
        # and only reports differences; continue-on-error keeps it from
        # deciding the job.
        if: {% raw %}${{ !cancelled() && steps.trusted.outputs.executor == 'trusted-base' && steps.plan.outcome == 'success' }}{% endraw %}
        continue-on-error: true
        timeout-minutes: 5
        env:
          TRUSTED_OWNERSHIP: {% raw %}${{ steps.release.outputs.ownership }}{% endraw %}
        run: |
          python3 "$RUNNER_TEMP/trusted-verification/trusted_executor.py" self-test \
            --candidate-root "$GITHUB_WORKSPACE" \
            --router-args "$RUNNER_TEMP/trusted-router-args" \
            --trusted-plan "$RUNNER_TEMP/trusted-ci-plan.json" \
            --trusted-ownership "$TRUSTED_OWNERSHIP" \
            --changed-files "$RUNNER_TEMP/changed-files" \
            --summary "$GITHUB_STEP_SUMMARY"
      - name: Record result
        if: {% raw %}${{ always() }}{% endraw %}
        env:
          RESULT: {% raw %}${{ job.status }}{% endraw %}
        run: echo "- Verification — $RESULT" >> "$GITHUB_STEP_SUMMARY"

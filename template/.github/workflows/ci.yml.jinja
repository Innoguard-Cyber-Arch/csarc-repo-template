{% set python_target = "3.14" if python_support_mode == "latest" else python_min_version -%}
{% set has_python = "python" in languages -%}
{% set has_typescript = "typescript" in languages -%}
{% set has_rust = "rust" in languages -%}
name: CI

on:
  pull_request:
    types: [opened, reopened, synchronize, labeled, unlabeled]
  merge_group:
    types: [checks_requested]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  verify:
    name: verify
    runs-on: ubuntu-latest
    # Issue #661: this job no longer re-executes any test -- it only checks
    # that the commit already carries proof it was verified locally (see
    # scripts/verify_attestation.py and scripts/check-verify-attestation).
    # 30 minutes was sized for running the full test suite on the runner;
    # 15 stays generous for the one thing here that still does real work,
    # the guided-release-candidate packaging step below, while catching a
    # hang in the now-lightweight common path far sooner than before.
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Read release ownership
        id: release
        run: echo "ownership=$(python3 scripts/csarc_config.py release_ownership)" >> "$GITHUB_OUTPUT"
      - name: Select verification tier
        id: plan
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || '' }}{% endraw %}
          EVENT_NAME: {% raw %}${{ github.event_name }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          LABELS: {% raw %}${{ join(github.event.pull_request.labels.*.name, ',') }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref || github.event.merge_group.head_ref || '' }}{% endraw %}
        run: |
          files="$RUNNER_TEMP/changed-files"
          if [[ -n "$BASE_SHA" && -n "$HEAD_SHA" ]]; then
            git diff --name-only -z "$BASE_SHA" "$HEAD_SHA" > "$files"
          else
            git ls-files -z > "$files"
          fi
          args=()
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            args+=(--force-full)
          fi
          python3 scripts/ci_tier.py \
            --event "$EVENT_NAME" \
            --base "${PR_BASE#refs/heads/}" \
            --head "${PR_HEAD#refs/heads/}" \
            --labels "$LABELS" \
            --files-from "$files" \
            --output-json ci-plan.json \
            --github-output "$GITHUB_OUTPUT" \
            --summary "$GITHUB_STEP_SUMMARY" \
            "${args[@]}"
      # Issue #661: the sole content of the `verify` required check now.
      # scripts/ci_tier.py's classification above still runs -- it is
      # change-aware routing logic, not test execution, and its "tier"
      # output is exactly what makes this a fail-closed check rather than
      # a rubber stamp: it independently reruns the same classification the
      # PR author's own local run used, so a fast-tier attestation cannot
      # satisfy a change scripts/ci_tier.py itself classifies as needing
      # full verification (e.g. a .github/workflows/ edit). HEAD_SHA
      # reuses the exact expression above rather than plain `github.sha`,
      # because for a pull_request event `github.sha` is GitHub's
      # synthetic merge commit, not the commit the contributor actually
      # verified and pushed -- only that real commit can carry the
      # trailer scripts/write-verify-attestation amended onto it.
      - name: Validate local verification attestation
        env:
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          REQUIRED_TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
        run: ./scripts/check-verify-attestation "$HEAD_SHA" --required-tier "$REQUIRED_TIER"
      # Everything below this point is unrelated to Issue #661 and stays
      # exactly as it worked before: scripts/verify-release-candidate still
      # needs this generated project's real language toolchain(s) to build
      # the candidate's packages via scripts/release_bundle.py, so these
      # toolchain-setup steps stay -- only their gating condition changes,
      # from "which tier was selected" (now meaningless here, nothing
      # downstream consumes a toolchain) to "is this actually a guided
      # release-candidate PR", matching the one remaining step that uses
      # them.
{% if has_python %}
      - if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_target }}"
{% endif %}
      - if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
{% if has_typescript %}
      - if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          cache: pnpm
{% endif %}
{% if has_rust %}
      - if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        run: |
          rustup toolchain install 1.98.0 --profile minimal --component clippy,rustfmt
          rustup default 1.98.0
{% endif %}
      - name: Validate the guided release candidate
        if: {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          CSARC_PUBLISH_CANDIDATE_STATUS: "false"
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          PR_HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
        run: |
          jq -n \
            --argjson number "$PR_NUMBER" \
            --arg sha "$PR_HEAD_SHA" \
            --arg head "$PR_HEAD" \
            --arg base "$PR_BASE" \
            '{number: $number, sha: $sha, headBranchName: $head, baseBranchName: $base}' \
            >"$RUNNER_TEMP/release-pr.json"
          ./scripts/verify-release-candidate "$RUNNER_TEMP/release-pr.json"
      - name: Record result
        if: {% raw %}${{ always() }}{% endraw %}
        env:
          RESULT: {% raw %}${{ job.status }}{% endraw %}
        run: echo "- Verification — $RESULT" >> "$GITHUB_STEP_SUMMARY"

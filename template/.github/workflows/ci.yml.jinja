{% set python_mode = python_support_mode | default("latest") -%}
{% set python_min = python_min_version | default("3.12") -%}
{% set python_latest = "3.14" -%}
{% set python_target = python_latest if python_mode == "latest" else python_min -%}
{% set python_target_minor = python_target.split(".")[1] | int -%}
{% set python_latest_minor = python_latest.split(".")[1] | int -%}
{% set has_python = language in ["python", "python-typescript"] -%}
{% set has_typescript = language in ["typescript", "python-typescript"] -%}
name: CI

on:
  pull_request:
  push:
    branches: [main{% if branch_strategy == "dev" %}, dev{% endif %}]

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  governance:
    name: governance
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Require protected default branch
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: ./scripts/apply-repository-settings.sh check

{%- if use_reusable_workflow %}
  verify:
    uses: Innoguard-Cyber-Arch/csarc-repo-template/.github/workflows/reusable-ci.yml@{{ workflow_ref }}
    with:
      language-profile: "{{ language }}"
{%- if has_python %}
      python-versions: '["{{ python_target }}.0"{% for minor in range(python_target_minor, python_latest_minor + 1) %}, "3.{{ minor }}"{% endfor %}]'
{%- else %}
      python-versions: '[""]'
{%- endif %}
{%- if has_typescript %}
      node-version: "24"
{%- endif %}
{%- elif has_python %}
  runtime:
    name: {% raw %}Python ${{ matrix.python-version }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        python-version:
          - "{{ python_target }}.0"
{%- for minor in range(python_target_minor, python_latest_minor + 1) %}
          - "3.{{ minor }}"
{%- endfor %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
{%- if has_typescript %}
      - if: {% raw %}strategy.job-index == 0{% endraw %}
        uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - if: {% raw %}strategy.job-index == 0{% endraw %}
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          cache: pnpm
{%- endif %}
      - name: Verify declared language modules
        run: ./scripts/verify
        env:
          CSARC_PYTHON_VERSION: {% raw %}${{ matrix.python-version }}{% endraw %}
          CSARC_VERIFY_TYPESCRIPT: {% if has_typescript %}{% raw %}${{ strategy.job-index == 0 }}{% endraw %}{% else %}"false"{% endif %}

  verify:
    name: verify
    if: {% raw %}always(){% endraw %}
    needs: runtime
    runs-on: ubuntu-latest
    steps:
      - name: Require every runtime verification
        env:
          RUNTIME_RESULT: {% raw %}${{ needs.runtime.result }}{% endraw %}
        run: test "$RUNTIME_RESULT" = success
{%- else %}
  verify:
    name: verify
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
{%- if has_typescript %}
      - uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          cache: pnpm
{%- endif %}
      - name: Verify declared language modules
        run: ./scripts/verify
{%- endif %}

{% set python_target = "3.14" if python_support_mode == "latest" else python_min_version -%}
{% set has_python = "python" in languages -%}
{% set has_typescript = "typescript" in languages -%}
{% set has_rust = "rust" in languages -%}
name: CI

on:
  pull_request_target:
    types: [opened, reopened, synchronize, edited, labeled, unlabeled]
  merge_group:
    types: [checks_requested]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read
  issues: read
  pull-requests: read

jobs:
  verify:
    name: verify
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Check out the trusted verification policy
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.sha }}{% endraw %}
      - name: Preserve the trusted verification router
        run: cp scripts/ci_tier.py "$RUNNER_TEMP/ci_tier.py"
      - name: Check out the exact candidate
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
      - name: Read release ownership
        id: release
        run: echo "ownership=$(python3 scripts/csarc_config.py release_ownership)" >> "$GITHUB_OUTPUT"
      - name: Select trusted verification plan
        id: plan
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || '' }}{% endraw %}
          EVENT_NAME: {% raw %}${{ github.event_name == 'pull_request_target' && 'pull_request' || github.event_name }}{% endraw %}
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          LABELS: {% raw %}${{ join(github.event.pull_request.labels.*.name, ',') }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref || github.event.merge_group.head_ref || '' }}{% endraw %}
        run: |
          files="$RUNNER_TEMP/changed-files"
          if [[ -n "$BASE_SHA" && -n "$HEAD_SHA" ]]; then
            merge_base="$(git merge-base "$BASE_SHA" "$HEAD_SHA")"
            git diff --no-renames --name-only -z "$merge_base" "$HEAD_SHA" > "$files"
          else
            git ls-files -z > "$files"
          fi
          args=()
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            args+=(--force-full)
          fi
          python3 "$RUNNER_TEMP/ci_tier.py" \
            --event "$EVENT_NAME" \
            --base "${PR_BASE#refs/heads/}" \
            --head "${PR_HEAD#refs/heads/}" \
            --labels "$LABELS" \
            --files-from "$files" \
            --output-json ci-plan.json \
            --github-output "$GITHUB_OUTPUT" \
            --summary "$GITHUB_STEP_SUMMARY" \
            "${args[@]}"
      - name: Resolve release-level verification suite
        id: level
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PATH_TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number || '' }}{% endraw %}
        run: |
          if [[ -n "$PR_NUMBER" ]]; then
            python3 scripts/release_level.py resolve-pr \
              --repo "$GITHUB_REPOSITORY" \
              --pr "$PR_NUMBER" \
              --path-tier "$PATH_TIER" \
              --github-output "$GITHUB_OUTPUT"
          else
            echo "suite=$PATH_TIER" >> "$GITHUB_OUTPUT"
          fi
      - name: Bind trusted verification identity
        id: identity
        env:
          HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}{% endraw %}
          TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
        run: |
          tree="$(git rev-parse "$HEAD_SHA^{tree}")"
          if [[ "$TIER" == "full" ]]; then
            command="./scripts/verify"
          else
            command="./scripts/verify-fast"
          fi
          echo "tree=$tree" >> "$GITHUB_OUTPUT"
          echo "command=$command" >> "$GITHUB_OUTPUT"
{% if has_python %}
      - name: Set up Python {{ python_target }}
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_target }}"
{% endif %}
      - name: Set up uv 0.12.15
        uses: astral-sh/setup-uv@bec219d24cd3e171d82865faccec33120bb574f4 # v10.1.0
        with:
          version: "0.12.15"
{% if has_typescript %}
      - name: Set up pnpm 11.22.0
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: "11.22.0"
          run_install: false
      - name: Set up Node.js 24
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
{% endif %}
{% if has_rust %}
      - name: Set up Rust 1.98.0
        run: |
          rustup toolchain install 1.98.0 --profile minimal --component clippy,rustfmt
          rustup default 1.98.0
{% endif %}
      - name: Execute trusted verification tier={% raw %}${{ steps.plan.outputs.tier }}{% endraw %} scopes={% raw %}${{ steps.plan.outputs.scopes }}{% endraw %} tree={% raw %}${{ steps.identity.outputs.tree }}{% endraw %} command={% raw %}${{ steps.identity.outputs.command }}{% endraw %}
        env:
          CSARC_CI_SCOPES: {% raw %}${{ steps.plan.outputs.scopes }}{% endraw %}
          CSARC_CI_TIER: {% raw %}${{ steps.plan.outputs.tier }}{% endraw %}
          CSARC_CI_BASE: {% raw %}${{ github.event.pull_request.base.ref || github.event.merge_group.base_ref || '' }}{% endraw %}
          CSARC_VERIFICATION_SUITE: {% raw %}${{ steps.level.outputs.suite }}{% endraw %}
        run: |
          if [[ "$CSARC_CI_TIER" == "full" ]]; then
            ./scripts/verify
          else
            ./scripts/verify-fast
          fi
      - name: Validate the guided release candidate
        if: {% raw %}${{ github.event_name == 'pull_request_target' && github.event.pull_request.base.ref == 'main' && startsWith(github.event.pull_request.head.ref, 'release/v') && steps.release.outputs.ownership == 'csarc-owned' }}{% endraw %}
        env:
          CSARC_PUBLISH_CANDIDATE_STATUS: "false"
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR_BASE: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          PR_HEAD: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          PR_HEAD_SHA: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
        run: |
          jq -n \
            --argjson number "$PR_NUMBER" \
            --arg sha "$PR_HEAD_SHA" \
            --arg head "$PR_HEAD" \
            --arg base "$PR_BASE" \
            '{number: $number, sha: $sha, headBranchName: $head, baseBranchName: $base}' \
            >"$RUNNER_TEMP/release-pr.json"
          ./scripts/verify-release-candidate "$RUNNER_TEMP/release-pr.json"
      - name: Record result
        if: {% raw %}${{ always() }}{% endraw %}
        env:
          RESULT: {% raw %}${{ job.status }}{% endraw %}
        run: echo "- Verification — $RESULT" >> "$GITHUB_STEP_SUMMARY"

{% set has_python = "python" in languages -%}
{% set has_typescript = "typescript" in languages -%}
name: CodeQL

on:
  pull_request:
    types: [opened, reopened, synchronize]
  workflow_dispatch:

permissions: {}

jobs:
  analyze:
    name: analyze ({% raw %}${{ matrix.language }}{% endraw %})
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        language: [{% if has_python %}"python"{% endif %}{% if has_python and has_typescript %}, {% endif %}{% if has_typescript %}"javascript-typescript"{% endif %}]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: github/codeql-action/init@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4.37.9
        with:
          languages: {% raw %}${{ matrix.language }}{% endraw %}
          build-mode: none
      - uses: github/codeql-action/analyze@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4.37.9

{% set python_mode = python_support_mode | default("latest") -%}
{% set python_min = python_min_version | default("3.12") -%}
{% set python_target = "3.14" if python_mode == "latest" else python_min -%}
{% set has_python = language in ["python", "python-typescript"] -%}
{% set has_typescript = language in ["typescript", "python-typescript"] -%}
{% set enable_attestations = enable_release_attestations | default(false) -%}
{% set publish_python = enable_pypi_publishing | default(false) -%}
{% set publish_npm = enable_npm_publishing | default(false) -%}
name: Release artifact

on:
  workflow_dispatch:
    inputs:
      source_run_id:
        description: Release Please workflow run containing source evidence
        required: true
        type: string

permissions:
  actions: read
  contents: read
  issues: read
  pull-requests: read

jobs:
  source:
    name: verify release source
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Download and verify the promotion boundary
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          SOURCE_RUN_ID: {% raw %}${{ inputs.source_run_id }}{% endraw %}
        run: |
          set -euo pipefail
          [[ "$GITHUB_EVENT_NAME" == "workflow_dispatch" && -n "$SOURCE_RUN_ID" ]] || {
            echo "Release artifacts require a Release Please source run." >&2
            exit 1
          }
          source_run="$(gh run view "$SOURCE_RUN_ID" --json headSha,workflowName,status)"
          test "$(jq -r .workflowName <<<"$source_run")" = "Release please"
          test "$(jq -r .headSha <<<"$source_run")" = "$GITHUB_SHA"
          mkdir release-source
          gh run download "$SOURCE_RUN_ID" \
            --name "main-release-source-${SOURCE_RUN_ID}" \
            --dir release-source
          python3 scripts/release_policy.py verify-boundary \
            --evidence release-source/main-release-source.json \
            --sha "$GITHUB_SHA"
          mv release-source/main-release-source.json release-source/release-source.json
      - name: Preserve release-source evidence
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-source
          path: release-source/release-source.json
          if-no-files-found: error
          retention-days: 90

  governance:
    name: governance
    needs: source
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Require protected default branch
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: ./scripts/apply-repository-settings.sh check

  build:
    name: {% if language == "ci" %}verify-release{% else %}build-and-sbom{% endif %}
    needs: governance
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
{% if has_python %}
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "{{ python_target }}"
{% endif %}
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          enable-cache: false
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-source
          path: release-source
      - name: Verify the immutable tag version
        env:
          RELEASE_TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: >-
          uv run --no-project python scripts/release_policy.py prepare
          --tag "$RELEASE_TAG"
{% if has_typescript %}
      - uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
        with:
          version: "11.22.0"
          run_install: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          package-manager-cache: false
{% endif %}
{% if has_python %}
      - name: Build Python distributions
        run: uv build
{% endif %}
{% if has_typescript %}
      - name: Build TypeScript package
        run: |
          pnpm install --frozen-lockfile
          pnpm run build
          find dist -maxdepth 1 -type f -name '.gitignore' -delete
          find dist -maxdepth 1 -type f -name '*.tgz' -delete
          pnpm pack --pack-destination dist
{% endif %}
{%- if language != "ci" %}
      - name: Calculate artifact checksums
        run: |
          find dist -maxdepth 1 -type f -print -quit | grep -q . || {
            echo "No release distribution was created." >&2
            exit 1
          }
          find dist -maxdepth 1 -type f -exec shasum -a 256 {} + | sort -k 2 > SHA256SUMS
      - name: Extract release artifacts for SBOM analysis
        run: |
          sbom_root="${RUNNER_TEMP}/sbom-root"
          mkdir -p "$sbom_root"
          index=0
          for archive in dist/*.whl dist/*.tar.gz dist/*.tgz; do
            [[ -f "$archive" ]] || continue
            index=$((index + 1))
            destination="$sbom_root/artifact-${index}"
            mkdir -p "$destination"
            case "$archive" in
              *.whl) unzip -q "$archive" -d "$destination" ;;
              *) tar -xzf "$archive" -C "$destination" ;;
            esac
          done
          [[ "$index" -gt 0 ]] || {
            echo "No release archive was available for SBOM analysis." >&2
            exit 1
          }
      - name: Generate CycloneDX SBOM
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0.24.0
        with:
          path: {% raw %}${{ runner.temp }}{% endraw %}/sbom-root
          format: cyclonedx-json
          output-file: sbom.cdx.json
          upload-artifact: false
      - name: Validate non-empty SBOM
        run: |
          uv run --no-project python - <<'PY'
          import json
          from pathlib import Path

          sbom = json.loads(Path("sbom.cdx.json").read_text(encoding="utf-8"))
          components = sbom.get("components", [])
          if not components:
              raise SystemExit("SBOM contains no components")
          print(f"SBOM components: {len(components)}")
          PY
      - name: Record release source
        env:
          RELEASE_TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          RELEASE_COMMIT: {% raw %}${{ github.sha }}{% endraw %}
          RELEASE_RUN_URL: {% raw %}${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}
        run: |
          uv run --no-project python - <<'PY'
          import json
          import os
          from pathlib import Path

          evidence = {
              "tag": os.environ["RELEASE_TAG"],
              "commit": os.environ["RELEASE_COMMIT"],
              "workflow_run": os.environ["RELEASE_RUN_URL"],
              "release_source": json.loads(
                  Path("release-source/release-source.json").read_text(
                      encoding="utf-8"
                  )
              ),
          }
          Path("release-metadata.json").write_text(
              json.dumps(evidence, indent=2) + "\n",
              encoding="utf-8",
          )
          PY
      - name: Upload release evidence
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-evidence
          path: |
            dist/
            SHA256SUMS
            sbom.cdx.json
            release-metadata.json
            release-source/release-source.json
          if-no-files-found: error
          retention-days: 30
{% endif %}
{% if language == "ci" %}
  publish-source:
    name: publish verified source release
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-source
          path: release-source
      - name: Attach evidence and publish the draft
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          test "$(gh release view "$GITHUB_REF_NAME" --json isDraft --jq .isDraft)" = true
          gh release upload "$GITHUB_REF_NAME" \
            release-source/release-source.json \
            --clobber
          gh release edit "$GITHUB_REF_NAME" --draft=false
{% endif %}
{% if language != "ci" %}
  publish-evidence:
    name: publish-evidence
    if: github.ref_type == 'tag'
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
{% if enable_attestations %}
      id-token: write
      attestations: write
{% endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-evidence
          path: release-evidence
      - name: Validate release evidence
        run: |
          test -s release-evidence/SHA256SUMS
          test -s release-evidence/sbom.cdx.json
          test -s release-evidence/release-metadata.json
          test -s release-evidence/release-source/release-source.json
          find release-evidence/dist -maxdepth 1 -type f -print -quit | grep -q .
          (
            cd release-evidence
            shasum -a 256 -c SHA256SUMS
          )
{% if enable_attestations %}
      - name: Attest build provenance
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-checksums: release-evidence/SHA256SUMS
      - name: Attest software bill of materials
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-checksums: release-evidence/SHA256SUMS
          sbom-path: release-evidence/sbom.cdx.json
{% endif %}
      - name: Attach evidence to GitHub Release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          if ! gh release view "$GITHUB_REF_NAME" >/dev/null 2>&1; then
            gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes
          fi
          gh release upload "$GITHUB_REF_NAME" \
            release-evidence/dist/* \
            release-evidence/SHA256SUMS \
            release-evidence/sbom.cdx.json \
            release-evidence/release-metadata.json \
            release-evidence/release-source/release-source.json \
            --clobber
          if [[ "$(gh release view "$GITHUB_REF_NAME" --json isDraft --jq .isDraft)" == true ]]; then
            gh release edit "$GITHUB_REF_NAME" --draft=false
          fi
{% endif %}
{% if has_python and publish_python %}
  publish-python:
    name: publish-python
    if: github.ref_type == 'tag'
    needs: publish-evidence
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: {{ pypi_environment | tojson }}
      url: https://pypi.org/p/{{ project_slug }}
    permissions:
      contents: read
      id-token: write
{% if enable_attestations %}
      attestations: read
{% endif %}
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-evidence
          path: release-evidence
      - name: Select Python distributions
        run: |
          mkdir pypi-dist
          find release-evidence/dist -maxdepth 1 -type f \
            \( -name '*.whl' -o -name '*.tar.gz' \) \
            -exec cp {} pypi-dist/ \;
          find pypi-dist -maxdepth 1 -type f -print -quit | grep -q .
{% if enable_attestations %}
      - name: Verify Python build provenance before publishing
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          mapfile -t packages < <(
            find pypi-dist -maxdepth 1 -type f \
              \( -name '*.whl' -o -name '*.tar.gz' \)
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -gt 0 ]]
          for package in "{% raw %}${packages[@]}{% endraw %}"; do
            gh attestation verify "$package" \
              --repo "$GITHUB_REPOSITORY" \
              --signer-workflow \
                "$GITHUB_REPOSITORY/.github/workflows/release.yml" \
              --source-digest "$GITHUB_SHA" \
              --source-ref "$GITHUB_REF"
          done
{% endif %}
      - name: Publish to PyPI with OIDC
        uses: pypa/gh-action-pypi-publish@a892a5a61159132606e93a2fa6f4358831b04d26 # v1.14.2
        with:
          packages-dir: pypi-dist/
{% endif %}
{% if has_typescript and publish_npm %}
  publish-npm:
    name: publish-npm
    if: github.ref_type == 'tag'
    needs: publish-evidence
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: {{ npm_environment | tojson }}
      url: https://www.npmjs.com/package/{{ project_slug }}
    permissions:
      contents: read
      id-token: write
{% if enable_attestations %}
      attestations: read
{% endif %}
    steps:
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "24"
          registry-url: https://registry.npmjs.org
          package-manager-cache: false
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: release-evidence
          path: release-evidence
{% if enable_attestations %}
      - name: Verify npm build provenance before publishing
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          mapfile -t packages < <(
            find release-evidence/dist -maxdepth 1 -type f -name '*.tgz'
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -eq 1 ]]
          gh attestation verify "{% raw %}${packages[0]}{% endraw %}" \
            --repo "$GITHUB_REPOSITORY" \
            --signer-workflow \
              "$GITHUB_REPOSITORY/.github/workflows/release.yml" \
            --source-digest "$GITHUB_SHA" \
            --source-ref "$GITHUB_REF"
{% endif %}
      - name: Publish to npm with OIDC
        run: |
          mapfile -t packages < <(
            find release-evidence/dist -maxdepth 1 -type f -name '*.tgz'
          )
          [[ "{% raw %}${#packages[@]}{% endraw %}" -eq 1 ]] || {
            echo "Expected exactly one npm package tarball." >&2
            exit 1
          }
          expected_repo_url="https://github.com/${GITHUB_REPOSITORY}.git"
          actual_repo_url="$(
            tar -xOf "${packages[0]}" package/package.json |
              node -e 'let input = ""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => console.log(JSON.parse(input).repository?.url ?? ""));'
          )"
          [[ "$actual_repo_url" == "$expected_repo_url" ]] || {
              echo "package.json repository.url must match ${expected_repo_url}." >&2
              exit 1
            }
          npm publish "${packages[0]}" --provenance --access public
{% endif %}
# This workflow creates release evidence; deployment remains project-specific.

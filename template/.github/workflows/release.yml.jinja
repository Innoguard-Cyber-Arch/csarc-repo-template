{% raw %}name: Release

on:
{% endraw %}{% if release_trigger == 'main' %}{% raw %}
  push:
    branches: [main, 'dev/m*']
{% endraw %}{% endif %}{% raw %}
  workflow_dispatch:

concurrency:
  group: release-${{ github.repository }}
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  release:
    name: validate and publish
    if: ${{ github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/heads/dev/m') }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      actions: read
      checks: read
      contents: write
      issues: write
      pull-requests: read
      statuses: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Resolve release route
        id: route
        run: |
          if [[ "$GITHUB_REF_NAME" == main ]]; then
            echo "channel=stable" >> "$GITHUB_OUTPUT"
            echo "required_tier=full" >> "$GITHUB_OUTPUT"
          elif [[ "$GITHUB_REF_NAME" == dev/m* ]]; then
            echo "channel=beta" >> "$GITHUB_OUTPUT"
            echo "required_tier=fast" >> "$GITHUB_OUTPUT"
          else
            echo "Unsupported release branch: $GITHUB_REF_NAME" >&2
            exit 1
          fi
      - name: Resolve included work and release level
        id: level
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 .csarc/scripts/release_level.py release-batch \
            --repo "$GITHUB_REPOSITORY" \
            --sha "$GITHUB_SHA" \
            --base-branch "$GITHUB_REF_NAME" \
            --markdown-output "$RUNNER_TEMP/release-levels.md" \
            --github-output "$GITHUB_OUTPUT"
          cat "$RUNNER_TEMP/release-levels.md" >> "$GITHUB_STEP_SUMMARY"
      - name: Plan the next version from repository history
        id: plan
        env:
          RELEASE_LEVEL: ${{ steps.route.outputs.channel }}
        run: |
          python3 .csarc/scripts/release_policy.py plan \
            --sha "$GITHUB_SHA" \
            --phase "$RELEASE_LEVEL" \
            --github-output "$GITHUB_OUTPUT"
      - name: Reject an unmaterialized merged delivery
        if: ${{ steps.plan.outputs.status == 'pending' }}
        run: |
          echo "Release-worthy work must materialize its planned version before merge." >&2
          exit 1
      - name: Detect the available release path
        id: capability
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 .csarc/scripts/release_policy.py detect \
            --repo "$GITHUB_REPOSITORY" \
            --sha "$GITHUB_SHA" \
            --branch "$GITHUB_REF_NAME" \
            --github-output "$GITHUB_OUTPUT"
      - name: Stop when GitHub publication is blocked
        if: ${{ (steps.plan.outputs.status == 'candidate' || steps.plan.outputs.status == 'released') && steps.capability.outputs.mode == 'blocked' }}
        env:
          BLOCK_REASON: ${{ steps.capability.outputs.reason }}
        run: |
          echo "Release is blocked: $BLOCK_REASON" | tee -a "$GITHUB_STEP_SUMMARY"
          exit 1
      - name: Reuse the source PR's trusted verification evidence
        id: verification
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        env:
          GH_TOKEN: ${{ github.token }}
          REQUIRED_TIER: ${{ steps.route.outputs.required_tier }}
        run: |
          if ./.csarc/scripts/check-trusted-verification "$GITHUB_SHA" \
            --resolve-merge-source --github-repo "$GITHUB_REPOSITORY" \
            --required-tier "$REQUIRED_TIER"; then
            echo "reused=true" >> "$GITHUB_OUTPUT"
          else
            echo "reused=false" >> "$GITHUB_OUTPUT"
          fi
      - name: Set up Python 3.14
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        with:
          python-version: "3.14"
      - name: Set up uv 0.12.15
        uses: astral-sh/setup-uv@bec219d24cd3e171d82865faccec33120bb574f4 # v10.1.0
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        with:
          enable-cache: false
          version: "0.12.15"
{% endraw %}{% if "typescript" in languages %}{% raw %}
      - name: Set up pnpm 11.22.0
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        with:
          version: "11.22.0"
          run_install: false
      - name: Set up Node.js 24
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        with:
          node-version: "24"
          package-manager-cache: false
{% endraw %}{% endif %}{% if "rust" in languages %}{% raw %}
      - name: Install the pinned Rust toolchain
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        run: |
          rustup toolchain install 1.98.0 --profile minimal --component clippy,rustfmt
          rustup default 1.98.0
{% endraw %}{% endif %}{% raw %}
      - name: Re-verify the exact release tree when reuse is unavailable
        if: ${{ steps.plan.outputs.status != 'no-release' && steps.verification.outputs.reused != 'true' }}
        env:
          CSARC_CI_BASE: ${{ github.event.before || github.event.repository.default_branch }}
          CSARC_CI_SCOPES: dependency,docs,governance,shell,source,template,workflow
          CSARC_CI_TIER: ${{ steps.route.outputs.required_tier }}
        run: |
          if [[ "$CSARC_CI_TIER" == full ]]; then
            ./.csarc/scripts/verify
          else
            ./.csarc/scripts/verify-fast
          fi
      - name: Validate and stage the merged version candidate
        id: stage
        if: ${{ (steps.plan.outputs.status == 'candidate' || steps.plan.outputs.status == 'released') && steps.plan.outputs.materialized == 'true' }}
        env:
          GH_TOKEN: ${{ github.token }}
          STATUS_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          RELEASE_TAG: ${{ steps.plan.outputs.tag }}
        run: |
          ./.csarc/scripts/publish-release stage \
            --repo "$GITHUB_REPOSITORY" --sha "$GITHUB_SHA" \
            --tag "$RELEASE_TAG" --branch "$GITHUB_REF_NAME"
      - name: Resolve the exact release state
        id: state
        if: ${{ steps.plan.outputs.status != 'no-release' }}
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ steps.stage.outputs.tag }}
        run: |
          ./.csarc/scripts/publish-release resolve \
            --repo "$GITHUB_REPOSITORY" --sha "$GITHUB_SHA" \
            --tag "$RELEASE_TAG"
      - name: Prepare release assets
        if: ${{ steps.state.outputs.state == 'draft' }}
        env:
          RELEASE_TAG: ${{ steps.state.outputs.tag }}
        run: python3 .csarc/scripts/release_bundle.py prepare --tag "$RELEASE_TAG" --output "$RUNNER_TEMP/release-assets"
      - name: Record included work in the draft Release
        if: ${{ steps.state.outputs.state == 'draft' }}
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ steps.state.outputs.tag }}
        run: |
          python3 .csarc/scripts/release_level.py annotate-release \
            --repo "$GITHUB_REPOSITORY" \
            --tag "$RELEASE_TAG" \
            --body-file "$RUNNER_TEMP/release-levels.md"
      - name: Generate the SPDX SBOM
        if: ${{ steps.state.outputs.state == 'draft' }}
        uses: anchore/sbom-action@3ad7283483fc7af8ff2b4ea19663c2d5ca935e26 # v0.24.2
        with:
          path: .
          format: spdx-json
          output-file: ${{ runner.temp }}/release-assets/sbom.spdx.json
          syft-version: v1.50.0
          upload-artifact: false
          upload-release-assets: false
          dependency-snapshot: false
      - name: Bind, upload, and publish the release
        if: ${{ steps.state.outputs.state == 'draft' }}
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ steps.state.outputs.tag }}
        run: |
          ./.csarc/scripts/publish-release publish \
            --repo "$GITHUB_REPOSITORY" --tag "$RELEASE_TAG"
      - name: Verify an already-published rerun
        if: ${{ steps.state.outputs.state == 'published' }}
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_TAG: ${{ steps.state.outputs.tag }}
        run: |
          ./.csarc/scripts/publish-release rerun-verify \
            --repo "$GITHUB_REPOSITORY" --tag "$RELEASE_TAG"
      - name: Complete a no-release Milestone
        if: ${{ steps.plan.outputs.status == 'no-release' }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 .csarc/scripts/sync_milestone_state.py complete-release \
            --repo "$GITHUB_REPOSITORY" \
            --main-sha "$GITHUB_SHA" \
            --evidence-url "https://github.com/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" \
            --outcome no-release
{% endraw %}

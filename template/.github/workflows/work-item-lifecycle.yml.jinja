{% raw %}name: Work item lifecycle

on:
  issues:
    types:
      [
        opened,
        edited,
        closed,
        reopened,
        labeled,
        unlabeled,
        milestoned,
        demilestoned,
      ]
  issue_comment:
    types: [created, edited, deleted]
  milestone:
    types: [created, edited, opened, closed]
  pull_request:
    types: [closed]

permissions:
  checks: write
  contents: read
  issues: write
  pull-requests: read

concurrency:
  group: work-item-lifecycle-${{ github.repository }}-${{ github.event.issue.milestone.number || github.event.changes.milestone.from.number || github.event.milestone.number || github.event.pull_request.milestone.number || github.event.issue.number || github.event.pull_request.number || 'misc' }}
  cancel-in-progress: ${{ github.event.issue.milestone.number == null && github.event.changes.milestone.from.number == null && github.event.milestone.number == null && github.event.pull_request.milestone.number == null }}

jobs:
  process:
    name: process
    if: >-
      ${{
        ({% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
        github.event_name == 'milestone') ||
        ({% endraw %}{{ 'true' if 'issues' in lifecycle else 'false' }}{% raw %} &&
        github.event_name == 'issue_comment' &&
        github.event.issue.pull_request == null) ||
        ({% endraw %}{{ 'true' if 'issues' in lifecycle or 'milestones' in lifecycle else 'false' }}{% raw %} &&
        github.event_name == 'issues' &&
        (github.event.issue.milestone.number != null ||
        github.event.changes.milestone.from.number != null ||
        ({% endraw %}{{ 'true' if 'issues' in lifecycle else 'false' }}{% raw %} &&
        contains(fromJSON('["opened","edited","reopened","closed"]'), github.event.action) &&
        github.event.issue.user.type == 'User'))) ||
        ({% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
        github.event_name == 'pull_request' &&
        github.event.pull_request.merged == true &&
        startsWith(github.event.pull_request.base.ref, 'dev/m') &&
        !startsWith(github.event.pull_request.head.ref, 'sync/'))
      }}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: "Issue triage: assign author and apply issue classification"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'issues' in lifecycle else 'false' }}{% raw %} &&
          github.event_name == 'issues' &&
          contains(fromJSON('["opened","edited","reopened","closed"]'), github.event.action) &&
          github.event.issue.user.type == 'User'
        env:
          GH_TOKEN: ${{ github.token }}
          ISSUE_AUTHOR: ${{ github.event.issue.user.login }}
          ISSUE_BODY: ${{ github.event.issue.body }}
          ISSUE_LABELS: ${{ join(github.event.issue.labels.*.name, ',') }}
          ISSUE_NUMBER: ${{ github.event.issue.number }}
          ISSUE_STATE_REASON: ${{ github.event.issue.state_reason }}
          ISSUE_TITLE: ${{ github.event.issue.title }}
          ISSUE_TYPE: ${{ github.event.issue.type.name }}
        run: ./.csarc/scripts/validate-issue-policy

      - name: "Issue metadata: synchronize linked pull requests"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
          github.event_name == 'issues' &&
          github.event.issue.pull_request == null &&
          contains(fromJSON('["milestoned","demilestoned"]'), github.event.action)
        env:
          GH_TOKEN: ${{ github.token }}
          ISSUE_NUMBER: ${{ github.event.issue.number }}
        run: >-
          python3 .csarc/scripts/sync_work_item_metadata.py
          --repo "$GITHUB_REPOSITORY"
          --issue "$ISSUE_NUMBER"

      - name: "Milestone lifecycle: reconcile lifecycle and refresh PR checks"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
          (github.event.issue.milestone.number != null || github.event.milestone.number != null)
        env:
          EVENT_ACTION: ${{ github.event.action }}
          EVENT_ISSUE_NUMBER: ${{ github.event.issue.number || 0 }}
          GH_TOKEN: ${{ github.token }}
          MILESTONE_NUMBER: ${{ github.event.issue.milestone.number || github.event.milestone.number }}
        run: >-
          python3 .csarc/scripts/sync_milestone_state.py reconcile
          --repo "$GITHUB_REPOSITORY"
          --milestone "$MILESTONE_NUMBER"
          --event-issue "$EVENT_ISSUE_NUMBER"
          --event-action "$EVENT_ACTION"

      - name: "Milestone lifecycle: refresh standalone Issue PR check"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'issues' in lifecycle else 'false' }}{% raw %} &&
          github.event_name == 'issue_comment' &&
          github.event.issue.pull_request == null &&
          github.event.issue.milestone.number == null
        env:
          GH_TOKEN: ${{ github.token }}
          ISSUE_NUMBER: ${{ github.event.issue.number }}
        run: >-
          python3 .csarc/scripts/sync_milestone_state.py refresh-issue-pr-checks
          --repo "$GITHUB_REPOSITORY"
          --issue "$ISSUE_NUMBER"

      - name: "Milestone lifecycle: reconcile the previous Milestone"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
          github.event.changes.milestone.from.number != null &&
          github.event.changes.milestone.from.number != github.event.issue.milestone.number
        env:
          EVENT_ACTION: ${{ github.event.action }}
          EVENT_ISSUE_NUMBER: ${{ github.event.issue.number || 0 }}
          GH_TOKEN: ${{ github.token }}
          MILESTONE_NUMBER: ${{ github.event.changes.milestone.from.number }}
        run: >-
          python3 .csarc/scripts/sync_milestone_state.py reconcile
          --repo "$GITHUB_REPOSITORY"
          --milestone "$MILESTONE_NUMBER"
          --event-issue "$EVENT_ISSUE_NUMBER"
          --event-action "$EVENT_ACTION"

      - name: "Work Issue closure: checkout the merge commit"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
          github.event.pull_request.merged == true &&
          startsWith(github.event.pull_request.base.ref, 'dev/m') &&
          !startsWith(github.event.pull_request.head.ref, 'sync/')
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          ref: ${{ github.event.pull_request.merge_commit_sha }}
      - name: "Work Issue closure: close the completed work Issue"
        if: >-
          !cancelled() &&
          {% endraw %}{{ 'true' if 'milestones' in lifecycle else 'false' }}{% raw %} &&
          github.event.pull_request.merged == true &&
          startsWith(github.event.pull_request.base.ref, 'dev/m') &&
          !startsWith(github.event.pull_request.head.ref, 'sync/')
        env:
          GH_TOKEN: ${{ github.token }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: >-
          python3 .csarc/scripts/pr_lifecycle.py close-work
          --repo "$GITHUB_REPOSITORY"
          --pr-number "$PR_NUMBER"
          --head-sha "$PR_HEAD_SHA"
{% endraw %}

version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      official-actions:
        patterns: ["actions/*"]
        update-types: [minor, patch]
{%- if "python" in languages %}
  - package-ecosystem: uv
    directory: /
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      routine-updates:
        patterns: ["*"]
        update-types: [minor, patch]
{%- if release_ownership == 'csarc-owned' %}
    commit-message:
      prefix: fix
      prefix-development: build
{%- endif %}
{%- endif %}
{%- if "typescript" in languages %}
  - package-ecosystem: npm
    directory: /
    target-branch: main

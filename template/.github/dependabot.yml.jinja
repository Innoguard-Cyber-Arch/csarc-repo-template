version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      # Dependabot exempts security updates; only version updates wait.
      default-days: 3
    labels: [enhancement]
{%- if language in ["python", "python-typescript"] %}
  - package-ecosystem: uv
    directory: /
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      # Dependabot exempts security updates; only version updates wait.
      default-days: 3
    labels: [enhancement]
{%- endif %}
{%- if language in ["typescript", "python-typescript"] %}
  - package-ecosystem: npm
    directory: /
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      # Dependabot exempts security updates; only version updates wait.
      default-days: 3
    labels: [enhancement]
{%- endif %}
{%- if (container_mode | default("none")) != "none" %}
  - package-ecosystem: docker
    directory: /{% if "/" in containerfile_path %}{{ containerfile_path.rsplit("/", 1)[0] }}{% endif %}
    target-branch: main
    schedule:
      interval: weekly
    cooldown:
      # Dependabot exempts security updates; only version updates wait.
      default-days: 3
    labels: [enhancement]
{%- endif %}

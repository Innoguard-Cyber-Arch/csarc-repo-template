version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    target-branch: {{ branch_strategy }}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
{%- if language in ["python", "python-typescript"] %}
  - package-ecosystem: uv
    directory: /
    target-branch: {{ branch_strategy }}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      routine-updates:
        patterns: ["*"]
        update-types: [minor, patch]
{%- endif %}
{%- if language in ["typescript", "python-typescript"] %}
  - package-ecosystem: npm
    directory: /
    target-branch: {{ branch_strategy }}
    schedule:
      interval: weekly
    cooldown:
      default-days: 3
    labels: [enhancement]
    groups:
      routine-updates:
        patterns: ["*"]
        update-types: [minor, patch]
{%- endif %}

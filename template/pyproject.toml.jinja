{% set python_target = "3.14" if python_floor == "latest" else python_floor -%}
[project]
name = {{ project_slug | tojson }}
version = "0.1.0b1"
description = {{ project_description | tojson }}
{% if documentation_mode != 'off' -%}
readme = "README.md"
{% endif -%}
license = "{{ 'LicenseRef-Proprietary' if project_license == 'proprietary' else project_license }}"
license-files = ["LICENSE"]
requires-python = "{% if python_floor == 'latest' %}>=3.14,<3.15{% else %}>={{ python_floor }}{% endif %}"
dependencies = []

[project.urls]
Repository = {{ repository_url | tojson }}

[dependency-groups]
dev = [
  "coverage[toml]>=7.10,<8",
  "diff-cover>=9.7,<11",
  "ty==0.0.76",
  "pytest>=8.4,<10",
  "pytest-cov>=6.2,<8",
  "ruff>=0.12,<1",
]

[build-system]
requires = ["hatchling>=1.27,<2"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 80
target-version = "py{{ python_target | replace('.', '') }}"
extend-exclude = [".cache"]

[tool.ruff.lint]
select = ["E", "F", "I", "N", "B", "S", "C901", "UP", "SIM", "RUF", "ANN", "D", "T20"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = [{{ package_name | tojson }}, "scripts"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["D", "S101"]

[tool.ty.environment]
python-version = "{{ python_target }}"

[tool.ty.src]
include = ["src", "scripts", "tests"]

[tool.pytest.ini_options]
addopts = "-q --strict-markers"
testpaths = ["tests"]
markers = [
  "large: long-running end-to-end coverage reserved for the integrated full gate",
  "runtime: minimal behavior that must pass on every supported Python runtime",
]

[tool.coverage.run]
branch = true
source = ["src"]

[tool.coverage.report]
show_missing = true
skip_covered = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.hatch.build.targets.sdist]
include = [
  "src/{{ package_name }}",
{% if documentation_mode != 'off' -%}
  "README.md",
{% endif -%}
  "LICENSE",
  "pyproject.toml",
]

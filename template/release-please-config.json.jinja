{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "{% if language == 'python' %}python{% else %}node{% endif %}",
  "packages": {
    ".": {
{% if language != "typescript" %}
      "extra-files": [
{% if language == "python-typescript" %}
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
{% endif %}
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value==\"{{ project_slug }}\")].version"
        },
        {
          "type": "generic",
          "path": "src/{{ package_name }}/__init__.py"
        }
      ]
{% else %}
      "release-type": "node"
{% endif %}
    }
  }
}

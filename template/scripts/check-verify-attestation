#!/usr/bin/env bash
set -euo pipefail

# Hosted-side half of Issue #661's local-attestation design: this is the
# entire body of the `verify` required check's GitHub Actions job now (see
# .github/workflows/ci.yml and, for generated projects,
# template/.github/workflows/ci.yml.jinja) -- it re-executes nothing, it
# only proves the current commit already carries proof it was verified
# locally. All three (see scripts/verify_attestation.py for the exact
# conditions and the reasoning behind each) must hold: the commit carries
# a well-formed `Verified-locally:` trailer; its sha256 matches the
# commit's own tree; its timestamp is fresh; and, when --required-scopes
# is given, its scope set covers the hosted plan. When --required-tier is
# given, the attested tier must also be at least as strong as what
# scripts/ci_tier.py and the release level require.
#
# Also runnable standalone, by a developer or agent, to self-check before
# pushing: scripts/check-verify-attestation HEAD
#
# Usage: scripts/check-verify-attestation <commit-sha> [--required-tier baseline|fast|docs|full] [--required-scopes csv] [--max-age-hours N]
#
# --resolve-merge-source --github-repo OWNER/NAME (Issue #699): for a
# commit that was pushed to main by a squash-merge, not a PR branch tip --
# release.yml's use case, not the `verify` required check's -- resolve the
# commit to the PR head it was merged from and validate that instead, so
# an unrelated PR landing on main between local verification and this
# PR's own merge cannot fail the check. See scripts/verify_attestation.py
# for the full reasoning.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 "$repo_root/scripts/verify_attestation.py" check "$@"

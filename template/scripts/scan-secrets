#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
gitleaks_bin="$("$repo_root/scripts/install-gitleaks")"
target="$repo_root"
target_set=false
log_opts=""

for argument in "$@"; do
  case "$argument" in
    --log-opts=*) log_opts="${argument#*=}" ;;
    --help)
      echo "Usage: $0 [path] [--log-opts='<git log options>']"
      exit 0
      ;;
    -*)
      echo "Unknown option: $argument" >&2
      exit 2
      ;;
    *)
      if [[ "$target_set" == true ]]; then
        echo "Only one scan path may be provided." >&2
        exit 2
      fi
      target="$argument"
      target_set=true
      ;;
  esac
done

target="$(cd "$target" && pwd)"
status=0
if git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
  git -C "$target" rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "Scanning reachable Git history with Gitleaks."
  history_args=(git "$target" --no-banner --redact)
  if [[ -n "$log_opts" ]]; then
    history_args+=(--log-opts="$log_opts")
  fi
  "$gitleaks_bin" "${history_args[@]}" || status=1
elif [[ -n "$log_opts" ]]; then
  echo "--log-opts requires a Git repository with at least one commit." >&2
  status=1
else
  echo "No committed Git history; history scan is not applicable."
fi

echo "Scanning the current working tree with Gitleaks."
"$gitleaks_bin" dir "$target" --no-banner --redact || status=1
exit "$status"

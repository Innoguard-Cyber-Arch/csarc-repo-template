#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT
validator="$test_root/validator"
title_validator="$repo_root/scripts/validate-issue-title"

if grep -Eq 'types:.*labeled' \
  "$repo_root/.github/workflows/issue-triage.yml"; then
  echo "Issue triage must not subscribe to its own label changes."
  exit 1
fi

valid_titles=(
  "Fix authentication timeout handling"
  "Document GitHub App setup"
  "Add automated health endpoint"
)
invalid_titles=(
  "Fix timeout"
  "修正登入逾時問題"
  "[Bug] Fix broken login flow"
  "[SPEC-001] Add health check endpoint"
  "bug: Fix broken login flow"
  "Fix broken login flow."
  "Add an excessively long Issue title that exceeds the eighty character maximum for this repository"
)
for title in "${valid_titles[@]}"; do
  "$title_validator" "$title"
done
for title in "${invalid_titles[@]}"; do
  if "$title_validator" "$title" >/dev/null 2>&1; then
    echo "Issue title validator accepted: $title"
    exit 1
  fi
done

{
  printf '#!/usr/bin/env bash\n'
  awk '
    /^      - name: Assign author and apply issue classification$/ { found = 1; next }
    found && /^        run: \|$/ { in_run = 1; next }
    in_run && /^$/ { print; next }
    in_run && /^          / { sub(/^          /, ""); print; next }
    in_run { exit }
  ' "$repo_root/.github/workflows/issue-triage.yml"
} > "$validator"
chmod +x "$validator"

mkdir -p "$test_root/bin"
cat > "$test_root/bin/gh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_LOG"
if [[ " $* " == *" api repos/owner/repo/issues/42 "* ]]; then
  printf '{"number":42,"labels":[]}\n'
  exit 0
fi
if [[ "${MOCK_ISSUE_TYPES_AVAILABLE:-true}" != "true" &&
      ( " $* " == *" --type "* || " $* " == *" --remove-type "* ) ]]; then
  exit 1
fi
SH
chmod +x "$test_root/bin/gh"
export PATH="$test_root/bin:$PATH"
export GH_LOG="$test_root/gh.log"
export GITHUB_REPOSITORY="owner/repo"
export ISSUE_AUTHOR="contributor"
export ISSUE_NUMBER="42"
export ISSUE_STATE_REASON=""
export ISSUE_TITLE="Add dependency policy checks"

ISSUE_BODY=$'### 類型\n\nfeature\n\n### 問題\n\nExample' \
ISSUE_LABELS="" "$validator"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label enhancement' "$GH_LOG"
grep -q -- '--type Feature' "$GH_LOG"

: > "$GH_LOG"
ISSUE_BODY=$'### 類型\n\ntask\n\n### 問題\n\nExample' \
ISSUE_LABELS="" "$validator"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label enhancement' "$GH_LOG"
grep -q -- '--type Task' "$GH_LOG"

: > "$GH_LOG"
ISSUE_BODY="" ISSUE_LABELS="bug" "$validator"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label bug' "$GH_LOG"
grep -q -- '--type Bug' "$GH_LOG"

: > "$GH_LOG"
ISSUE_BODY=$'### 類型\n\nduplicate\n\n### 問題\n\nSame as #41' \
ISSUE_LABELS="" "$validator"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label duplicate' "$GH_LOG"
grep -q -- '--remove-type' "$GH_LOG"

: > "$GH_LOG"
ISSUE_BODY=$'### 類型\n\nbug' \
ISSUE_LABELS="enhancement" "$validator"
grep -q -- '--remove-label enhancement' "$GH_LOG"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label bug' "$GH_LOG"
grep -q -- '--type Bug' "$GH_LOG"

: > "$GH_LOG"
ISSUE_STATE_REASON="duplicate" \
ISSUE_BODY="" ISSUE_LABELS="bug" "$validator"
grep -q -- '--remove-label bug' "$GH_LOG"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label duplicate' "$GH_LOG"

: > "$GH_LOG"
MOCK_ISSUE_TYPES_AVAILABLE="false" ISSUE_BODY=$'### 類型\n\ndocumentation' \
ISSUE_LABELS="" "$validator"
grep -q -- '--add-assignee contributor' "$GH_LOG"
grep -q -- '--add-label documentation' "$GH_LOG"
grep -q -- '--type Task' "$GH_LOG"

if ISSUE_BODY="" ISSUE_LABELS="" "$validator" >/dev/null 2>&1; then
  echo "Issue triage accepted an Issue without an allowed type."
  exit 1
fi

echo "Issue title cases passed: 10; triage cases passed: 8"

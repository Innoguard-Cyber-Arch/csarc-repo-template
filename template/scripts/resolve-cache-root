#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_root="${CSARC_CACHE_ROOT:-$repo_root/.cache}"

if [[ "$cache_root" != /* ]]; then
  printf 'CSARC_CACHE_ROOT must be an absolute path: %s\n' "$cache_root" >&2
  exit 2
fi

mkdir -p "$cache_root"
printf '%s\n' "$cache_root"

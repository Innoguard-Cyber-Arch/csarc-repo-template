#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/cleanup-worktrees [--apply] [--worktree PATH] [INTEGRATION_REF]

List clean linked worktrees whose pull requests have reached INTEGRATION_REF.
Use --apply to remove them. Repeat --worktree to limit cleanup to worktrees
owned by the current task. The default integration ref is origin/HEAD.
EOF
}

apply=false
integration_ref=""
selected_paths=()
while (($#)); do
  case "$1" in
    --apply)
      apply=true
      shift
      ;;
    --worktree)
      if (($# < 2)); then
        usage >&2
        exit 2
      fi
      selected_paths+=("$2")
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$integration_ref" ]]; then
        usage >&2
        exit 2
      fi
      integration_ref="$1"
      shift
      ;;
  esac
done

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ -z "$integration_ref" ]]; then
  integration_ref="$(
    git symbolic-ref --quiet --short refs/remotes/origin/HEAD || true
  )"
  integration_ref="${integration_ref:-origin/main}"
fi
if ! git rev-parse --verify --quiet "$integration_ref^{commit}" >/dev/null; then
  echo "Integration ref does not exist: $integration_ref" >&2
  exit 2
fi
if ! command -v gh >/dev/null; then
  echo "GitHub CLI is required to verify merged pull requests." >&2
  exit 2
fi

canonical_path() (
  cd "$1" 2>/dev/null && pwd -P
)

for index in "${!selected_paths[@]}"; do
  if ! selected_paths[$index]="$(canonical_path "${selected_paths[$index]}")"; then
    echo "Worktree does not exist: ${selected_paths[$index]}" >&2
    exit 2
  fi
done

is_selected() {
  local path="$1"
  local selected
  ((${#selected_paths[@]} == 0)) && return 0
  for selected in "${selected_paths[@]}"; do
    [[ "$path" == "$selected" ]] && return 0
  done
  return 1
}

merged_pr_reaches_ref() {
  local start_sha="$1"
  local index=0
  local sha rows number state merged_at merge_sha base_ref head_sha
  local integration_full integration_branch
  local -a candidates
  local queue=("$start_sha")
  local seen=" $start_sha "

  integration_full="$(git rev-parse --symbolic-full-name "$integration_ref")"
  case "$integration_full" in
    refs/heads/*) integration_branch="${integration_full#refs/heads/}" ;;
    refs/remotes/*/*)
      integration_branch="${integration_full#refs/remotes/}"
      integration_branch="${integration_branch#*/}"
      ;;
    *)
      echo "Integration ref is not a branch: $integration_ref" >&2
      return 2
      ;;
  esac

  while ((index < ${#queue[@]})); do
    sha="${queue[$index]}"
    ((index += 1))
    if ! rows="$(
      gh api "repos/{owner}/{repo}/commits/$sha/pulls" \
        --jq '.[] | [.number, .state, (.merged_at // "-"), (.merge_commit_sha // "-"), (.base.ref // "-"), (.head.sha // "-")] | join("|")'
    )"; then
      echo "Could not verify pull requests for commit $sha." >&2
      return 2
    fi
    candidates=()
    while IFS='|' read -r number state merged_at merge_sha base_ref head_sha; do
      [[ -n "$number" ]] || continue
      if [[ "$state" != "open" && "$merged_at" != "-" && \
        "$merge_sha" != "-" && "$head_sha" == "$sha" ]]; then
        candidates+=("$merge_sha|$base_ref")
      fi
    done <<<"$rows"
    ((${#candidates[@]} <= 1)) || return 1
    ((${#candidates[@]} == 1)) || continue
    IFS='|' read -r merge_sha base_ref <<<"${candidates[0]}"
    git merge-base --is-ancestor "$merge_sha" "$integration_ref" || return 1
    [[ "$base_ref" != "$integration_branch" ]] || return 0
    if [[ "$seen" != *" $merge_sha "* ]]; then
      queue+=("$merge_sha")
      seen+="$merge_sha "
    fi
  done
  return 1
}

paths=()
heads=()
branches=()
detached_flags=()
locked_flags=()
path=""
head=""
branch=""
detached=false
locked=false
while IFS= read -r -d '' field; do
  if [[ -z "$field" ]]; then
    if [[ -n "$path" ]]; then
      paths+=("$path")
      heads+=("$head")
      branches+=("$branch")
      detached_flags+=("$detached")
      locked_flags+=("$locked")
    fi
    path=""
    head=""
    branch=""
    detached=false
    locked=false
    continue
  fi
  case "$field" in
    "worktree "*) path="${field#worktree }" ;;
    "HEAD "*) head="${field#HEAD }" ;;
    "branch "*) branch="${field#branch refs/heads/}" ;;
    detached) detached=true ;;
    locked*) locked=true ;;
  esac
done < <(git worktree list --porcelain -z)

main_worktree="$(canonical_path "${paths[0]}")"
current_worktree="$(canonical_path "$repo_root")"
candidate_count=0
removed_count=0

for index in "${!paths[@]}"; do
  path="${paths[$index]}"
  [[ -d "$path" ]] || continue
  path="$(canonical_path "$path")"
  is_selected "$path" || continue

  if [[ "$path" == "$main_worktree" ]]; then
    printf 'skip\tmain worktree\t%s\n' "$path"
  elif [[ "$path" == "$current_worktree" ]]; then
    printf 'skip\tcurrent worktree\t%s\n' "$path"
  elif [[ "${locked_flags[$index]}" == true ]]; then
    printf 'skip\tlocked\t%s\n' "$path"
  elif [[ "${detached_flags[$index]}" == true || -z "${branches[$index]}" ]]; then
    printf 'skip\tdetached\t%s\n' "$path"
  elif [[ -n "$(git -C "$path" status --porcelain --untracked-files=all)" ]]; then
    printf 'skip\tdirty\t%s\n' "$path"
  else
    merge_status=0
    merged_pr_reaches_ref "${heads[$index]}" || merge_status=$?
    if ((merge_status == 2)); then
      exit 2
    elif ((merge_status != 0)); then
      printf 'skip\tnot verified merged\t%s\n' "$path"
      continue
    fi

    ((candidate_count += 1))
    if $apply; then
      git worktree remove "$path"
      ((removed_count += 1))
      printf 'removed\t%s\t%s\n' "${branches[$index]}" "$path"
    else
      printf 'candidate\t%s\t%s\n' "${branches[$index]}" "$path"
    fi
  fi
done

if $apply; then
  git worktree prune
  printf 'Removed %d of %d candidate worktree(s).\n' \
    "$removed_count" "$candidate_count"
else
  printf 'Dry run: %d candidate worktree(s); rerun with --apply to remove.\n' \
    "$candidate_count"
fi

{% set python_target = "3.14" if python_support_mode == "latest" else python_min_version -%}
{% set has_python = language in ["python", "python-typescript"] -%}
{% set has_typescript = language in ["typescript", "python-typescript"] -%}
#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$repo_root/.cache/uv}"
cd "$repo_root"

tier="${CSARC_CI_TIER:-fast}"
scope_value="${CSARC_CI_SCOPES:-source}"
risk_value="${CSARC_CI_RISKS:-}"
{% if has_python %}export UV_PYTHON="${CSARC_PYTHON_VERSION:-{{ python_target }}}"
{% endif -%}
case "$tier" in
  docs|fast) ;;
  *)
    echo "Unsupported CI tier: ${tier:-<empty>}" >&2
    exit 2
    ;;
esac

test_paths=()
run_pr_policy=false
run_release_policy=false
run_issue_policy=false
run_worktree_policy=false
add_tests() {
  local candidate existing
  for candidate in "$@"; do
    if [[ "$candidate" == tests ]]; then
      test_paths=(tests)
      continue
    fi
    for existing in "${test_paths[@]:-}"; do
      [[ "$existing" == tests || "$existing" == "$candidate" ]] && continue 2
    done
    test_paths+=("$candidate")
  done
}

IFS=, read -r -a requested_scopes <<< "$scope_value"
for scope in "${requested_scopes[@]}"; do
  case "$scope" in
    docs) add_tests tests/test_spec_to_issue.py ;;
    source) add_tests tests ;;
    template) add_tests tests ;;
    workflow)
      add_tests tests/test_ci_tier.py tests/test_release_policy.py
      run_pr_policy=true
      run_release_policy=true
      run_issue_policy=true
      ;;
    governance)
      add_tests tests/test_delivery_sync.py tests/test_milestone_lifecycle.py \
        tests/test_pr_lifecycle.py tests/test_promotion_gate.py \
        tests/test_work_item_metadata.py
      run_pr_policy=true
      run_release_policy=true
      run_issue_policy=true
      run_worktree_policy=true
      ;;
    dependency)
      add_tests tests/test_release_assets.py tests/test_release_policy.py
      run_release_policy=true
      ;;
    shell)
      add_tests tests/test_ci_tier.py tests/test_pytest_policy.py
      run_pr_policy=true
      run_release_policy=true
      run_issue_policy=true
      run_worktree_policy=true
      ;;
    *)
      echo "Unsupported CI scope: ${scope:-<empty>}" >&2
      exit 2
      ;;
  esac
done

if [[ -n "$risk_value" ]]; then
  IFS=, read -r -a requested_risks <<< "$risk_value"
  for risk in "${requested_risks[@]}"; do
    case "$risk" in
    cli-adoption-update|generator) add_tests tests ;;
    release|security|provenance)
      add_tests tests/test_release_assets.py tests/test_release_policy.py
      run_release_policy=true
      ;;
    governance|promotion)
      add_tests tests/test_delivery_sync.py tests/test_milestone_lifecycle.py \
        tests/test_pr_lifecycle.py tests/test_promotion_gate.py
      ;;
    ci-router) add_tests tests/test_ci_tier.py ;;
    test-harness) add_tests tests ;;
    verifier|workflow) add_tests tests/test_ci_tier.py ;;
      *)
        echo "Unsupported CI risk: $risk" >&2
        exit 2
        ;;
    esac
  done
fi

git diff --check
./scripts/check-update-conflicts
./scripts/scan-secrets

if [[ "$tier" == "docs" ]]; then
  python3 scripts/spec_to_issue.py validate
  exit 0
fi

if [[ ",$scope_value," == *,workflow,* || ",$scope_value," == *,shell,* ]]; then
  ./scripts/lint-workflows-shell
fi

$run_pr_policy && ./scripts/test-pr-policy
$run_release_policy && ./scripts/test-release-follow-up-gates
$run_issue_policy && ./scripts/test-issue-triage
$run_worktree_policy && ./scripts/test-worktree-cleanup
{% if has_python -%}
python_version="$UV_PYTHON"
uv sync --locked --python "$python_version"
uv run ruff format --check .
uv run ruff check .
uv run mypy
uv run pytest -m "not large" "${test_paths[@]}"
{% endif -%}
{% if has_typescript -%}
pnpm install --frozen-lockfile --ignore-scripts
pnpm exec biome ci .
pnpm exec tsc --noEmit
pnpm exec vitest run
{% endif -%}

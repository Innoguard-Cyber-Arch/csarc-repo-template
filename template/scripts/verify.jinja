#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -n "${_CSARC_PROJECT_VERIFICATION_ACTIVE:-}" ]]; then
  echo "Project verification hook must not invoke canonical scripts/verify." >&2
  exit 1
fi

record_project_verification_status() {
  local status_fd="${_CSARC_PROJECT_VERIFICATION_STATUS_FD:-}"
  if [[ -n "$status_fd" ]]; then
    if [[ ! "$status_fd" =~ ^[0-9]+$ ]] ||
      ! printf '%s\n' "$1" >&"$status_fd"; then
      echo "Internal project verification status descriptor is invalid." >&2
      exit 1
    fi
  fi
}
record_project_verification_status not-run

mode="${1:-full}"
if [[ "$mode" != "full" && "$mode" != "python-compatibility" &&
  "$mode" != "typescript" ]]; then
  echo "Usage: $0 [full|python-compatibility|typescript]" >&2
  exit 2
fi

for workflow in .github/workflows/{pr-policy,promotion}.yml; do
  if grep -Eq 'secrets\.(CSARC_SYNC_TOKEN|CSARC_ADMIN_TOKEN|GH_ADMIN_TOKEN|ADMIN_TOKEN)' \
    "$workflow"; then
    echo "$workflow exposes an administration token to an untrusted event."
    exit 1
  fi
done
grep -q 'gh auth setup-git' .github/workflows/delivery-maintenance.yml

verify_python={{ "true" if language in ["python", "python-typescript"] else "false" }}
verify_typescript="${CSARC_VERIFY_TYPESCRIPT:-{{ "true" if language in ["typescript", "python-typescript"] else "false" }}}"
temporary_paths=()
cleanup() {
  local path
  for path in "${temporary_paths[@]:-}"; do
    [[ -n "$path" ]] && rm -rf "$path"
  done
  return 0
}
trap cleanup EXIT

verify_typescript_module() {
  command -v node >/dev/null
  command -v pnpm >/dev/null
  test "$(node -p 'Number(process.versions.node.split(".")[0]) >= 24')" = "true"
  test "$(pnpm --version | cut -d. -f1)" = "11"
  pnpm install --frozen-lockfile --ignore-scripts
  pnpm exec biome ci .
  pnpm exec tsc --noEmit
  pnpm exec vitest run --coverage
  pnpm run build
  mkdir -p dist
  find dist -maxdepth 1 -type f -name '.gitignore' -delete
  find dist -maxdepth 1 -type f -name '*.tgz' -delete
  pnpm pack --pack-destination dist >/dev/null
  typescript_tarball="$(find dist -maxdepth 1 -type f -name '*.tgz' -print -quit)"
  test -n "$typescript_tarball"
  typescript_install_root="$(mktemp -d)"
  temporary_paths+=("$typescript_install_root")
  pnpm --dir "$typescript_install_root" add \
    "$repo_root/$typescript_tarball" --ignore-scripts --silent
  (
    cd "$typescript_install_root"
    node --input-type=module -e "import('{{ project_slug }}')"
  )
}

if [[ "$mode" == "python-compatibility" ]]; then
  if ! $verify_python; then
    echo "Python compatibility is unavailable for this language profile." >&2
    exit 2
  fi
  python_version="${CSARC_PYTHON_VERSION:-3.14}"
  export UV_PYTHON="$python_version"
  uv sync --locked --python "$python_version"
  uv run pytest -m "not large"
  exit 0
fi

if [[ "$mode" == "typescript" ]]; then
  if [[ "$verify_typescript" != "true" ]]; then
    echo "TypeScript verification is unavailable for this language profile." >&2
    exit 2
  fi
  verify_typescript_module
  exit 0
fi

./scripts/check-update-conflicts
./scripts/check-project-metadata
uv run --no-project python scripts/render_site.py --check
./scripts/test-worktree-cleanup
./scripts/detect-language-profile
./scripts/test-pr-policy
./scripts/test-release-follow-up-gates
./scripts/test-issue-triage
./scripts/lint-workflows-shell

if $verify_python; then
  python_version="${CSARC_PYTHON_VERSION:-3.14}"
  export UV_PYTHON="$python_version"
  uv sync --locked --python "$python_version"
  uv run ruff format --check .
  uv run ruff check .
  uv run mypy
  uv run python - <<'PY'
from importlib import import_module
from importlib.metadata import version

package_version = getattr(import_module("{{ package_name }}"), "__version__", None)
installed_version = version("{{ project_slug }}")
if package_version != installed_version:
    raise SystemExit(
        "Python package __version__ does not match pyproject.toml: "
        f"{package_version} != {installed_version}"
    )
PY
{% if coverage_mode == "global" %}
  uv run pytest --cov --cov-report=term-missing --cov-report=xml --cov-fail-under={{ coverage_threshold }}
{% else %}
  uv run pytest --cov --cov-report=term-missing --cov-report=xml
  compare_branch="${DIFF_COVER_COMPARE_BRANCH:-origin/main}"
  if ! git rev-parse --verify --quiet "$compare_branch" >/dev/null; then
    echo "Set DIFF_COVER_COMPARE_BRANCH to an existing ref (current: $compare_branch)." >&2
    exit 1
  fi
  uv run diff-cover coverage.xml --compare-branch="$compare_branch" --fail-under={{ coverage_threshold }}
{% endif %}
  uv build --clear
  python_sdist="$(find dist -maxdepth 1 -type f -name '*.tar.gz' -print -quit)"
  test -n "$python_sdist"
  python_sdist_entries="$(tar -tzf "$python_sdist")"
  grep -q '/src/{{ package_name }}/' <<<"$python_sdist_entries"
  if grep -Eq '/(\.github|policies|scripts|tests|typescript)/' <<<"$python_sdist_entries"; then
    echo "Python sdist contains repository infrastructure or test files." >&2
    exit 1
  fi
  uv run --isolated --no-project --with ./dist/*.whl \
    python -c "import {{ package_name }}"
  uv run --isolated --no-project --with twine twine check dist/*
fi

if [[ "$verify_typescript" == "true" ]]; then
  verify_typescript_module
fi

if $verify_python; then
  platform_python=(uv run python)
else
  platform_python=(uv run --no-project python)
fi
"${platform_python[@]}" scripts/spec_to_issue.py validate
test -f docs/README.md
test -f docs/adr/README.md
grep -q 'Durable Project Memory' docs/README.md
grep -q 'Spec-Driven Development' docs/README.md
grep -q 'Architecture Decision Records' docs/README.md
grep -q 'Test-Driven Development' docs/README.md
grep -q 'Behavior-Driven Development' docs/README.md
grep -q 'docs/decisions/' docs/README.md
"${platform_python[@]}" -m json.tool .csarc/profile.json >/dev/null
"${platform_python[@]}" - <<'PY'
import json
from pathlib import Path, PurePosixPath

profile = json.loads(Path(".csarc/profile.json").read_text(encoding="utf-8"))
container = profile.get("container", {})
mode = container.get("mode")
if mode not in {"none", "verify", "ghcr"}:
    raise SystemExit(f"Invalid container mode: {mode!r}")
enabled = mode != "none"
if profile.get("modules", {}).get("container") is not enabled:
    raise SystemExit("Container module does not match container mode")
if enabled:
    containerfile = container.get("file", "")
    if not isinstance(containerfile, str):
        raise SystemExit("Container file must be a string")
    path = PurePosixPath(containerfile)
    if not containerfile or path.is_absolute() or ".." in path.parts:
        raise SystemExit("Container file must be a safe repository-relative path")
    if not Path(containerfile).is_file():
        raise SystemExit(f"Container file does not exist: {containerfile}")
    smoke = container.get("smoke_command", "")
    if (
        not isinstance(smoke, str)
        or "$IMAGE" not in smoke
        or len(smoke.splitlines()) != 1
    ):
        raise SystemExit("Container smoke command must be one line using $IMAGE")
PY
"${platform_python[@]}" -m json.tool policies/repository.json >/dev/null
"${platform_python[@]}" -m json.tool policies/actions.json >/dev/null
"${platform_python[@]}" -m json.tool policies/labels.json >/dev/null
"${platform_python[@]}" -m json.tool policies/rulesets.json >/dev/null
"${platform_python[@]}" -m json.tool policies/dev-next-ruleset.json >/dev/null
"${platform_python[@]}" -m json.tool release-please-config.json >/dev/null
"${platform_python[@]}" -m json.tool .release-please-manifest.json >/dev/null
"${platform_python[@]}" - <<'PY'
import json
import tomllib
from pathlib import Path

versions = {
    "release manifest": json.loads(
        Path(".release-please-manifest.json").read_text(encoding="utf-8")
    )["."]
}
if Path("pyproject.toml").exists():
    versions["pyproject.toml"] = tomllib.loads(
        Path("pyproject.toml").read_text(encoding="utf-8")
    )["project"]["version"]
if Path("package.json").exists():
    versions["package.json"] = json.loads(
        Path("package.json").read_text(encoding="utf-8")
    )["version"]
if Path("version.txt").exists():
    versions["version.txt"] = Path("version.txt").read_text(encoding="utf-8").strip()
if len(set(versions.values())) != 1:
    raise SystemExit(f"Release versions do not match: {versions}")
print(f"release version: {next(iter(versions.values()))}")
PY
test -x scripts/apply-repository-settings.sh
test -x scripts/detect-language-profile
test -x scripts/pr_lifecycle.py
grep -q 'scripts/pr_lifecycle.py' AGENTS.md
grep -q '^## PR lifecycle single-writer$' docs/ci-policy.md
grep -q 'release pull request (human-only)' docs/ci-policy.md
"${platform_python[@]}" scripts/pr_lifecycle.py scan-writers --root .

test -f AGENTS.md
test "$(cat CLAUDE.md)" = "@AGENTS.md"
template_mode="$("${platform_python[@]}" -c 'import json; print(json.load(open(".csarc/profile.json"))["template_mode"])')"
if [[ "$template_mode" == "new" ]]; then
  test "$(wc -l < AGENTS.md)" -le 200
  required_readme_headings=(
    "專案概述"
    "快速開始"
    "技術與目錄"
    "開發與驗證"
    "設定與密鑰"
    "發布與維運"
    "負責人與支援"
    "公版更新"
  )
  for heading in "${required_readme_headings[@]}"; do
    if ! grep -qFx "## $heading" README.md; then
      echo "README.md is missing required section: $heading"
      exit 1
    fi
  done
fi
unsupported_instruction_paths=(
  .cursorrules
  .windsurfrules
  .clinerules
  GEMINI.md
  .github/copilot-instructions.md
  .cursor/rules
  .claude/rules
)
for unsupported_path in "${unsupported_instruction_paths[@]}"; do
  test ! -e "$unsupported_path"
done

./scripts/scan-secrets

if $verify_python; then
  lower_bounds_root="$(mktemp -d)"
  temporary_paths+=("$lower_bounds_root")
  if ! uv pip compile \
    pyproject.toml \
    --group dev \
    --resolution lowest-direct \
    --python-version "$python_version" \
    --output-file "$lower_bounds_root/requirements-min.txt"; then
    echo "Dev dependency lower bounds cannot be resolved on Python $python_version."
    exit 1
  fi
  uv venv --python "$python_version" "$lower_bounds_root/.venv"
  if ! uv pip install \
    --python "$lower_bounds_root/.venv/bin/python" \
    --requirements "$lower_bounds_root/requirements-min.txt"; then
    echo "Dev dependency lower bounds cannot be installed on Python $python_version."
    exit 1
  fi
  uv pip install \
    --python "$lower_bounds_root/.venv/bin/python" \
    --no-deps \
    --editable .
  uv pip check --python "$lower_bounds_root/.venv/bin/python"
{% if coverage_mode == "global" %}
  if ! "$lower_bounds_root/.venv/bin/python" -m pytest \
    --cov \
    --cov-report=term-missing \
    --cov-fail-under={{ coverage_threshold }}; then
    echo "Tests fail with direct dependency lower bounds on Python $python_version."
    exit 1
  fi
{% else %}
  if ! "$lower_bounds_root/.venv/bin/python" -m pytest \
    --cov \
    --cov-report=term-missing \
    --cov-report=xml; then
    echo "Tests fail with direct dependency lower bounds on Python $python_version."
    exit 1
  fi
  "$lower_bounds_root/.venv/bin/diff-cover" coverage.xml \
    --compare-branch="$compare_branch" \
    --fail-under={{ coverage_threshold }}
{% endif %}
fi

project_verification_hook='{{ project_verification_hook | default("", true) }}'
if [[ -z "$project_verification_hook" && -x scripts/verify-product ]]; then
  project_verification_hook="scripts/verify-product"
fi
if [[ -n "$project_verification_hook" ]]; then
  verified_hook="$("${platform_python[@]}" - "$project_verification_hook" <<'PY'
import os
import re
import sys
from pathlib import Path

raw = sys.argv[1]
relative = Path(raw)
if (
    not raw
    or raw != raw.strip()
    or relative.is_absolute()
    or ".." in relative.parts
    or re.fullmatch(r"[A-Za-z0-9._/-]+", raw) is None
):
    raise SystemExit("Project verification hook is not a safe relative path")
root = Path.cwd().resolve(strict=True)
try:
    hook = (root / relative).resolve(strict=True)
except OSError as error:
    raise SystemExit(f"Project verification hook does not exist: {raw}") from error
if hook != root and root not in hook.parents:
    raise SystemExit(f"Project verification hook escapes the repository: {raw}")
if not hook.is_file() or not os.access(hook, os.X_OK):
    raise SystemExit(f"Project verification hook is not executable: {raw}")
canonical = root / "scripts" / "verify"
try:
    if canonical.exists() and os.path.samefile(hook, canonical):
        raise SystemExit(
            "Project verification hook must not resolve to canonical scripts/verify"
        )
except OSError as error:
    raise SystemExit(f"Cannot compare project verification hook: {raw}") from error
print(hook)
PY
)"
  record_project_verification_status started
  status_fd="${_CSARC_PROJECT_VERIFICATION_STATUS_FD:-}"
  if (
    if [[ -n "$status_fd" ]]; then
      [[ "$status_fd" =~ ^[0-9]+$ ]]
      eval "exec ${status_fd}>&-"
    fi
    unset _CSARC_PROJECT_VERIFICATION_STATUS_FD
    export _CSARC_PROJECT_VERIFICATION_ACTIVE=1
    exec "$verified_hook"
  ); then
    record_project_verification_status passed
  else
    hook_status=$?
    record_project_verification_status failed
    exit "$hook_status"
  fi
fi

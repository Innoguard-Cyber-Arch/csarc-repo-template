    branch: {{ branch_strategy | tojson }},
    owner: {{ code_owner | tojson }},
    stage: "beta"
  },
  start: {
    prerequisites: [
      "Git",
      "GitHub CLI",
      "uv"{% if language in ["typescript", "python-typescript"] %},
      "Node 24+",
      "pnpm 11"{% endif %}
    ],
    commands: [
      "git clone <repository-url>",
      "cd {{ project_slug }}",
      "./scripts/verify"
    ]
  },
  structure: [
    { path: ".github/", purpose: "PR、CI 與安全自動化", owner: "公版主導" },
    { path: "policies/", purpose: "可審查的 GitHub 設定", owner: "公版主導" },
    { path: "docs/specs/", purpose: "功能規格與 Issue 來源", owner: "專案維護" },
{% if language in ["python", "python-typescript"] %}
    { path: "src/＋tests/", purpose: "Python 產品與測試", owner: "專案維護" },
{% endif %}{% if language in ["typescript", "python-typescript"] %}
    { path: "typescript/", purpose: "TypeScript 產品與測試", owner: "專案維護" },
{% endif %}
    { path: "scripts/verify", purpose: "本機與 CI 共同入口", owner: "公版主導" },
    { path: "docs/site-content.js", purpose: "本網站的專案內容", owner: "專案維護" }
  ],
  workflow: [
    { title: "1｜定義工作", detail: "Issue 用 12–80 字元英文標題摘要成果；內文選類型，必填問題與完成條件，其餘放在選填補充。" },
    { title: "2｜分支與實作", detail: "從 {{ branch_strategy }} 或最終回到它的 open PR 分支建立 type/<Issue 編號>-簡稱；若超出原單就另開 Issue。" },
    { title: "3｜驗證", detail: "本機執行 ./scripts/verify，PR 由 CI 重跑同一入口。" },
    { title: "4｜審查", detail: "PR 連回 Issue、完成精簡清單並選一個工作標籤；風險或回退放在選填補充，再由同事與 CODEOWNER 審查。" },
    { title: "5｜交付", detail: "tag 建立可追溯成品、SHA-256 與非空 SBOM；部署依專案另訂。" }
  ],
  safeguards: [
{% if language != "ci" %}
    "Coverage 是未測程式碼的訊號，不等於品質；新案看全域、既有案先看 changed lines，門檻依缺陷與模組風險調整。",
{% endif %}
    "一般相依新版等待三天；pnpm 另拒絕 publisher trust 降級，已公開漏洞由 OSV 立即通知。",
    "lockfile 保存下載內容雜湊；第三方 Actions 固定完整 commit SHA。",
    "PR 政策包含合法／不合法回歸測資，避免門禁只會顯示綠燈。",
    "token 與私鑰放 GitHub Secrets／Variables，不提交到 repo 或 .env。",
    "設定腳本先查 GitHub 方案與 Ruleset API；Free private repo 預設阻擋 apply，CI 的 governance check 持續告警，release 與 registry publishing 維持 fail-closed。",
    "Artifact attestation 在 public repo 預設開啟；private／internal repo 維持明確 opt-in，其他情況以 Release 上的 SHA-256 驗證。",

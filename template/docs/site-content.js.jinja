{% set has_container = (container_mode | default("none")) != "none" -%}
window.CSARC_SITE_CONTENT = {
  schemaVersion: 1,
  project: {
    name: {{ project_name | tojson }},
    description: {{ project_description | tojson }},
    language: {{ language | tojson }},
    branch: {{ branch_strategy | tojson }},
    owner: {{ code_owner | tojson }},
    stage: {% if language == "ci" %}"beta"{% else %}"alpha"{% endif %}
  },
  start: {
    prerequisites: [
      "Git",
      "GitHub CLI",
      "uv"{% if language in ["typescript", "python-typescript"] %},
      "Node 24+",
      "pnpm 11"{% endif %}
    ],
    commands: [
      "git clone {{ repository_url }}",
      "cd {{ project_slug }}",
      "./scripts/verify"
    ]
  },
  structure: [
    { path: ".github/", purpose: "PR、CI 與安全自動化", owner: "公版主導" },
    { path: "policies/", purpose: "可審查的 GitHub 設定", owner: "公版主導" },
    { path: "docs/adr/", purpose: "架構決策紀錄（ADR）與取捨歷史", owner: "專案維護" },
    { path: "docs/specs/", purpose: "Spec-Driven Development（SDD）的 living specifications", owner: "專案維護" },
{% if language in ["python", "python-typescript"] %}
    { path: "src/＋tests/", purpose: "Python 產品與測試", owner: "專案維護" },
{% endif %}{% if language in ["typescript", "python-typescript"] %}
    { path: "typescript/", purpose: "TypeScript 產品與測試", owner: "專案維護" },
{% endif %}{% if has_container %}
    { path: {{ containerfile_path | tojson }}, purpose: "產品容器建置、啟動與漏洞掃描", owner: "專案維護" },
{% endif %}
    { path: "scripts/verify", purpose: "本機與 CI 共同入口", owner: "公版主導" },
    { path: "docs/site-content.js", purpose: "本網站的專案內容", owner: "專案維護" }
  ],
  workflow: [
    { title: "1｜讀取記憶並定義工作", detail: "先讀 docs/README.md 的 durable project memory 地圖、Spec-Driven Development（SDD）的相關 living specifications 與 Architecture Decision Records（ADR），再限量搜尋 open／closed Issues、comments 與 linked PR；記錄既有決策是沿用、取代或駁回。" },
    { title: "2｜分支與實作", detail: "{% if branch_strategy == 'delivery' %}main 是唯一永久 branch；Milestone 工作進短命 dev/m<編號>-<簡稱>，一般孤立工作、hotfix 與 bot 更新從短分支直接進 main。ordinary PR 不追逐 main movement；各 Milestone 到 final promotion 才做一次 reviewed sync，明列 dependency 的 owner 才可提前同步{% else %}從 {{ branch_strategy }} 或最終回到它的 open PR 分支建立{% endif %} type/<Issue 編號>-簡稱；若超出原單就另開 Issue。確認 duplicate 時連結 canonical Issue 並用原生 Duplicate 原因關閉，純 triage 不需 PR。" },
    { title: "3｜驗證", detail: "Issue owner 跑 change-aware scoped checks，fast 排除 large 但不跳過具 owner、Issue、期限與移除條件的 quarantine{% if has_container %}，另 build、smoke-test 並掃描產品容器{% endif %}；cross-runtime 只重跑 runtime，final Ready candidate 只跑一次 hosted ./scripts/verify，fallback 才改由 integrator 本機執行；完整契約見 docs/ci-policy.md。" },
    { title: "4｜審查", detail: "非 draft PR 會從導入時設定的 reviewers 排除作者後輪派一位；使用 closing keyword 前，自身與 referenced Issue 不得留有未勾選 task，再依 Conventional Commit title 恰選一個類型標籤。" },
    { title: "5｜交付", detail: "{% if branch_strategy == 'delivery' %}Milestone 完成才形成 promotion release 邊界；standalone 與 bot 直接進 main，全部 no-release 就略過，hotfix 才立即發布；{% endif %}成品 workflow 只接受 release-source evidence，再建立可追溯成品、SHA-256 與非空 SBOM；部署依專案另訂。" }
  ],
  safeguards: [
{% if language != "ci" %}
    "Coverage 是未測程式碼的訊號，不等於品質；新案看全域、既有案先看 changed lines，門檻依缺陷與模組風險調整。",
{% endif %}
    "Dependabot 對 main 提出更新；一般版本等待三天，安全更新不等待，每個更新預設獨立，只有明列且通過安全審查的 allowlist 才能分組。pnpm 另拒絕 publisher trust 降級，OSV 在相依變更、promotion 與每週排程掃描已知漏洞。",
    "lockfile 保存下載內容雜湊；第三方 Actions 固定完整 commit SHA。",
    "PR 政策包含合法／不合法回歸測資，避免門禁只會顯示綠燈。",
{% if language in ["python", "python-typescript"] %}
    "Python CI 會驗證所宣告的精確 .0 下界，以及支援範圍內每個 feature release 的最新 patch；目前支援範圍從 3.12 起。",
{% endif %}
    "token 與私鑰放 GitHub Secrets／Variables，不提交到 repo 或 .env。",
    "導入 preflight 會把 Renovate 標成 available、request-owner 或 fallback；只有 account／organization owner 可進入 GitHub 同意頁並只選本 repo，其餘狀況保留 Dependabot 與既有 CI/CD。",
    "設定腳本的 check 會比對 CODEOWNERS、repository、Actions、政策標籤與有效 Ruleset；Free private 或 GITHUB_TOKEN 看不到管理欄位時以 DEGRADED 記錄，完整檢查應由管理員在可信任 checkout 使用 Administration read 憑證。",
    "review request 使用短效 GITHUB_TOKEN、排除 PR 作者且只 checkout base branch；Free private 只能要求一位個別 reviewer，team request 與強制核准需 GitHub Team 以上。",
    "Artifact attestation 在 public repo 預設開啟；若也啟用 PyPI／npm 發布，registry job 會先驗 repository、tag、digest 與 signer workflow，private／internal repo 維持明確 opt-in。",
{% if has_container %}
    "容器模式 {{ container_mode }} 使用產品既有的 {{ containerfile_path }}；PR job 沒有 registry write，runtime 部署、健康檢查與回復仍由產品定義。",
{% endif %}
  ],
  release: {
    current: {% if (container_mode | default("none")) == "ghcr" %}"已驗證的 release-source 才能發布 GHCR；workflow 保存已 smoke／scan 的 image bytes，附加 provenance 與 SPDX SBOM，再以 digest 重跑 smoke test。這不是 runtime 部署。"{% elif language == "ci" %}"已驗證的 release-source 會建立 GitHub Release、來源封存檔與 exact-tag SPDX SBOM；沒有語言套件，但仍保存可驗證的來源清冊。任意 tag push 不會啟動發布。"{% else %}"已驗證的 release-source 才能 dispatch 成品 workflow；checksum、exact-tag SPDX SBOM 與來源 metadata 會附加到 GitHub Release，不重跑完整 runtime CI。沒有通用部署流程。"{% endif %},
    optional: {% if (container_mode | default("none")) == "verify" %}"容器只做 CI build／smoke／scan，不發布 registry；portable baseline 不要求長效 token。"{% elif (container_mode | default("none")) == "ghcr" %}"只有 GHCR 發布 job 取得 packages、id-token 與 attestations write；PR CI 維持唯讀且不 push。"{% elif language == "ci" %}"CI/CD-only 沒有語言套件或 registry 發布；portable baseline 不要求導入者建立長效 token 或修改組織政策。"{% elif language == "python" %}"Artifact attestation 與 PyPI OIDC 發布都是選配；本 profile 不會產生 npm 套件，portable baseline 不要求長效 token 或組織政策變更。"{% elif language == "typescript" %}"Artifact attestation 與 npm OIDC 發布都是選配；本 profile 不會產生 PyPI 套件，portable baseline 不要求長效 token 或組織政策變更。"{% else %}"Artifact attestation、PyPI 與 npm OIDC 發布各自選配；portable baseline 不要求導入者建立長效 token 或修改組織政策。"{% endif %},
    update: "Copier 從 {{ branch_strategy }} 的工作分支套用已審查的完整 commit SHA，再執行 ./scripts/verify。"
  }
};

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

set +e
check_output="$(./.csarc/scripts/apply-repository-settings.sh check 2>&1)"
check_exit=$?
set -e

if [[ "$check_exit" -eq 0 ]]; then
  printf '%s\n' "$check_output"
  if grep -q '^DEGRADED ' <<<"$check_output"; then
    echo "Repository settings have degraded capability differences; the concrete differences above remain recorded in this workflow run."
  else
    echo "No repository settings drift detected."
  fi
  exit 0
fi

printf '%s\n' "$check_output" >&2

title="Repository governance drift detected"
repo="${GITHUB_REPOSITORY:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"

normalize_tracking_issue() {
  local number="$1"
  if gh issue edit "$number" --repo "$repo" --type Bug >/dev/null 2>&1; then
    gh issue edit "$number" --repo "$repo" --remove-label bug >/dev/null
    echo "Normalized governance drift tracking Issue #$number to native Type Bug."
  else
    gh issue edit "$number" --repo "$repo" --add-label bug >/dev/null
    echo "::notice::Native Issue Types are unavailable; the bug label remains authoritative for Issue #$number."
  fi
}

body_file="$(mktemp)"
trap 'rm -f "$body_file"' EXIT
cat > "$body_file" <<EOF
### 問題

排程執行的 \`apply-repository-settings.sh check\` 偵測到目前 repository 設定（分支保護、必要檢查、CODEOWNER 審查等）仍偏離 \`.csarc/policies/\` 定義的政策。可能是設定遭變更、帳號方案改變，或檢查所需權限發生變化。此通知不會自動修改 repository；兩次排程之間曾變更又恢復的事件需由 GitHub audit log 或組織層事件監控追溯。

本次執行擷取的具體差異：

\`\`\`text
$check_output
\`\`\`

### 完成條件

- [ ] 確認差異是預期的維護操作，還是未經授權的變更
- [ ] 執行 \`./.csarc/scripts/apply-repository-settings.sh plan\` 確認待套用項目
- [ ] 執行 \`./.csarc/scripts/apply-repository-settings.sh apply\` 或於 GitHub UI 手動修正
- [ ] 重新執行 \`./.csarc/scripts/apply-repository-settings.sh check\` 確認已恢復並手動關閉本 Issue

### 補充

此 Issue 由排程 workflow（\`.github/workflows/governance-drift.yml\`）自動開立或更新。
EOF

issue_number="$(
  gh issue list --repo "$repo" --state open --limit 100 --json number,title \
    --jq '.[] | select(.title == "Repository governance drift detected") | .number' |
    head -n 1
)"
if [[ -n "$issue_number" ]]; then
  existing_body="$(gh issue view "$issue_number" --repo "$repo" --json body --jq .body)"
  if [[ "$existing_body" == "$(<"$body_file")" ]]; then
    echo "Governance drift is unchanged; tracking Issue #$issue_number was not updated."
  else
    gh issue edit "$issue_number" --repo "$repo" --body-file "$body_file" >/dev/null
    echo "Updated governance drift tracking Issue #$issue_number."
  fi
else
  create_args=(--repo "$repo" --title "$title" --label bug --body-file "$body_file")
  if [[ "${GITHUB_ACTIONS:-}" != "true" ]]; then
    create_args+=(--assignee @me)
  fi
  issue_url="$(gh issue create "${create_args[@]}")"
  issue_number="${issue_url##*/}"
  [[ "$issue_number" =~ ^[0-9]+$ ]] || {
    echo "check-governance-drift: created Issue number could not be determined" >&2
    exit 1
  }
  echo "Opened a governance drift tracking Issue."
fi
normalize_tracking_issue "$issue_number"

exit "$check_exit"

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
candidate_json="${1:?Usage: verify-release-candidate PR_JSON_FILE}"
status_url="${STATUS_URL:-$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID}"
publish_candidate_status="${CSARC_PUBLISH_CANDIDATE_STATUS:-true}"

pr_number="$(jq -r '.number' "$candidate_json")"
candidate_sha="$(jq -r '.sha' "$candidate_json")"
head_ref="$(jq -r '.headBranchName' "$candidate_json")"
base_ref="$(jq -r '.baseBranchName' "$candidate_json")"
expected_base_sha="$(jq -r '.baseSha // empty' "$candidate_json")"
[[ "$pr_number" =~ ^[0-9]+$ && "$candidate_sha" =~ ^[0-9a-f]{40}$ ]]
test "$base_ref" = main
[[ -z "$expected_base_sha" || "$expected_base_sha" =~ ^[0-9a-f]{40}$ ]]

publish_status() {
  if [[ "$publish_candidate_status" != true ]]; then
    return
  fi
  gh api --method POST \
    "repos/$GITHUB_REPOSITORY/statuses/$candidate_sha" \
    -f state="$1" -f context='Release / candidate' \
    -f description="$2" -f target_url="$status_url" >/dev/null
}

publish_status pending 'Validating the generated version commit'
status_file="$(mktemp "$RUNNER_TEMP/release-candidate-status.XXXXXX")"
status_description="candidate ${candidate_sha:0:12}: failure"
status=failure
if (
  set -euo pipefail
  pr="$(gh api "repos/$GITHUB_REPOSITORY/pulls/$pr_number")"
  base_sha="$(jq -r '.base.sha' <<<"$pr")"
  [[ "$base_sha" =~ ^[0-9a-f]{40}$ ]]
  if [[ -n "$expected_base_sha" && "$base_sha" != "$expected_base_sha" ]]; then
    echo "Release candidate $candidate_sha expected current base $expected_base_sha but observed $base_sha for target $base_ref." >&2
    exit 1
  fi
  echo "Release candidate boundary: candidate=$candidate_sha current_base=$base_sha target=$base_ref"
  actor="$(jq -r '.user.login' <<<"$pr")"
  actor_permission=''
  if [[ "$actor" != 'github-actions[bot]' ]]; then
    actor_permission="$(gh api \
      "repos/$GITHUB_REPOSITORY/collaborators/$actor/permission" \
      --jq .permission)"
  fi
  files="$RUNNER_TEMP/release-candidate-files"
  commits="$RUNNER_TEMP/release-candidate-commits.json"
  gh api --paginate --slurp \
    "repos/$GITHUB_REPOSITORY/pulls/$pr_number/files?per_page=100" \
    | jq -r '.[][] | .filename, (.previous_filename // empty)' >"$files"
  gh api --paginate --slurp \
    "repos/$GITHUB_REPOSITORY/pulls/$pr_number/commits?per_page=100" \
    >"$commits"
  git -C "$repo_root" fetch --no-tags origin "$base_sha" "$candidate_sha"
  candidate_parent="$(mktemp -d "$RUNNER_TEMP/release-candidate.XXXXXX")"
  candidate_worktree="$candidate_parent/worktree"
  # shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
  cleanup_candidate_worktree() {
    git -C "$repo_root" worktree remove --force "$candidate_worktree" >/dev/null 2>&1 || true
    rmdir "$candidate_parent" >/dev/null 2>&1 || true
  }
  trap cleanup_candidate_worktree EXIT
  git -C "$repo_root" worktree add --detach --force "$candidate_worktree" "$candidate_sha"
  source_sha="$(git -C "$candidate_worktree" merge-base "$candidate_sha" "$base_sha")"
  printf 'candidate %.12s source %.12s base %.12s' \
    "$candidate_sha" "$source_sha" "$base_sha" \
    >"$status_file"

  python3 "$candidate_worktree/.csarc/scripts/release_policy.py" verify-release-follow-up \
    --repo "$GITHUB_REPOSITORY" \
    --head "$head_ref" \
    --head-repo "$(jq -r '.head.repo.full_name' <<<"$pr")" \
    --head-sha "$candidate_sha" \
    --actor "$actor" \
    --actor-permission "$actor_permission" \
    --changed-files "$files" \
    --commits "$commits" \
    --root "$candidate_worktree"

  cd "$candidate_worktree"
  python3 .csarc/scripts/release_policy.py verify-candidate-version \
    --base-sha "$base_sha"
  version="$(jq -r '.["."]' .csarc/release-please-manifest.json)"
  if [[ "$actor" != 'github-actions[bot]' ]]; then
    test "$head_ref" = "release/v$version"
    test "$(jq -r .title <<<"$pr")" = "chore(main): release $version"
  fi
  python3 .csarc/scripts/release_bundle.py candidate \
    --output "$RUNNER_TEMP/release-candidate-assets"
); then
  status=success
fi
if [[ -s "$status_file" ]]; then
  status_description="$(<"$status_file"): $status"
fi
publish_status "$status" "$status_description"
test "$status" = success

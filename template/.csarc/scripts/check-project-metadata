#!/usr/bin/env bash
set -euo pipefail

status=0
documentation_mode="$(python3 .csarc/scripts/csarc_config.py documentation_mode)"
required_files=(.github/SECURITY.md)
if [[ "$documentation_mode" != "off" ]]; then
  required_files+=(README.md)
fi
for required_file in "${required_files[@]}"; do
  if [[ ! -f "$required_file" ]]; then
    echo "ERROR: $required_file is missing: metadata needs it. Run 'csarc update' to add it." >&2
    status=1
  fi
done
if ((status != 0)); then
  exit "$status"
fi

reject_placeholder() {
  local file="$1"
  local field="$2"
  local placeholder="$3"
  if grep -Fq -- "$placeholder" "$file"; then
    echo "ERROR: $file has unfinished $field: '$placeholder'. Replace it with real text." >&2
    status=1
  fi
}

reject_controlled_placeholder() {
  local file="$1"
  local field="$2"
  local start="<!-- csarc-$3:start -->"
  local end="<!-- csarc-$3:end -->"
  if awk -v start="$start" -v end="$end" '
    { sub(/\r$/, "") }
    $0 == start { controlled = 1; next }
    $0 == end { controlled = 0; next }
    controlled {
      value = tolower($0)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value == "todo" || value == "tbd" || value == "placeholder") {
        found = 1
      }
    }
    END { exit !found }
  ' "$file"; then
    echo "ERROR: $file has unfinished $field: a placeholder. Replace it with real text." >&2
    status=1
  fi
}

if [[ -f README.md ]]; then
  reject_placeholder README.md "project description" "A Cyber-Arch project"
  reject_placeholder README.md "project description" "請在這裡補上主要使用者"
  reject_placeholder README.md "run command" "請在這裡補上產品最短"
  reject_placeholder README.md "repository URL" "<repository-url>"
  reject_placeholder README.md "CI badge" "<org>/<repo>"
  reject_controlled_placeholder README.md "project description" \
    "project-description"
  reject_controlled_placeholder README.md "run command" "project-run-command"
fi
reject_placeholder .github/SECURITY.md "security reporting channel" \
  "Project owner: replace"
reject_controlled_placeholder .github/SECURITY.md "security reporting channel" \
  "security-reporting-channel"
if [[ -f pyproject.toml ]]; then
  reject_placeholder pyproject.toml "repository URL" "<repository-url>"
fi
if [[ -f package.json ]]; then
  reject_placeholder package.json "repository URL" "<repository-url>"
fi

python3 .csarc/scripts/check_license_metadata.py

exit "$status"

#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "--check" ]]; }; then
  printf 'Usage: .csarc/scripts/build-repo-site [--check]\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Issue #681 decision N: this repo-site engine replaces the retired
# docs/site-content.md handbook renderer. A repository generated before
# this change keeps that file (project-owned, never silently deleted), but
# it is no longer read by anything -- port anything worth keeping into
# docs/site/content/_index.zh-tw.md / _index.en.md (see .csarc/site/README.md), then
# remove docs/site-content.md once its content has a new home.
if [[ -f "$repo_root/docs/site-content.md" ]]; then
  printf 'Notice: docs/site-content.md is no longer used by the repo-site build.\n' >&2
  printf '  Port anything worth keeping into docs/site/content/_index.zh-tw.md / _index.en.md,\n' >&2
  printf '  then remove docs/site-content.md.\n' >&2
fi

python3 "$repo_root/.csarc/scripts/check-repo-site-navigation"
python3 "$repo_root/.csarc/scripts/check-repo-site-versions"

primary_language="$(python3 "$repo_root/.csarc/scripts/csarc_config.py" primary_language)"
i18n="$(python3 "$repo_root/.csarc/scripts/csarc_config.py" i18n)"
site_languages=("$primary_language")
if [[ "$i18n" == "en-zh-tw" ]]; then
  python3 "$repo_root/.csarc/scripts/check-repo-site-translations"
  if [[ "$primary_language" == "zh-tw" ]]; then
    site_languages+=(en)
  else
    site_languages+=(zh-tw)
  fi
fi
language_csv="$(IFS=,; echo "${site_languages[*]}")"

build_dir="$repo_root/dist/repo-site"
python3 "$repo_root/.csarc/scripts/build_repo_site.py" \
  --root "$repo_root" \
  --output-dir "$build_dir" \
  --theme-href docs/site/theme.css \
  --languages "$language_csv" \
  --primary-language "$primary_language"

sources=()
outputs=()
for language in "${site_languages[@]}"; do
  if [[ "$language" == "$primary_language" ]]; then
    name="index.html"
  else
    name="index.${language}.html"
  fi
  sources+=("$build_dir/$name")
  outputs+=("docs/$name")
done

for index in "${!sources[@]}"; do
  render_args=(
    --root "$repo_root"
    --source "${sources[$index]}"
    --output "${outputs[$index]}"
  )
  if (($# == 1)); then
    render_args+=(--check)
  fi
  python3 "$repo_root/.csarc/scripts/render_site.py" "${render_args[@]}"
done

for alternative in docs/index.en.html docs/index.zh-tw.html; do
  keep=false
  for output in "${outputs[@]}"; do
    if [[ "$alternative" == "$output" ]]; then
      keep=true
      break
    fi
  done
  if [[ "$keep" == "false" && -f "$repo_root/$alternative" ]]; then
    if (($# == 1)); then
      printf '%s is stale for the selected i18n mode; rebuild the repo site.\n' \
        "$alternative" >&2
      exit 1
    fi
    rm -f -- "$repo_root/$alternative"
  fi
done

printf 'Repo site:'
for output in "${outputs[@]}"; do
  printf ' %s' "$repo_root/$output"
done
printf '\n'

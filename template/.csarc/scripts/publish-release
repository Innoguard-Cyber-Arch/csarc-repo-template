#!/usr/bin/env bash
set -euo pipefail

# Single implementation of the publish stage of the release path (Issue
# #589): everything from validating a merged version candidate through
# publishing the GitHub Release, verifying an already-published rerun, and
# keeping a failed mutable release in draft. Extracted from
# .github/workflows/release.yml so release.yml and a human or agent running
# the release locally (the "Actions is unhealthy" backup path; see
# .csarc/docs/ci-policy.md's "Release 發版不依賴 Actions 健康度的 fallback" section
# and the release-security-and-dependencies ADR) call the exact same script
# instead of maintaining two copies of this logic. Local execution never
# skips the review a promotion or standalone version pull request already
# requires; it only changes who runs the publish step after merge.
#
# .csarc/scripts/release_policy.py plan/detect and prepare-candidate stay separate
# (they decide *whether* and *how* to propose a version, not how to publish
# one already merged to main) and are not duplicated here.
#
# Issue #770: `publish` and `rerun-verify` cross-check GitHub's own signed
# release attestation (`gh release verify --format json`) against every
# uploaded asset via .csarc/scripts/verify_release_consumption.py's
# verify_consumption() (imported, not reimplemented) -- signer, repository,
# repositoryId, tag, commit, and each asset's SHA-256 digest. This replaces
# the pre-flight `immutable_releases` admin-scope probe .csarc/scripts/release_policy.py
# used to run (structurally unprovable by GITHUB_TOKEN; see #123/#626) with a
# post-hoc, provable check: GitHub only signs this attestation when Immutable
# Releases was actually enabled, and any repository can read it, no admin
# scope required. A failure here is treated exactly like any other `publish`
# failure -- the existing revert_to_draft_on_failure trap keeps the Release
# in draft rather than leaving a falsely-trusted mutable Release public.
#
# Usage:
#   .csarc/scripts/publish-release stage --repo OWNER/NAME --sha SHA --tag TAG
#     Validate the merged version pull request at SHA and converge the tag
#     and draft Release for TAG (idempotent; safe to rerun).
#
#   .csarc/scripts/publish-release resolve --repo OWNER/NAME --sha SHA \
#       [--tag TAG] [--created true|false]
#     Resolve the exact release state for SHA: none, draft, or published.
#     Always safe to run, including on ordinary pushes with no release
#     activity. Pass --tag when a prior `stage` (or, in Actions, the
#     Automatic release-please-action run) already knows the tag; omit it to
#     fall back to searching Git tags that point at SHA.
#
#   .csarc/scripts/publish-release publish --repo OWNER/NAME --tag TAG
#     Given TAG is in state=draft (confirmed by `resolve` first): build
#     release artifacts, generate the SPDX SBOM if one is not already
#     staged, finalize and verify the bundle, upload it, mark the Release
#     published, and wait for it to become immutable and verifiable. Reverts
#     the Release back to draft on any failure so a partially published
#     mutable Release is never left half-public.
#
#   .csarc/scripts/publish-release rerun-verify --repo OWNER/NAME --tag TAG
#     Given TAG is in state=published (a rerun of an already-successful
#     release, or a duplicate/resent event): download and verify the bundle
#     and confirm the Release is immutable and verifiable. Never rebuilds or
#     overwrites an already-published Release.
#
# GH_TOKEN/GITHUB_TOKEN must already authenticate `gh` (the short-lived
# Actions token in a workflow, or a maintainer's own long-lived `gh auth
# login` session locally). GITHUB_SERVER_URL, GITHUB_RUN_ID, and RUNNER_TEMP
# default to sane local values when unset so this script runs the same way
# outside Actions.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

usage() {
  cat >&2 <<'EOF'
Usage:
  .csarc/scripts/publish-release stage   --repo OWNER/NAME --sha SHA --tag TAG
  .csarc/scripts/publish-release resolve --repo OWNER/NAME --sha SHA [--tag TAG] [--created true|false]
  .csarc/scripts/publish-release publish --repo OWNER/NAME --tag TAG
  .csarc/scripts/publish-release rerun-verify --repo OWNER/NAME --tag TAG
EOF
  exit 2
}

command="${1:-}"
[[ -n "$command" ]] || usage
shift

repo=""
sha=""
tag=""
created="false"
output=""
while (($#)); do
  case "$1" in
    --repo)
      repo="$2"
      shift 2
      ;;
    --sha)
      sha="$2"
      shift 2
      ;;
    --tag)
      tag="$2"
      shift 2
      ;;
    --created)
      created="$2"
      shift 2
      ;;
    --output)
      output="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
[[ -n "$repo" ]] || usage

# Local defaults for the GitHub Actions environment variables the reused
# .csarc/scripts/verify-release-candidate and .csarc/scripts/release_bundle.py already
# expect. A workflow run leaves these already set to their real values; a
# local run gets a working, clearly-labeled substitute instead of an unbound
# variable error under `set -u`.
export GITHUB_REPOSITORY="$repo"
export GITHUB_SERVER_URL="${GITHUB_SERVER_URL:-https://github.com}"
export GITHUB_RUN_ID="${GITHUB_RUN_ID:-local}"
export RUNNER_TEMP="${RUNNER_TEMP:-$(mktemp -d)}"
mkdir -p "$RUNNER_TEMP"

write_output() {
  # Mirror a GitHub Actions `key=value` output line when $GITHUB_OUTPUT is
  # set (in a workflow); a local run just prints it.
  if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf '%s\n' "$1" >>"$GITHUB_OUTPUT"
  fi
  printf '%s\n' "$1"
}

poll_immutable_and_verify() {
  # Bounded retry for GitHub's eventual-consistency window between a
  # Release edit and `isImmutable`/`gh release verify` reflecting it. Shared
  # by `publish` (right after the Release is made non-draft) and
  # `rerun-verify` (re-checking a Release that should already be immutable).
  # Once GitHub confirms the Release is immutable and cryptographically
  # verifiable, also cross-check every uploaded asset against the same
  # signed attestation (Issue #770) via verify_release_attestation below,
  # reusing the one `--format json` response instead of calling `gh release
  # verify` a second time.
  local release_tag="$1"
  local assets_dir="$2"
  local verification_json="$RUNNER_TEMP/release-verification-$release_tag.json"
  local attempt
  for attempt in $(seq 1 12); do
    local immutable
    immutable="$(gh release view "$release_tag" --json isImmutable --jq .isImmutable || true)"
    if [[ "$immutable" == true ]] &&
      gh release verify "$release_tag" --repo "$GITHUB_REPOSITORY" --format json \
        >"$verification_json"; then
      verify_release_attestation "$release_tag" "$assets_dir" "$verification_json"
      return
    fi
    if [[ "$attempt" == 12 ]]; then
      echo "Release did not become immutable and verifiable within 60 seconds." >&2
      return 1
    fi
    sleep 5
  done
}

verify_release_attestation() {
  # Issue #770: prove Immutable Releases was actually enabled for this
  # Release by cross-checking GitHub's own signed release attestation
  # against every uploaded asset, instead of trusting the pre-flight
  # `immutable_releases` admin-scope probe .csarc/scripts/release_policy.py used to
  # run (structurally unprovable by GITHUB_TOKEN; see #123/#626). The
  # `--format json` response the caller already captured from `gh release
  # verify` is exactly the --verification-json shape
  # .csarc/scripts/verify_release_consumption.py expects, so this reuses its
  # verify_consumption() policy (signer, repository, repositoryId, tag,
  # commit, and each asset's own SHA-256 digest) rather than re-implementing
  # the same cryptographic and identity checks a second time. Any failure --
  # a wrong signer, or a digest mismatch on any asset -- exits non-zero
  # under this script's `set -e`, which callers rely on to fail closed.
  local release_tag="$1"
  local assets_dir="$2"
  local verification_json="$3"
  local repository_id
  repository_id="$(gh api "repos/$GITHUB_REPOSITORY" --jq .id)"
  local commit_sha
  commit_sha="$(git -C "$repo_root" rev-parse "${release_tag}^{commit}")"
  local asset
  local found=0
  for asset in "$assets_dir"/*; do
    [[ -f "$asset" ]] || continue
    found=1
    python3 "$repo_root/.csarc/scripts/verify_release_consumption.py" \
      --verification-json "$verification_json" \
      --artifact "$asset" \
      --repository "$GITHUB_REPOSITORY" \
      --repository-id "$repository_id" \
      --tag "$release_tag" \
      --commit "$commit_sha"
  done
  if [[ "$found" != 1 ]]; then
    echo "No uploaded release assets were found to verify against the attestation." >&2
    return 1
  fi
}

complete_published_milestone() {
  # The publisher is shared by hosted and local release execution, so the
  # post-publication Milestone transition belongs here too. The synchronizer
  # is a no-op when TAG does not point at a Milestone promotion commit.
  local release_tag="$1"
  local commit_sha
  commit_sha="$(git -C "$repo_root" rev-parse "${release_tag}^{commit}")"
  python3 "$repo_root/.csarc/scripts/sync_milestone_state.py" complete-release \
    --repo "$GITHUB_REPOSITORY" \
    --main-sha "$commit_sha" \
    --evidence-url "$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/releases/tag/$release_tag" \
    --outcome published
}

cmd_stage() {
  [[ -n "$sha" && -n "$tag" ]] || usage
  local status_url="${STATUS_URL:-$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/commit/$sha}"
  export STATUS_URL="$status_url"

  local numbers
  mapfile -t numbers < <(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$GITHUB_REPOSITORY/commits/$sha/pulls" \
    --jq ".[] | select(.merged_at != null and .base.ref == \"main\" and .merge_commit_sha == \"$sha\") | .number")
  test "${#numbers[@]}" -eq 1
  local pr
  pr="$(gh api "repos/$GITHUB_REPOSITORY/pulls/${numbers[0]}")"
  test "$(jq -r .merge_commit_sha <<<"$pr")" = "$sha"
  jq -n --argjson pr "$pr" '{
    number: $pr.number,
    sha: $pr.head.sha,
    headBranchName: $pr.head.ref,
    baseBranchName: $pr.base.ref
  }' >"$RUNNER_TEMP/release-pr.json"
  local head_ref
  local candidate_sha
  head_ref="$(jq -r .head.ref <<<"$pr")"
  candidate_sha="$(jq -r .head.sha <<<"$pr")"
  if [[ "$head_ref" == promote/m* ]]; then
    git -C "$repo_root" fetch --no-tags origin "$candidate_sha"
    local source_sha
    source_sha="$(git -C "$repo_root" rev-parse "$candidate_sha^1")"
    python3 "$repo_root/.csarc/scripts/release_policy.py" \
      verify-promotion-version \
      --root "$repo_root" \
      --source-sha "$source_sha" \
      --head-sha "$candidate_sha" \
      --tag "$tag"
    test "$(git -C "$repo_root" rev-parse "$candidate_sha^{tree}")" = \
      "$(git -C "$repo_root" rev-parse "$sha^{tree}")"
  else
    "$repo_root/.csarc/scripts/verify-release-candidate" "$RUNNER_TEMP/release-pr.json"
  fi
  git -C "$repo_root" checkout --detach "$sha"
  "$repo_root/.csarc/scripts/converge-release-tag" --repo "$GITHUB_REPOSITORY" --sha "$sha" --tag "$tag"
  write_output "tag=$tag"
}

cmd_resolve() {
  [[ -n "$sha" ]] || usage
  git -C "$repo_root" fetch --force --tags origin
  local tag="$tag"
  if [[ -z "$tag" ]]; then
    local tags
    # Issue #744: a `-alpha.N`/`-beta.N` suffix is a legal release-phase
    # version too, not only a plain X.Y.Z tag. This pattern's suffix must
    # stay byte-identical to cmd_publish's below, to
    # .csarc/scripts/converge-release-tag's, and to .csarc/scripts/release_phase.py's
    # canonical `_VERSION_RE` (`N` never 0 or zero-padded); see
    # tests/test_release_phase.py::test_prerelease_suffix_regex_is_consistent_everywhere.
    mapfile -t tags < <(git -C "$repo_root" tag --points-at "$sha" |
      grep -E '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(alpha|beta)\.[1-9][0-9]*)?$' || true)
    [[ "${#tags[@]}" -le 1 ]]
    tag="${tags[0]:-}"
  fi
  local state=none
  if [[ -n "$tag" ]]; then
    test "$(git -C "$repo_root" rev-parse "$tag^{commit}")" = "$sha"
    local release
    release="$(gh release view "$tag" --json isDraft,isImmutable,tagName)"
    test "$(jq -r .tagName <<<"$release")" = "$tag"
    if [[ "$(jq -r .isDraft <<<"$release")" == true ]]; then
      state=draft
    else
      state=published
    fi
  fi
  if [[ "$created" == true ]]; then
    test "$state" = draft
  fi
  write_output "state=$state"
  write_output "tag=$tag"
}

cmd_publish() {
  [[ -n "$tag" ]] || usage
  local assets="${output:-$RUNNER_TEMP/release-assets}"
  revert_to_draft_on_failure() {
    local exit_code=$?
    if [[ "$exit_code" -ne 0 ]]; then
      if [[ "$(gh release view "$tag" --json isImmutable --jq .isImmutable 2>/dev/null)" == false ]]; then
        gh release edit "$tag" --draft || true
      fi
    fi
    return "$exit_code"
  }
  trap revert_to_draft_on_failure EXIT

  # A hosted run already staged artifacts via its own "Prepare release
  # assets" step (a one-line call to release_bundle.py, so nothing to
  # extract or duplicate there); only build them here when nobody has yet
  # -- e.g. a local, one-shot `publish` with no preceding steps. Never call
  # `release_bundle.py prepare` when $assets is already populated: it wipes
  # its output directory first, which would destroy an already-staged SBOM.
  if [[ ! -d "$assets" ]] || [[ -z "$(find "$assets" -mindepth 1 -maxdepth 1 2>/dev/null)" ]]; then
    python3 "$repo_root/.csarc/scripts/release_bundle.py" prepare --tag "$tag" --output "$assets"
  fi
  if [[ ! -f "$assets/sbom.spdx.json" ]]; then
    # No preceding step (e.g. a hosted anchore/sbom-action step) already
    # staged an SBOM, so generate the same pinned Syft SPDX document
    # directly -- the local-execution equivalent documented in
    # .csarc/docs/ci-policy.md and the release-security-and-dependencies ADR.
    local syft_bin
    syft_bin="$("$repo_root/.csarc/scripts/install-syft")"
    "$syft_bin" scan "dir:$repo_root" \
      --source-name "$GITHUB_REPOSITORY" --source-version "$tag" \
      -o "spdx-json=$assets/sbom.spdx.json"
  fi
  python3 "$repo_root/.csarc/scripts/release_bundle.py" finalize --tag "$tag" --output "$assets"
  python3 "$repo_root/.csarc/scripts/release_bundle.py" verify --tag "$tag" --output "$assets"
  # gh release upload's own --clobber already deletes and re-uploads any
  # existing same-named asset -- a separate list-then-DELETE pass here was
  # redundant, and both the list (GET .../releases/tags/{tag}) and delete
  # (DELETE .../releases/assets/{id}) REST endpoints are unreliable for a
  # draft release's assets regardless of which query method finds them.
  gh release upload "$tag" "$assets"/* --clobber
  local downloaded
  downloaded="$(mktemp -d "$RUNNER_TEMP/release-download.XXXXXX")"
  gh release download "$tag" --dir "$downloaded"
  python3 "$repo_root/.csarc/scripts/release_bundle.py" verify --tag "$tag" --output "$downloaded"
  # Issue #744: only a stable (unsuffixed) tag should become GitHub's latest
  # release. Keep this suffix identical to cmd_resolve's pattern above.
  local latest_flags=(--latest)
  if [[ "$tag" =~ -(alpha|beta)\.[1-9][0-9]*$ ]]; then
    latest_flags=()
  fi
  gh release edit "$tag" --draft=false "${latest_flags[@]}"
  poll_immutable_and_verify "$tag" "$downloaded"
  complete_published_milestone "$tag"
}

cmd_rerun_verify() {
  [[ -n "$tag" ]] || usage
  local downloaded
  downloaded="$(mktemp -d "$RUNNER_TEMP/release-download.XXXXXX")"
  gh release download "$tag" --dir "$downloaded"
  python3 "$repo_root/.csarc/scripts/release_bundle.py" verify --tag "$tag" --output "$downloaded"
  poll_immutable_and_verify "$tag" "$downloaded"
  complete_published_milestone "$tag"
}

case "$command" in
  stage) cmd_stage ;;
  resolve) cmd_resolve ;;
  publish) cmd_publish ;;
  rerun-verify) cmd_rerun_verify ;;
  *) usage ;;
esac

#!/usr/bin/env bash

# Shared step-level progress output for local verification entry points.
# Source this file, then call verification_step "Label" command args...

# Issue #1086: hosted CI stages the entry points from the trusted pull
# request base and points them at the exact candidate tree. The control root
# is where the entry point itself lives; the subject root is the tree whose
# checks run. Without CSARC_VERIFICATION_SUBJECT_ROOT both are the same.
verification_subject_root() {
  local control_root=$1
  local subject="${CSARC_VERIFICATION_SUBJECT_ROOT:-$control_root}"

  if [[ "$subject" != /* || ! -d "$subject" ]]; then
    printf "ERROR: 'CSARC_VERIFICATION_SUBJECT_ROOT' is invalid: it must be an existing absolute directory, not '%s'. Set it to such a directory.\n" \
      "$subject" >&2
    return 2
  fi
  (cd "$subject" && pwd)
}

# Issue #1318: return the checkout whose check scripts and settings run.
# A full trusted checkout that checks another tree, such as the base
# verifier of a self-hosted exit, uses its own copies. The subject itself,
# or a staged CI control set that carries only the entry points (marked by
# trusted-executor.json), keeps using the subject's copies.
verification_check_root() {
  local control_root=$1
  local subject_root=$2

  if [[ "$control_root" != "$subject_root" &&
    ! -f "$control_root/trusted-executor.json" ]]; then
    printf '%s\n' "$control_root"
  else
    printf '%s\n' "$subject_root"
  fi
}

verification_command_string() {
  local argument
  local rendered=""

  for argument in "$@"; do
    printf -v rendered '%s %q' "$rendered" "$argument"
  done
  printf '%s' "${rendered# }"
}

verification_step() {
  local label=$1
  shift
  local heartbeat_seconds="${CSARC_VERIFICATION_HEARTBEAT_SECONDS:-60}"
  local started=$SECONDS
  local heartbeat_pid
  local status
  local command

  if [[ ! "$heartbeat_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: Bad heartbeat: not a positive integer. Fix CSARC_VERIFICATION_HEARTBEAT_SECONDS." >&2
    return 2
  fi

  command="$(verification_command_string "$@")"
  printf '[verify-step] START %s; log=stdout\n' "$label"
  printf '[verify-step] COMMAND %s\n' "$command"

  (
    local last_heartbeat=$started
    while sleep 1; do
      if ((SECONDS - last_heartbeat >= heartbeat_seconds)); then
        printf '[verify-step] HEARTBEAT %s (%ss); log=stdout\n' \
          "$label" "$((SECONDS - started))"
        last_heartbeat=$SECONDS
      fi
    done
  ) &
  heartbeat_pid=$!

  if "$@"; then
    status=0
  else
    status=$?
  fi

  # Stop the heartbeat with SIGKILL, not SIGTERM (#1014). The forked
  # subshell briefly inherits the caller's EXIT trap before bash resets it,
  # and bash 5.2 runs that trap when a SIGTERM lands inside that window. A
  # fast step such as `test -f` hits the window, so the caller's cleanup
  # (for example `rm -rf` of a build directory) could delete an artifact the
  # next step needs. SIGKILL cannot be caught, so no inherited trap can run.
  kill -KILL "$heartbeat_pid" 2>/dev/null || true
  wait "$heartbeat_pid" 2>/dev/null || true

  if [[ "$status" -eq 0 ]]; then
    printf '[verify-step] PASSED %s (%ss)\n' \
      "$label" "$((SECONDS - started))"
    return 0
  fi

  printf '[verify-step] FAILED %s (%ss); status=%s; log=stdout\n' \
    "$label" "$((SECONDS - started))" "$status" >&2
  printf '[verify-step] RERUN %s\n' "$command" >&2
  return "$status"
}

#!/usr/bin/env bash

# Shared step-level progress output for local verification entry points.
# Source this file, then call verification_step "Label" command args...

# Issue #1086: hosted CI stages the entry points from the trusted pull
# request base and points them at the exact candidate tree. The control root
# is where the entry point itself lives; the subject root is the tree whose
# checks run. Without CSARC_VERIFICATION_SUBJECT_ROOT both are the same.
verification_subject_root() {
  local control_root=$1
  local subject="${CSARC_VERIFICATION_SUBJECT_ROOT:-$control_root}"

  if [[ "$subject" != /* || ! -d "$subject" ]]; then
    printf "ERROR: 'CSARC_VERIFICATION_SUBJECT_ROOT' is invalid: it must be an existing absolute directory, not '%s'. Set it to such a directory.\n" \
      "$subject" >&2
    return 2
  fi
  (cd "$subject" && pwd)
}

# Issue #1325: trusted helpers run on the system python3 (hosted CI sets up
# 3.14; the VM image ships at least 3.12). Fail closed on an older one
# instead of failing later inside a check.
verification_require_python() {
  if ! python3 -I -c 'import sys; sys.exit(sys.version_info < (3, 12))' \
    >/dev/null 2>&1; then
    echo "ERROR: Python is too old: trusted checks need python3 3.12 or newer. Put such a python3 first on PATH." >&2
    return 2
  fi
}

# Issue #1340: candidate code (tests, builds, `uv run`) runs between trusted
# steps as the same user, so it can rewrite a staged control file that a
# later step runs, and the manifest too. When a trusted manifest sits at the
# control root, the first script to source this file pins its digests and an
# absolute hasher path in the environment, before any candidate code runs.
# Children of the same control root inherit the pins instead of rereading
# the disk; every step rechecks them and fails closed on any difference.
verification_pin_controls() {
  local root hasher
  root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  root="${root%/scripts}"
  root="${root%/.csarc}"
  [[ "${CSARC_TRUSTED_ROOT:-}" != "$root" ]] || return 0
  unset CSARC_TRUSTED_ROOT CSARC_TRUSTED_PINS CSARC_TRUSTED_HASHER
  [[ -f "$root/trusted-executor.json" ]] || return 0
  hasher="$(command -v sha256sum)" || hasher="$(command -v shasum) -a 256"
  CSARC_TRUSTED_PINS="$(python3 -I -c 'import json, sys
for k, v in json.load(open(sys.argv[1]))["files"].items(): print(v + "  " + k)' \
    "$root/trusted-executor.json")" && [[ -n "$CSARC_TRUSTED_PINS" ]] || {
    echo "ERROR: Bad executor manifest: unreadable. Rerun the 'verify' job." >&2
    return 2
  }
  export CSARC_TRUSTED_ROOT="$root" CSARC_TRUSTED_PINS CSARC_TRUSTED_HASHER="$hasher"
  verification_check_controls
}

verification_check_controls() {
  [[ -n "${CSARC_TRUSTED_ROOT:-}" ]] || return 0
  # shellcheck disable=SC2086 # the hasher may carry `-a 256`
  (cd "$CSARC_TRUSTED_ROOT" &&
    $CSARC_TRUSTED_HASHER --quiet --strict -c - <<<"$CSARC_TRUSTED_PINS") >&2 || {
    echo "ERROR: Control file changed: a FAILED file above. Rerun the 'verify' job." >&2
    return 1
  }
}

verification_command_string() {
  local argument
  local rendered=""

  for argument in "$@"; do
    printf -v rendered '%s %q' "$rendered" "$argument"
  done
  printf '%s' "${rendered# }"
}

verification_step() {
  local label=$1
  shift
  local heartbeat_seconds="${CSARC_VERIFICATION_HEARTBEAT_SECONDS:-60}"
  local started=$SECONDS
  local heartbeat_pid
  local status
  local command

  if [[ ! "$heartbeat_seconds" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: Bad heartbeat: not a positive integer. Fix CSARC_VERIFICATION_HEARTBEAT_SECONDS." >&2
    return 2
  fi

  command="$(verification_command_string "$@")"
  printf '[verify-step] START %s; log=stdout\n' "$label"
  printf '[verify-step] COMMAND %s\n' "$command"
  verification_check_controls || return

  (
    local last_heartbeat=$started
    while sleep 1; do
      if ((SECONDS - last_heartbeat >= heartbeat_seconds)); then
        printf '[verify-step] HEARTBEAT %s (%ss); log=stdout\n' \
          "$label" "$((SECONDS - started))"
        last_heartbeat=$SECONDS
      fi
    done
  ) &
  heartbeat_pid=$!

  if "$@"; then
    status=0
  else
    status=$?
  fi

  # Stop the heartbeat with SIGKILL, not SIGTERM (#1014). The forked
  # subshell briefly inherits the caller's EXIT trap before bash resets it,
  # and bash 5.2 runs that trap when a SIGTERM lands inside that window. A
  # fast step such as `test -f` hits the window, so the caller's cleanup
  # (for example `rm -rf` of a build directory) could delete an artifact the
  # next step needs. SIGKILL cannot be caught, so no inherited trap can run.
  kill -KILL "$heartbeat_pid" 2>/dev/null || true
  wait "$heartbeat_pid" 2>/dev/null || true

  if [[ "$status" -eq 0 ]]; then
    printf '[verify-step] PASSED %s (%ss)\n' \
      "$label" "$((SECONDS - started))"
    return 0
  fi

  printf '[verify-step] FAILED %s (%ss); status=%s; log=stdout\n' \
    "$label" "$((SECONDS - started))" "$status" >&2
  printf '[verify-step] RERUN %s\n' "$command" >&2
  return "$status"
}

verification_pin_controls

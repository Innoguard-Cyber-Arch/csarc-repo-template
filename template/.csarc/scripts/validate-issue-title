#!/usr/bin/env bash
set -euo pipefail

title="${1:-}"
length="${#title}"

invalid() {
  echo "ERROR: Issue title is invalid: $1. Write one like 'Add dependency policy checks'." >&2
  exit 1
}

(( length >= 12 && length <= 80 )) || invalid "length must be 12-80 characters"
printf '%s' "$title" | LC_ALL=C grep -q '[^ -~]' && invalid "it must be English ASCII"
[[ "$title" =~ ^[[:space:]] || "$title" =~ [[:space:]]$ ]] && invalid "it has leading or trailing spaces"
[[ "$title" == *. ]] && invalid "it ends with a period"

summary="$title"
if [[ "$summary" =~ ^\[[^]]+\] ]]; then
  invalid "it has a bracketed type prefix; use labels"
fi

shopt -s nocasematch
if [[ "$summary" =~ ^(bug|feature|enhancement|documentation|docs|task|chore):[[:space:]] ]]; then
  invalid "it has a type prefix; use the Issue label"
fi
shopt -u nocasematch

[[ "$summary" =~ ^[A-Za-z] ]] || invalid "it must start with an English word"
word_count="$(awk '{ print NF }' <<<"$summary")"
(( word_count >= 3 )) || invalid "it needs at least three words"

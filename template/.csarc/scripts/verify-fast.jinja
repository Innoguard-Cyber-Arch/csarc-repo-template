{% set python_target = "3.14" if python_floor == "latest" else python_floor -%}
{% set has_python = "python" in languages -%}
{% set has_typescript = "typescript" in languages -%}
{% set has_rust = "rust" in languages -%}
{% set has_go = "go" in languages -%}
#!/usr/bin/env bash
set -euo pipefail

# control_root holds this entry point, its router, and its stage gate;
# repo_root is the tree under verification. Hosted CI stages the control
# set from the trusted base and points CSARC_VERIFICATION_SUBJECT_ROOT at
# the exact candidate.
control_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$control_root/.csarc/scripts/verification-step"
repo_root="$(verification_subject_root "$control_root")"
# Pass the subject only to control-set children, never to nested fixtures.
unset CSARC_VERIFICATION_SUBJECT_ROOT
cache_root="$("$control_root/.csarc/scripts/resolve-cache-root")"
if [[ -n "${CSARC_CACHE_ROOT:-}" ]]; then
  export UV_CACHE_DIR="$cache_root/uv"
else
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$cache_root/uv}"
fi
cd "$repo_root"

plan_root="$(mktemp -d)"
trap 'rm -rf "$plan_root"' EXIT

branch="$(git symbolic-ref --quiet --short HEAD || true)"
base="${CSARC_CI_BASE:-}"
if [[ -z "$base" && -n "$branch" ]]; then
  base="$(git config --get "branch.$branch.gh-merge-base" || true)"
fi
if [[ -z "$base" ]]; then
  remote_head="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD || true)"
  base="${remote_head#origin/}"
fi
if [[ -z "$base" ]] && git rev-parse --verify --quiet "main^{commit}" >/dev/null; then
  base=main
fi
if [[ -z "$base" ]]; then
  echo "ERROR: PR base is unknown: none is set. Set CSARC_CI_BASE." >&2
  exit 2
fi
base="${base#refs/heads/}"
base="${base#refs/remotes/origin/}"
base="${base#origin/}"

base_ref=""
for candidate in "refs/remotes/origin/$base" "refs/heads/$base" "$base"; do
  if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
    base_ref="$candidate"
    break
  fi
done
if [[ -z "$base_ref" ]]; then
  echo "ERROR: Unknown base: '$base'. Fetch it or set CSARC_CI_BASE." >&2
  exit 2
fi
{% if verification_mode != "hosted" -%}
verification_head_sha="$(git rev-parse HEAD)"
verification_base_sha="$(git rev-parse "$base_ref^{commit}")"
{% endif -%}
if ! merge_base="$(git merge-base "$base_ref" HEAD)"; then
  echo "ERROR: No merge base: '$base_ref' and HEAD. Fetch more history." >&2
  exit 2
fi

changed_files="$plan_root/changed-files"
plan_json="$plan_root/ci-plan.json"
git diff --no-renames --name-only -z "$merge_base" HEAD >"$changed_files"
extra_scopes="${CSARC_CI_SCOPES:-}"
if [[ "${CSARC_RUN_OSV:-false}" == "true" ]]; then
  extra_scopes="${extra_scopes:+$extra_scopes,}dependency"
fi
python3 "$control_root/.csarc/scripts/ci_tier.py" \
  --event pull_request \
  --base "$base" \
  --head "${branch:-HEAD}" \
  --labels "${CSARC_CI_LABELS:-}" \
  --files-from "$changed_files" \
  --output-json "$plan_json" \
  --draft "${CSARC_CI_DRAFT:-false}" \
  --extra-scopes "$extra_scopes"

plan_tier="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["tier"])' "$plan_json")"
scope_csv="$(python3 -c 'import json, sys; print(",".join(json.load(open(sys.argv[1]))["scopes"]))' "$plan_json")"
{% if has_python or has_typescript or has_rust or has_go -%}
run_project="$(python3 -c 'import json, sys; print(str(json.load(open(sys.argv[1]))["run_project"]).lower())' "$plan_json")"
{% endif -%}
scopes=",$scope_csv,"

normalize_suite() {
  case "$1" in
    baseline|docs|fast) echo fast ;;
    full) echo full ;;
    *) return 1 ;;
  esac
}

suite="$plan_tier"
for requested in "${CSARC_VERIFICATION_SUITE:-fast}" "${CSARC_CI_TIER:-}"; do
  [[ -z "$requested" ]] && continue
  if ! normalized_suite="$(normalize_suite "$requested")"; then
    echo "ERROR: Unknown suite: '$requested'. Use fast or full." >&2
    exit 2
  fi
  requested="$normalized_suite"
  if [[ "$requested" == "full" ]]; then
    suite="$requested"
  fi
done
# The release channel sets a verification floor: delivery branches carry
# beta work, while standalone, hotfix, and release-recovery work on main is
# stable and needs full evidence. Local verification takes the stronger of
# that floor and the path tier; hosted CI passes its own resolved tier.
floor_plan="$(python3 "$control_root/.csarc/scripts/trusted_executor.py" channel-floor \
  --base "$base" --labels "${CSARC_CI_LABELS:-}" --path-tier "$plan_tier")"
channel_floor="${floor_plan#*floor=}"
channel_floor="${channel_floor%% *}"
if [[ "$channel_floor" == "full" && "$suite" != "full" ]]; then
{% if verification_mode != "hosted" -%}
  if [[ -z "${CSARC_CI_TIER:-}" ]]; then
    suite=full
  fi
{% else -%}
  echo "NOTICE: Base $base needs full; hosted verify supplies it."
{% endif -%}
fi
# message-pattern: allow X1 key=value plan
echo "Local verification plan: base=$base merge-base=$merge_base suite=$suite scopes=${scope_csv:-none}"
{% if has_python %}export UV_PYTHON="${CSARC_PYTHON_VERSION:-{{ python_target }}}"
{% endif -%}
{% if verification_mode == "self-hosted" -%}
[[ -n "${CSARC_CI_TIER:-}" ]] ||
  echo "NOTICE: Self-hosted merge evidence comes only from the registered VM; this run is not VM evidence."
{% endif -%}
case "$suite" in
  fast) ;;
  full)
    CSARC_VERIFICATION_SUBJECT_ROOT="$repo_root" \
      "$control_root/.csarc/scripts/verify"
    exit 0
    ;;
  *)
    echo "ERROR: Unknown suite: '$suite'. Use 'fast' or 'full'." >&2
    exit 2
    ;;
esac

verification_step "Changed-tree hygiene" git diff --check
verification_step "Conflict-marker check" ./.csarc/scripts/check-update-conflicts
verification_step "Secret scan" ./.csarc/scripts/scan-secrets
verification_step "Message pattern check" \
  ./.csarc/scripts/check-message-style --base "$merge_base"

if [[ "$scopes" == *,workflow,* || "$scopes" == *,shell,* ||
  "$scopes" == *,template,* ]]; then
  verification_step "Workflow and shell lint" ./.csarc/scripts/lint-workflows-shell
fi
if [[ "$scopes" == *,workflow,* || "$scopes" == *,template,* ]]; then
  verification_step "GitHub Actions pin check" \
    python3 .csarc/scripts/check_action_pins.py --root .
fi

{% if has_python or has_typescript or has_rust or has_go -%}
run_project_checks="$run_project"
{% endif -%}

{% if has_python -%}
if $run_project_checks || [[ "$scopes" == *,dependency,* ]]; then
  python_version="$UV_PYTHON"
  verification_step "Locked Python environment" \
    uv sync --locked --python "$python_version"
fi
if $run_project_checks; then
  verification_step "Python formatting" uv run ruff format --check .
  verification_step "Python lint" uv run ruff check .
  verification_step "Python type check" uv run ty check
fi
{% endif -%}
{% if has_typescript -%}
if $run_project_checks || [[ "$scopes" == *,dependency,* ]]; then
  pnpm_store_dir="$cache_root/pnpm/store"
  verification_step "TypeScript locked install" \
    pnpm install --store-dir "$pnpm_store_dir" --frozen-lockfile --ignore-scripts
fi
if $run_project_checks; then
  verification_step "TypeScript lint" \
    pnpm exec biome ci typescript vitest.config.ts package.json
  verification_step "TypeScript type check" pnpm exec tsc --noEmit
fi
{% endif -%}
{% if has_rust -%}
if $run_project_checks; then
  verification_step "Rust formatting" cargo fmt --all -- --check
  verification_step "Rust lint" \
    cargo clippy --locked --all-targets --all-features -- -D warnings
fi
{% endif -%}
{% if has_go -%}
if $run_project_checks; then
  export GOTOOLCHAIN=local
  export GOFLAGS=-mod=readonly
  unformatted_go="$(go list -f '{% raw %}{{.Dir}}{% endraw %}' ./... | xargs gofmt -l)"
  verification_step "Go formatting" test -z "$unformatted_go"
  verification_step "Go vet" go vet ./...
fi
{% endif -%}

if [[ "${CSARC_RUN_OSV:-false}" == "true" || "$scopes" == *,dependency,* ]]; then
  verification_step "Dependency scan" ./.csarc/scripts/verify-dependencies
fi
{% if has_python -%}
if $run_project_checks; then
  verification_step "Bounded Python regression suite" \
    uv run pytest -m "not large"
fi
{% endif -%}
{% if has_typescript -%}
if $run_project_checks; then
  verification_step "TypeScript tests" pnpm exec vitest run
fi
{% endif -%}
{% if has_rust -%}
if $run_project_checks; then
  verification_step "Rust tests" cargo test --locked --all-features
fi
{% endif -%}
{% if has_go -%}
if $run_project_checks; then
  verification_step "Go tests" go test ./...
fi
{% endif -%}

{% if documentation_mode != 'off' -%}
if [[ "$scopes" == *,docs,* ]]; then
  verification_step "Specification validation" \
    python3 .csarc/scripts/spec_to_issue.py validate
{% if documentation_mode == 'template-and-content' -%}
  verification_step "Repository site render" ./.csarc/scripts/build-repo-site --check
{% endif -%}
fi
{% endif -%}

{% if verification_mode != "hosted" -%}
# The recorder comes from the control set, so the trusted base can record
# a candidate render that no longer ships it (#1318).
python3 "$control_root"/.csarc/scripts/local_verification.py record \
  --control-root "$control_root" --tier fast \
  --scopes "${scope_csv:-unknown}" --base "$base" \
  --head-sha "$verification_head_sha" --base-sha "$verification_base_sha"
{% endif -%}

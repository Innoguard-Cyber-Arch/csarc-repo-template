#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Issue #1318: tools and settings come from this checkout; a trusted
# check root names the tree it checks in CSARC_VERIFICATION_SUBJECT_ROOT.
repo_root="$(cd "${CSARC_VERIFICATION_SUBJECT_ROOT:-$script_root}" && pwd)"
config_file="$script_root/.csarc/config.yml"

detected_languages=()
[[ -f "$repo_root/go.mod" ]] && detected_languages+=(go)
[[ -f "$repo_root/pyproject.toml" ]] && detected_languages+=(python)
[[ -f "$repo_root/Cargo.toml" ]] && detected_languages+=(rust)
[[ -f "$repo_root/package.json" ]] && detected_languages+=(typescript)
detected=""
if ((${#detected_languages[@]} > 0)); then
  detected="$(IFS=,; printf '%s' "${detected_languages[*]}")"
fi

if [[ "${1:-}" == "--suggest" ]]; then
  printf '%s\n' "${detected:-ci}"
  exit 0
fi

if [[ ! -f "$config_file" ]]; then
  echo "ERROR: Settings are missing: no .csarc/config.yml. Run 'csarc update'." >&2
  exit 1
fi

declared="$(python3 "$script_root/.csarc/scripts/csarc_config.py" --config "$config_file" languages)"
if [[ "$declared" != "$detected" ]]; then
  echo "ERROR: Languages differ: saved '$declared', found '$detected'. Run 'csarc update'." >&2
  exit 1
fi

printf 'language modules: %s\n' "${declared:-ci}"

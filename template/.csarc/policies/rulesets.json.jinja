{
  "name": "CSARC protected branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [{% if admin_bypass != 'off' %}
    {"actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "pull_request"}
  {% endif %}],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/dev/m*"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": {{ 'true' if verification_mode == 'local' and admin_bypass == 'off' else 'false' }},
        "required_approving_review_count": {{ 1 if verification_mode == 'local' and admin_bypass == 'off' else 0 }},
        "required_review_thread_resolution": true
      }
    }{% if copilot_review == 'allowed' %},
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_draft_pull_requests": false,
        "review_on_push": true
      }
    }{% endif %}
  ]
}

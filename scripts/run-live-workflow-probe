#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 5 ]]; then
  echo "Usage: $0 <capability> <workflow> <ref> <evidence-file> <failure-layer>" >&2
  exit 2
fi

capability="$1"
workflow="$2"
ref="$3"
evidence_file="$4"
failure_layer="$5"
repo="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
timeout_seconds="${CSARC_LIVE_TIMEOUT_SECONDS:-900}"
poll_seconds="${CSARC_LIVE_POLL_SECONDS:-5}"

if [[ ! "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] ||
  [[ ! "$poll_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "Probe timeout and poll interval must be positive integers." >&2
  exit 2
fi

mkdir -p "$(dirname "$evidence_file")"

write_evidence() {
  local status="$1"
  local conclusion="$2"
  local run_id="$3"
  local run_url="$4"
  local detail="$5"
  jq -n \
    --arg capability "$capability" \
    --arg workflow "$workflow" \
    --arg ref "$ref" \
    --arg status "$status" \
    --arg conclusion "$conclusion" \
    --arg run_id "$run_id" \
    --arg url "$run_url" \
    --arg failure_layer "$failure_layer" \
    --arg detail "$detail" \
    --arg checked_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      schema_version: 1,
      capability: $capability,
      workflow: $workflow,
      ref: $ref,
      status: $status,
      conclusion: $conclusion,
      run_id: ($run_id | if . == "" then null else tonumber end),
      url: ($url | if . == "" then null else . end),
      failure_layer: $failure_layer,
      detail: $detail,
      checked_at: $checked_at
    }' > "$evidence_file"
}

if ! before_id="$(
  gh run list \
    --repo "$repo" \
    --workflow "$workflow" \
    --event workflow_dispatch \
    --branch "$ref" \
    --limit 1 \
    --json databaseId \
    --jq '.[0].databaseId // 0'
)"; then
  detail="Cannot inspect prior runs. Check actions:write token access and the repository Actions setting."
  write_evidence "failed" "api-error" "" "" "$detail"
  echo "::error::$capability: $detail Failure layer: $failure_layer."
  exit 1
fi

if ! gh workflow run "$workflow" --repo "$repo" --ref "$ref"; then
  detail="Dispatch failed. Check actions:write token access, workflow_dispatch, and the requested ref."
  write_evidence "failed" "dispatch-error" "" "" "$detail"
  echo "::error::$capability: $detail Failure layer: $failure_layer."
  exit 1
fi

deadline=$((SECONDS + timeout_seconds))
run_id=""
while ((SECONDS < deadline)); do
  run_id="$(
    gh run list \
      --repo "$repo" \
      --workflow "$workflow" \
      --event workflow_dispatch \
      --branch "$ref" \
      --limit 20 \
      --json databaseId \
      --jq "[.[] | select(.databaseId > $before_id)] | max_by(.databaseId).databaseId // empty"
  )"
  [[ -n "$run_id" ]] && break
  sleep "$poll_seconds"
done

if [[ -z "$run_id" ]]; then
  detail="No workflow_dispatch run appeared before timeout. Check the event trigger and requested ref."
  write_evidence "failed" "event-not-observed" "" "" "$detail"
  echo "::error::$capability: $detail Failure layer: $failure_layer."
  exit 1
fi

watch_exit=0
gh run watch "$run_id" --repo "$repo" --exit-status || watch_exit=$?
run_json="$(
  gh run view "$run_id" --repo "$repo" --json conclusion,url 2>/dev/null || true
)"
conclusion="$(jq -r '.conclusion // "unknown"' <<<"${run_json:-{}}")"
run_url="$(jq -r '.url // ""' <<<"${run_json:-{}}")"

if [[ "$watch_exit" -eq 0 && "$conclusion" == "success" ]]; then
  write_evidence "passed" "$conclusion" "$run_id" "$run_url" \
    "GitHub accepted the dispatch and the online workflow completed successfully."
  exit 0
fi

detail="The dispatched workflow failed. Inspect its first failing step and verify the named permission layer."
write_evidence "failed" "$conclusion" "$run_id" "$run_url" "$detail"
echo "::error::$capability: $detail Failure layer: $failure_layer. Run: $run_url"
exit 1

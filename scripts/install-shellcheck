#!/usr/bin/env bash
set -euo pipefail

version="0.11.0"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_dir="$repo_root/.cache/shellcheck/$version"
binary="$cache_dir/shellcheck"

if [[ -x "$binary" ]]; then
  printf '%s\n' "$binary"
  exit 0
fi

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)
    platform="darwin.aarch64"
    expected_sha256="339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f"
    ;;
  Darwin-x86_64)
    platform="darwin.x86_64"
    expected_sha256="c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51"
    ;;
  Linux-aarch64 | Linux-arm64)
    platform="linux.aarch64"
    expected_sha256="68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc"
    ;;
  Linux-x86_64)
    platform="linux.x86_64"
    expected_sha256="b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6"
    ;;
  *)
    printf 'Unsupported platform. Install ShellCheck %s and place it on PATH.\n' "$version" >&2
    exit 1
    ;;
esac

mkdir -p "$cache_dir"
asset="shellcheck-v${version}.${platform}.tar.gz"
curl -fsSL \
  "https://github.com/koalaman/shellcheck/releases/download/v${version}/$asset" \
  -o "$cache_dir/$asset"
actual_sha256="$(shasum -a 256 "$cache_dir/$asset" | awk '{print $1}')"
if [[ "$actual_sha256" != "$expected_sha256" ]]; then
  echo "ShellCheck archive does not match the pinned digest." >&2
  exit 1
fi

tar -xzf "$cache_dir/$asset" -C "$cache_dir" \
  --strip-components 1 "shellcheck-v${version}/shellcheck"
chmod +x "$binary"
printf '%s\n' "$binary"

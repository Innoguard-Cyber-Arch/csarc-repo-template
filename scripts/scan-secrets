#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Issue #1333: tools and settings come from this checkout; a trusted
# copy names the tree it checks in CSARC_VERIFICATION_SUBJECT_ROOT.
repo_root="$(cd "${CSARC_VERIFICATION_SUBJECT_ROOT:-$script_root}" && pwd)"
gitleaks_bin="$("$script_root/scripts/install-gitleaks")"
# The checking tree's settings, never the checked tree's own copy.
gitleaks_config="$script_root/.gitleaks.toml"
target="$repo_root"
target_set=false
log_opts=""

for argument in "$@"; do
  case "$argument" in
    --log-opts=*) log_opts="${argument#*=}" ;;
    --help)
      # message-pattern: allow X3 usage
      echo "Usage: $0 [path] [--log-opts='<git log options>']"
      exit 0
      ;;
    -*)
      echo "ERROR: Unknown option: '$argument'. Run '$0 --help'." >&2
      exit 2
      ;;
    *)
      if [[ "$target_set" == true ]]; then
        echo "ERROR: Too many paths: one is allowed. Pass one path." >&2
        exit 2
      fi
      target="$argument"
      target_set=true
      ;;
  esac
done

target="$(cd "$target" && pwd)"
status=0
if git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
  git -C "$target" rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "NOTICE: Scanning Git history with Gitleaks."
  history_args=(git "$target" --config "$gitleaks_config" --no-banner --redact)
  if [[ -n "$log_opts" ]]; then
    history_args+=(--log-opts="$log_opts")
  fi
  "$gitleaks_bin" "${history_args[@]}" || status=1
elif [[ -n "$log_opts" ]]; then
  echo "ERROR: --log-opts failed: no commit exists. Commit first." >&2
  status=1
else
  echo "NOTICE: History scan skipped: no commit exists."
fi

echo "NOTICE: Scanning the working tree with Gitleaks."
"$gitleaks_bin" dir "$target" --config "$gitleaks_config" --no-banner --redact ||
  status=1
exit "$status"

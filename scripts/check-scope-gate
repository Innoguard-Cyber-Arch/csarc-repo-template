#!/usr/bin/env bash
set -euo pipefail

# Wires sync_milestone_state.py's `check-scope` subcommand (#552) into
# pr-policy.yml (#632): resolves the work Issue a pull request's own body
# closes -- the same `Closes|Fixes|Resolves #<n>` keyword
# scripts/validate-pr-policy already requires and, for delivery-cutover-era
# PRs, cross-validates against GitHub's own closingIssuesReferences -- and,
# when found, evaluates scope_decision() for it. Fails closed: a work Issue
# that declares `Tracker scope: expanded` and has not been independently
# (re-)approved blocks this script, and so the pull request.
#
# A pull request with no closing Issue reference at all (release
# automation, dependabot, a main-sync bridge -- see
# scripts/validate-pr-policy) has no linked work Issue to gate, so this
# script is a silent no-op for it.
#
# Usage: PR_BODY=<pull request body> GITHUB_REPOSITORY=<owner/repo> \
#   scripts/check-scope-gate

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"

issue_number="$(python3 -c '
import os
import re

body = os.environ.get("PR_BODY") or ""
match = re.search(
    r"(?<!\w)(?:Closes|Fixes|Resolves)[ \t]+#([0-9]+)(?!\w)", body
)
print(match.group(1) if match else "")
')"

if [[ -z "$issue_number" ]]; then
  echo "No closing Issue reference in the pull request body; the scope-drift gate does not apply."
  exit 0
fi

if ! python3 scripts/sync_milestone_state.py --help 2>/dev/null | grep -q check-scope; then
  echo "::notice::Scope-drift gate starts after the rollout PR reaches its base branch."
  exit 0
fi

python3 scripts/sync_milestone_state.py check-scope \
  --repo "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}" \
  --issue "$issue_number"

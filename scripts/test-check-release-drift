#!/usr/bin/env bash
set -euo pipefail

# Regression test for scripts/check-release-drift (Issue #605): proves the
# drift condition using a mocked `gh` binary, so this never makes a real
# network call. The mock applies the real `jq` binary to raw-shaped GitHub
# API fixtures, including immutable stable Release and audit-only publish
# record evidence.

script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check-release-drift"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT
mkdir -p "$fixture_root/bin"

mock_repo="octo/example"
main_sha="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

cat >"$fixture_root/bin/gh" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail

# Print the value following the first occurrence of $1 among the
# remaining arguments, or nothing if $1 is not present. Never fails, so a
# missing flag under `set -e` in the caller does not abort the mock.
find_flag_value() {
  local flag="$1"
  shift
  local i
  for ((i = 1; i <= $#; i++)); do
    if [[ "${!i}" == "$flag" ]]; then
      local next=$((i + 1))
      printf '%s' "${!next}"
      break
    fi
  done
  return 0
}

case "$1" in
  repo)
    if [[ "$2" == "view" ]]; then
      printf '%s\n' "$MOCK_REPO"
      exit 0
    fi
    echo "mock gh: unexpected repo subcommand: $*" >&2
    exit 2
    ;;
  pr)
    if [[ "$2" == "list" ]]; then
      if [[ "${MOCK_FAIL_AUDIT:-0}" == "1" ]]; then
        echo "mock gh: release PR audit failure" >&2
        exit 1
      fi
      cat "$MOCK_ROOT/release-prs.json"
      exit 0
    fi
    echo "mock gh: unexpected pr subcommand: $*" >&2
    exit 2
    ;;
  issue)
    case "$2" in
      list)
        jq_query="$(find_flag_value --jq "$@")"
        jq -r "$jq_query" "$MOCK_ROOT/open-issues.json"
        ;;
      edit)
        issue_number="$3"
        body_file="$(find_flag_value --body-file "$@")"
        echo "edit $issue_number" >>"$MOCK_ROOT/issue-calls.log"
        cp "$body_file" "$MOCK_ROOT/last-issue-body.md"
        ;;
      create)
        body_file="$(find_flag_value --body-file "$@")"
        echo "create" >>"$MOCK_ROOT/issue-calls.log"
        cp "$body_file" "$MOCK_ROOT/last-issue-body.md"
        ;;
      *)
        echo "mock gh: unexpected issue subcommand: $*" >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
  api)
    path="$2"
    jq_query="$(find_flag_value --jq "$@")"
    if [[ "$path" == repos/*/commits/main ]]; then
      fixture="$MOCK_ROOT/main-commit.json"
    elif [[ "$path" == repos/*/actions/workflows/release.yml/runs* ]]; then
      fixture="$MOCK_ROOT/last-run.json"
    elif [[ "$path" == repos/*/releases\?per_page=100 ]]; then
      fixture="$MOCK_ROOT/releases.json"
    elif [[ "$path" == repos/*/compare/* ]]; then
      fixture="$MOCK_ROOT/release-compare.json"
    elif [[ "$path" == repos/*/commits\?sha=main* ]]; then
      if [[ "${MOCK_FAIL_AUDIT:-0}" == "1" ]]; then
        echo "mock gh: commit audit failure" >&2
        exit 1
      fi
      fixture="$MOCK_ROOT/recent-commits.json"
    elif [[ "$path" == repos/*/issues/*/comments* ]]; then
      if [[ "${MOCK_FAIL_AUDIT:-0}" == "1" ]]; then
        echo "mock gh: Issue audit failure" >&2
        exit 1
      fi
      fixture="$MOCK_ROOT/issue-comments.json"
    else
      echo "mock gh: unexpected api path: $path" >&2
      exit 2
    fi
    if [[ -n "$jq_query" ]]; then
      jq -c "$jq_query" "$fixture"
    else
      cat "$fixture"
    fi
    exit 0
    ;;
  *)
    echo "mock gh: unexpected command: $*" >&2
    exit 2
    ;;
esac
MOCK
chmod +x "$fixture_root/bin/gh"

export MOCK_ROOT="$fixture_root"
export MOCK_REPO="$mock_repo"

run_mocked() {
  PATH="$fixture_root/bin:$PATH" "$script_path" --now "2026-09-04T12:00:00Z" "$@"
}

reset_fixtures() {
  printf '[]\n' >"$fixture_root/open-issues.json"
  printf '[]\n' >"$fixture_root/recent-commits.json"
  printf '[]\n' >"$fixture_root/issue-comments.json"
  printf '[]\n' >"$fixture_root/releases.json"
  printf '{}\n' >"$fixture_root/release-compare.json"
  printf '[]\n' >"$fixture_root/release-prs.json"
  printf '{"workflow_runs": []}\n' >"$fixture_root/last-run.json"
  : >"$fixture_root/issue-calls.log"
  rm -f "$fixture_root/last-issue-body.md"
  printf '{"sha": "%s", "commit": {"committer": {"date": "2026-09-04T11:55:00Z"}}}\n' \
    "$main_sha" >"$fixture_root/main-commit.json"
}

# Case 1: release.yml succeeded recently at the current main HEAD. No
# drift regardless of the 24h threshold -- the common, healthy case.
reset_fixtures
cat >"$fixture_root/last-run.json" <<JSON
{"workflow_runs": [{"head_sha": "$main_sha", "updated_at": "2026-09-04T11:56:00Z", "html_url": "https://example.invalid/runs/1"}]}
JSON
healthy_output="$(run_mocked)"
grep -Fq "no drift (main not advanced past the last known release activity)" <<<"$healthy_output"
[[ ! -s "$fixture_root/issue-calls.log" ]]

# Case 2: v0.15.1-shaped evidence -- a stable Release targets current main,
# was published after that commit, and suppresses the false alert even when
# no hosted release run succeeded.
reset_fixtures
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$main_sha", "published_at": "2026-09-04T11:56:00Z", "draft": false, "prerelease": false, "immutable": true, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "identical"}\n' >"$fixture_root/release-compare.json"
release_output="$(run_mocked)"
grep -Fq "valid release evidence" <<<"$release_output"
grep -Fq "no drift (latest stable GitHub Release covers main)" <<<"$release_output"
[[ ! -s "$fixture_root/issue-calls.log" ]]

# Case 3: an ancestor Release is recent activity, but does not claim to
# cover the newer main commit permanently.
reset_fixtures
previous_sha="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$previous_sha", "published_at": "2026-09-04T11:56:00Z", "draft": false, "prerelease": false, "immutable": true, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "ahead"}\n' >"$fixture_root/release-compare.json"
ancestor_release_output="$(run_mocked)"
grep -Fq "valid recent release evidence" <<<"$ancestor_release_output"
grep -Fq "no drift (recent release activity within the threshold)" <<<"$ancestor_release_output"
[[ ! -s "$fixture_root/issue-calls.log" ]]
set +e
stale_ancestor_output="$(run_mocked --hours 0.01 2>&1)"
stale_ancestor_status=$?
set -e
[[ "$stale_ancestor_status" -ne 0 ]]
grep -Fq "DRIFT DETECTED" <<<"$stale_ancestor_output"

# Case 4: even a well-formed trusted release-PR comment is audit text, not
# authoritative release state, and cannot suppress drift.
reset_fixtures
cat >"$fixture_root/release-prs.json" <<JSON
[{"number": 42, "title": "chore(main): release 1.2.3", "mergedAt": "2026-09-04T11:55:00Z", "mergeCommit": {"oid": "$main_sha"}, "comments": [{"authorAssociation": "MEMBER", "createdAt": "2026-09-04T11:56:00Z", "body": "Release-publish-record: operator=@octocat commit=$main_sha command=\"scripts/publish-release publish --repo octo/example --tag v1.2.3\" result=published"}]}]
JSON
set +e
pr_record_output="$(run_mocked 2>&1)"
pr_record_status=$?
set -e
[[ "$pr_record_status" -ne 0 ]]
grep -Fq "from release PR #42 comment" <<<"$pr_record_output"
grep -Fq "DRIFT DETECTED" <<<"$pr_record_output"
grep -Fq "create" "$fixture_root/issue-calls.log"

# Case 5: a stable Release with a non-ancestor target is not evidence.
reset_fixtures
other_sha="cccccccccccccccccccccccccccccccccccccccc"
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$other_sha", "published_at": "2026-09-04T11:56:00Z", "draft": false, "prerelease": false, "immutable": true, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "diverged"}\n' >"$fixture_root/release-compare.json"
set +e
unrelated_release_output="$(run_mocked 2>&1)"
unrelated_release_status=$?
set -e
[[ "$unrelated_release_status" -ne 0 ]]
grep -Fq "ignored: target is not main or its ancestor" <<<"$unrelated_release_output"

# Case 6: an ancestor Release published before current main is stale rather
# than proof that the newer main state was deliberately covered.
reset_fixtures
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$previous_sha", "published_at": "2026-09-04T10:00:00Z", "draft": false, "prerelease": false, "immutable": true, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "ahead"}\n' >"$fixture_root/release-compare.json"
set +e
stale_release_output="$(run_mocked 2>&1)"
stale_release_status=$?
set -e
[[ "$stale_release_status" -ne 0 ]]
grep -Fq "ignored: published before the current main commit" <<<"$stale_release_output"

# Case 7: draft and prerelease entries are filtered before evaluation.
reset_fixtures
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.4", "target_commitish": "$main_sha", "published_at": "2026-09-04T11:58:00Z", "draft": true, "prerelease": false, "immutable": true}, {"tag_name": "v1.2.3", "target_commitish": "$main_sha", "published_at": "2026-09-04T11:57:00Z", "draft": false, "prerelease": true, "immutable": true}]
JSON
set +e
unstable_release_output="$(run_mocked 2>&1)"
unstable_release_status=$?
set -e
[[ "$unstable_release_status" -ne 0 ]]
grep -Fq "Latest stable GitHub Release: none found" <<<"$unstable_release_output"

# Case 8: main has advanced past the last successful run, and that run is
# also older than the 24h threshold, with no local publish record anywhere
# -- drift. No existing tracking Issue, so a new one is opened.
reset_fixtures
cat >"$fixture_root/last-run.json" <<JSON
{"workflow_runs": [{"head_sha": "$other_sha", "updated_at": "2026-09-02T00:00:00Z", "html_url": "https://example.invalid/runs/2"}]}
JSON
set +e
drift_output="$(run_mocked --repo "$mock_repo" 2>&1)"
drift_status=$?
set -e
[[ "$drift_status" -ne 0 ]]
grep -Fq "DRIFT DETECTED" <<<"$drift_output"
grep -Fq "create" "$fixture_root/issue-calls.log"
grep -Fq "已經前進" "$fixture_root/last-issue-body.md"

# Case 9: same stale state, but a tracking Issue is already open -- update
# it instead of opening a duplicate.
reset_fixtures
cat >"$fixture_root/last-run.json" <<JSON
{"workflow_runs": [{"head_sha": "$other_sha", "updated_at": "2026-09-02T00:00:00Z", "html_url": "https://example.invalid/runs/2"}]}
JSON
cat >"$fixture_root/open-issues.json" <<'JSON'
[{"number": 77, "title": "Release publish drift detected"}]
JSON
cat >"$fixture_root/issue-comments.json" <<JSON
[{"body": "Release-publish-record: operator=@octocat commit=$main_sha command=\"scripts/publish-release publish --repo octo/example --tag v1.2.3\" result=published", "created_at": "2026-09-04T11:57:00Z", "author_association": "OWNER"}]
JSON
set +e
update_output="$(run_mocked 2>&1)"
update_status=$?
set -e
[[ "$update_status" -ne 0 ]]
grep -Fq "from tracking Issue comment" <<<"$update_output"
grep -Fq "DRIFT DETECTED" <<<"$update_output"
grep -Fq "edit 77" "$fixture_root/issue-calls.log"
[[ "$(cat "$fixture_root/issue-calls.log")" != *create* ]]

# Case 10: a recent commit-message publish record is audit text and cannot
# suppress drift when no authoritative release state exists.
reset_fixtures
cat >"$fixture_root/recent-commits.json" <<JSON
[{"sha": "dddddddddddddddddddddddddddddddddddddddd", "commit": {"committer": {"date": "2026-09-04T10:00:00Z"}, "message": "chore(main): release 1.2.3\n\nRelease-publish-record: operator=@octocat commit=$previous_sha command=\"scripts/publish-release publish --repo octo/example --tag v1.2.3\" result=published"}}]
JSON
set +e
record_output="$(run_mocked 2>&1)"
record_status=$?
set -e
[[ "$record_status" -ne 0 ]]
grep -Fq "Local publish record (audit only): operator=@octocat commit=$previous_sha" <<<"$record_output"
grep -Fq "DRIFT DETECTED" <<<"$record_output"
grep -Fq "create" "$fixture_root/issue-calls.log"

# Case 11: a mutable stable Release cannot suppress drift even when it
# otherwise targets current main and has a plausible publication time.
reset_fixtures
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$main_sha", "published_at": "2026-09-04T11:56:00Z", "draft": false, "prerelease": false, "immutable": false, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "identical"}\n' >"$fixture_root/release-compare.json"
set +e
mutable_release_output="$(run_mocked 2>&1)"
mutable_release_status=$?
set -e
[[ "$mutable_release_status" -ne 0 ]]
grep -Fq "ignored: release is not immutable" <<<"$mutable_release_output"

# Case 12: an older API payload without the immutable field also fails
# closed instead of being accepted as release evidence.
reset_fixtures
cat >"$fixture_root/releases.json" <<JSON
[{"tag_name": "v1.2.3", "target_commitish": "$main_sha", "published_at": "2026-09-04T11:56:00Z", "draft": false, "prerelease": false, "html_url": "https://example.invalid/releases/v1.2.3"}]
JSON
printf '{"status": "identical"}\n' >"$fixture_root/release-compare.json"
set +e
missing_immutable_output="$(run_mocked 2>&1)"
missing_immutable_status=$?
set -e
[[ "$missing_immutable_status" -ne 0 ]]
grep -Fq "ignored: release is not immutable" <<<"$missing_immutable_output"

# Case 13: a recent successful release.yml run remains legitimate activity
# even when main has advanced since that run.
reset_fixtures
cat >"$fixture_root/last-run.json" <<JSON
{"workflow_runs": [{"head_sha": "$previous_sha", "updated_at": "2026-09-04T11:56:00Z", "html_url": "https://example.invalid/runs/3"}]}
JSON
recent_run_output="$(run_mocked)"
grep -Fq "no drift (recent release activity within the threshold)" <<<"$recent_run_output"
[[ ! -s "$fixture_root/issue-calls.log" ]]

# Case 14: audit-only API failures are reported but cannot prevent the
# authoritative drift decision or the tracking-Issue update.
reset_fixtures
cat >"$fixture_root/open-issues.json" <<'JSON'
[{"number": 77, "title": "Release publish drift detected"}]
JSON
set +e
audit_failure_output="$(MOCK_FAIL_AUDIT=1 run_mocked 2>&1)"
audit_failure_status=$?
set -e
[[ "$audit_failure_status" -ne 0 ]]
grep -Fq "release PR audit evidence is unavailable" <<<"$audit_failure_output"
grep -Fq "commit audit evidence is unavailable" <<<"$audit_failure_output"
grep -Fq "tracking Issue audit evidence is unavailable" <<<"$audit_failure_output"
grep -Fq "DRIFT DETECTED" <<<"$audit_failure_output"
grep -Fq "edit 77" "$fixture_root/issue-calls.log"

# Misuse guard: `gh` missing from PATH must fail clearly, not silently
# produce a wrong or empty answer.
set +e
no_gh_output="$(PATH="/usr/bin:/bin" "$script_path" --repo "$mock_repo" 2>&1)"
no_gh_status=$?
set -e
[[ "$no_gh_status" -ne 0 ]]
grep -Fiq "gh" <<<"$no_gh_output"

echo "Release drift check cases passed: 15"

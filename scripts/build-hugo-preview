#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "--check" ]]; }; then
  printf 'Usage: scripts/build-hugo-preview [--check]\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hugo_bin="$("$repo_root/scripts/install-hugo")"

"$hugo_bin" \
  --source "$repo_root" \
  --config decision-site/hugo.toml \
  --destination "$repo_root/dist/hugo-site" \
  --cleanDestinationDir \
  --noBuildLock \
  --environment production \
  --quiet

sources=(dist/hugo-site/index.html dist/hugo-site/en/index.html)
outputs=(dist/hugo-preview.html dist/hugo-preview.en.html)

for index in 0 1; do
  python3 "$repo_root/scripts/render_site.py" \
    --root "$repo_root" \
    --source "${sources[$index]}" \
    --output "${outputs[$index]}"

  if (($# == 1)); then
    python3 "$repo_root/scripts/render_site.py" \
      --root "$repo_root" \
      --source "${sources[$index]}" \
      --output "${outputs[$index]}" \
      --check
  fi
done

printf 'Hugo previews: %s, %s\n' \
  "$repo_root/${outputs[0]}" "$repo_root/${outputs[1]}"

#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "--check" ]]; }; then
  printf 'Usage: scripts/build-hugo-preview [--check]\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hugo_bin="$("$repo_root/scripts/install-hugo")"

"$hugo_bin" \
  --source "$repo_root" \
  --config decision-site/hugo.toml \
  --destination "$repo_root/dist/hugo-site" \
  --cleanDestinationDir \
  --noBuildLock \
  --environment production \
  --quiet

sources=(dist/hugo-site/index.html dist/hugo-site/en/index.html)
outputs=(dist/hugo-preview.html dist/hugo-preview.en.html)

for index in 0 1; do
  python3 "$repo_root/scripts/render_site.py" \
    --root "$repo_root" \
    --source "${sources[$index]}" \
    --output "${outputs[$index]}"

  if (($# == 1)); then
    python3 "$repo_root/scripts/render_site.py" \
      --root "$repo_root" \
      --source "${sources[$index]}" \
      --output "${outputs[$index]}" \
      --check
  fi
done

llms_source=dist/hugo-site/llms.txt
llms_translation_source=dist/hugo-site/en/llms.txt
llms_outputs=(llms.txt docs/llms.txt)

if ! cmp -s "$repo_root/$llms_source" "$repo_root/$llms_translation_source"; then
  printf 'Bilingual Hugo builds produced different llms.txt indexes.\n' >&2
  exit 1
fi

if (($# == 1)); then
  for output in "${llms_outputs[@]}"; do
    if ! cmp -s "$repo_root/$llms_source" "$repo_root/$output"; then
      printf '%s is stale; run scripts/build-hugo-preview\n' "$output" >&2
      exit 1
    fi
  done
else
  for output in "${llms_outputs[@]}"; do
    cp "$repo_root/$llms_source" "$repo_root/$output"
  done
fi

printf 'Hugo previews: %s, %s\n' \
  "$repo_root/${outputs[0]}" "$repo_root/${outputs[1]}"
printf 'LLM indexes: %s, %s\n' \
  "$repo_root/${llms_outputs[0]}" "$repo_root/${llms_outputs[1]}"

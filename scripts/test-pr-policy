# Issue #551: neither this pull request nor its linked Issue has a
# Milestone (the mismatch check above cannot catch "both silently
# unset"), and exactly one Milestone is currently open -- a non-blocking
# reminder comment is posted once, carrying the marker used for
# idempotency, and the check itself still passes.
milestone_safeguard_fixture=(
  PR_BRANCH_STRATEGY="main"
  PR_NUMBER="41"
  PR_TITLE="feat(api): finish work without a milestone"
  PR_LABELS="enhancement"
  PR_BASE="main"
  PR_HEAD="feat/301-active-work"
  PR_BODY="Closes #301"
  PR_ISSUE_STATE="open"
  PR_ISSUE_TITLE="Add verified report workflow"
  PR_CLOSING_ISSUES_JSON=""
)

case_count=$((case_count + 1))
: > "$PR_COMMENT_CALLS_LOG"
env "${milestone_safeguard_fixture[@]}" \
  PR_OPEN_MILESTONES_JSON='[{"number":9,"title":"Milestone 9: Decision site and adoption experience overhaul"}]' \
  "$validator" >/dev/null
grep -Fq 'csarc-milestone-safeguard:551' "$PR_COMMENT_CALLS_LOG"
grep -Fq 'Milestone 9: Decision site and adoption experience overhaul' "$PR_COMMENT_CALLS_LOG"

# The PR-controlled workflow evaluates the same policy without attempting
# the write. The trusted workflow owns the reminder side effect.
case_count=$((case_count + 1))
: > "$PR_COMMENT_CALLS_LOG"
env "${milestone_safeguard_fixture[@]}" \
  PR_POLICY_READ_ONLY="true" \
  PR_OPEN_MILESTONES_JSON='[{"number":9,"title":"Milestone 9"}]' \
  "$validator" >/dev/null
[[ ! -s "$PR_COMMENT_CALLS_LOG" ]]

# Idempotency: the same scenario, but a prior reminder comment (carrying
# the marker) already exists -- no second comment is posted.
case_count=$((case_count + 1))
: > "$PR_COMMENT_CALLS_LOG"
env "${milestone_safeguard_fixture[@]}" \
  PR_OPEN_MILESTONES_JSON='[{"number":9,"title":"Milestone 9"}]' \
  PR_EXISTING_COMMENT_BODIES_JSON='["unrelated comment","<!-- csarc-milestone-safeguard:551 -->\nAlready reminded."]' \
  "$validator" >/dev/null
[[ ! -s "$PR_COMMENT_CALLS_LOG" ]]

# Zero open Milestones -- nothing to suggest, no comment posted.
case_count=$((case_count + 1))
: > "$PR_COMMENT_CALLS_LOG"
env "${milestone_safeguard_fixture[@]}" "$validator" >/dev/null
[[ ! -s "$PR_COMMENT_CALLS_LOG" ]]

# Two open Milestones -- ambiguous, treated the same as zero rather than

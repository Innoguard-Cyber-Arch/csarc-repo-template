  "$validator" >/dev/null

case_count=$((case_count + 1))
if PR_BRANCH_STRATEGY="main" \
  PR_TITLE="feat(api): add report" \
  PR_LABELS="enhancement" \
  PR_BASE="main" \
  PR_HEAD="feat/42-report" \

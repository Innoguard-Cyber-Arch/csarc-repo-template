PR_ISSUE_LABELS="enhancement,promotion" \
  "$validator" >/dev/null

case_count=$((case_count + 1))
if PR_BRANCH_STRATEGY="delivery" \
  PR_TITLE="feat(api): promote wrong isolated issue" \
  PR_LABELS="enhancement,promotion" \
  PR_BASE="main" \
  PR_HEAD="dev/i41-payment-soak" \
  PR_BODY="Closes #42" \
  PR_ISSUE_STATE="open" \
  PR_ISSUE_MILESTONE_NUMBER="0" \
  PR_ISSUE_LABELS="enhancement,promotion" \
    "$validator" >/dev/null 2>&1; then
  echo "PR policy accepted an isolated branch for another Issue."
  exit 1
fi

case_count=$((case_count + 1))
if PR_BRANCH_STRATEGY="delivery" \
  PR_TITLE="feat!: promote wrong milestone" \

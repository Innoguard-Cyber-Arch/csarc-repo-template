#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
validator="$(mktemp)"
trap 'rm -f "$validator"' EXIT
case_count=0

{
  printf '#!/usr/bin/env bash\n'
  awk '
    /^      - name: Validate pull request policy$/ { found = 1; next }
    found && /^        run: \|$/ { in_run = 1; next }
    in_run && /^$/ { print; next }
    in_run && /^          / { sub(/^          /, ""); print; next }
    in_run { exit }
  ' "$repo_root/.github/workflows/pr-policy.yml"
} > "$validator"
chmod +x "$validator"

if ! grep -q 'branch_pattern=' "$validator"; then
  echo "Could not extract the PR policy from the workflow."
  exit 1
fi

while IFS='|' read -r expected name strategy title base head body issue_state; do
  [[ -z "$expected" || "$expected" == \#* ]] && continue
  [[ "$body" == "-" ]] && body=""
  [[ "$issue_state" == "-" ]] && issue_state=""
  case_count=$((case_count + 1))

  if output="$(
    PR_BRANCH_STRATEGY="$strategy" \
    PR_TITLE="$title" \
    PR_BASE="$base" \
    PR_HEAD="$head" \
    PR_BODY="$body" \
    PR_ISSUE_STATE="$issue_state" \
      "$validator" 2>&1
  )"; then
    actual="pass"
  else
    actual="fail"
  fi

  if [[ "$actual" != "$expected" ]]; then
    echo "PR policy case '$name' expected $expected but got $actual."
    [[ -n "$output" ]] && echo "$output"
    exit 1
  fi
done <<'CASES'
# expected|name|strategy|title|base|head|body|issue state
pass|main work|main|feat(api): add report|main|feat/42-report|Closes #42|open
pass|dev work|dev|fix(api): handle timeout|dev|fix/42-timeout|Fixes #42|open
pass|dev promotion|dev|feat!: promote tested changes|main|dev|-|-
pass|release please|main|chore(main): release 0.2.0|main|release-please--branches--main--components--repo|-|-
pass|dependabot|main|build(deps): bump pytest|main|dependabot/pip/pytest-9|-|-
fail|unsupported title type|main|feature(api): add report|main|feat/42-report|Closes #42|open
fail|non ASCII title|main|feat(api): 新增報表|main|feat/42-report|Closes #42|open
fail|uppercase scope|main|feat(API): add report|main|feat/42-report|Closes #42|open
fail|empty summary|main|feat:|main|feat/42-report|Closes #42|open
fail|branch lacks Issue number|main|feat(api): add report|main|feat/report|Closes #42|open
fail|unsupported branch type|main|feat(api): add report|main|feature/42-report|Closes #42|open
fail|uppercase branch slug|main|feat(api): add report|main|feat/42-Report|Closes #42|open
fail|mismatched Issue link|main|feat(api): add report|main|feat/42-report|Closes #41|open
fail|closed Issue|main|feat(api): add report|main|feat/42-report|Closes #42|closed
fail|main mode targets dev|main|feat(api): add report|dev|feat/42-report|Closes #42|open
fail|dev work targets main|dev|feat(api): add report|main|feat/42-report|Closes #42|open
fail|unknown branch strategy|staging|feat(api): add report|staging|feat/42-report|Closes #42|open
CASES

echo "PR policy regression cases passed: $case_count"

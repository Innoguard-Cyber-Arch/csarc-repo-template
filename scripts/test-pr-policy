# Issue #1069: the trusted base routes .csarc/scripts changes, relaxed
# governance values, and schema changes through the governance-switch label.
base_config_text="$(cat "$PR_FIXTURE_BASE_CONFIG")"
governance_case() {
  PR_BRANCH_STRATEGY="main" \
    PR_TITLE="feat(api): add report" \
    PR_BASE="main" \
    PR_HEAD="feat/42-report" \
    PR_BODY="Closes #42" \
    PR_ISSUE_STATE="open" \
    PR_ISSUE_TITLE="Add verified report workflow" \
    "$validator" >/dev/null 2>&1
}
case_count=$((case_count + 1))
if ! PR_CANDIDATE_CONFIG="$base_config_text" PR_LABELS="enhancement" \
  governance_case; then
  echo "ERROR: PR policy regression: it rejected an ordinary change with an unchanged configuration. Fix validate-pr-policy." >&2
  exit 1
fi
case_count=$((case_count + 1))
if PR_CANDIDATE_CONFIG="$base_config_text"$'\ngovernance_mode: observe' \
  PR_LABELS="enhancement" governance_case; then
  echo "ERROR: PR policy regression: it accepted a relaxed governance value without governance-switch. Fix validate-pr-policy." >&2
  exit 1
fi
case_count=$((case_count + 1))
if ! PR_CANDIDATE_CONFIG="$base_config_text"$'\ngovernance_mode: observe' \
  PR_LABELS="enhancement,governance-switch" governance_case; then
  echo "ERROR: PR policy regression: it rejected a declared governance switch. Fix validate-pr-policy." >&2
  exit 1
fi
case_count=$((case_count + 1))
if PR_CANDIDATE_CONFIG="$base_config_text" \
  PR_CHANGED_FILES_JSON='[[{"filename":".csarc/scripts/verify-fast","status":"modified"}]]' \
  PR_LABELS="enhancement" governance_case; then
  echo "ERROR: PR policy regression: it accepted a .csarc/scripts change without governance-switch. Fix validate-pr-policy." >&2
  exit 1
fi
case_count=$((case_count + 1))
if PR_CANDIDATE_CONFIG="$base_config_text"$'\nschema_version: 9' \
  PR_LABELS="enhancement,governance-switch" governance_case; then
  echo "ERROR: PR policy regression: it accepted a configuration schema the trusted base cannot read. Fix validate-pr-policy." >&2
  exit 1
fi
case_count=$((case_count + 1))
if ! PR_POLICY_FIXTURE=false \
  PR_NUMBER="42" \
  PR_LIVE_LABELS="enhancement" \
  PR_LIVE_BODY="Closes #42" \
  PR_HEAD_SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" \
  PR_LABELS="enhancement" governance_case; then
  echo "ERROR: PR policy regression: it rejected a live candidate configuration equal to its base. Fix validate-pr-policy." >&2
  exit 1
fi

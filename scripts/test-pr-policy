    "$validator" >/dev/null 2>&1; then
  echo "PR policy accepted a Milestone Issue as a direct hotfix."
  exit 1
fi

case_count=$((case_count + 1))
PR_BRANCH_STRATEGY="delivery" \
PR_DELIVERY_CUTOVER_ISSUE="185" \
PR_TITLE="feat(api): finish pre-cutover work" \

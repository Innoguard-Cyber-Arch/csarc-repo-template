  exit 1
fi

# SPEC-010 (Issue #1079): a Ready work pull request maps every acceptance
# criterion and risk of its Issue to exact-head evidence. A stub `gh` serves
# the read-only GitHub reads of `pr_lifecycle.py trace` from fixture files.
trace_dir="$fixture/trace"
mkdir -p "$trace_dir/bin" "$trace_dir/api"
cat > "$trace_dir/bin/gh" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
endpoint="${*: -1}"
name="$(printf '%s' "$endpoint" | LC_ALL=C tr -c 'A-Za-z0-9' '_')"
[[ -f "$TRACE_API/$name.json" ]] || exit 1
cat "$TRACE_API/$name.json"
SH
chmod +x "$trace_dir/bin/gh"
trace_fixture() {
  # Usage: trace_fixture SCENARIO; writes the Issue, PR, files and contents.
  rm -f "$trace_dir/api/"*.json
  python3 - "$trace_dir/api" "$1" "$repo_root/scripts" <<'PY'
import base64, json, re, sys
api, scenario, scripts = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, scripts)
import risk_controls
repo, head = "acme/project", "a" * 40
def write(endpoint, payload):
    name = re.sub(r"[^A-Za-z0-9]", "_", f"repos/{repo}/{endpoint}")
    with open(f"{api}/{name}.json", "w", encoding="utf-8") as stream:
        json.dump(payload, stream)
risk_rows = "| R1 | correctness | high | Report regresses | Regression test | Focused test | @contributor |"
if scenario.startswith("r0"):
    risk_rows = "| R0 | none | — | Wording only | Docs-only change | scope:docs | @contributor |"
acceptance = ["AC1：Report renders", "AC2：Report links work"]
if scenario == "mislabeled":
    acceptance = list(reversed(acceptance))
issue_body = (
    "### 問題\n\nReport.\n\n### 完成條件\n\n"
    + "".join(f"- [x] {item}\n" for item in acceptance)
    + "\n### 補充\n\n#### 風險與控制\n\n"
    "| ID | 類別 | 等級 | 風險 | 控制 | 預計證據 | Owner |\n"
    "| --- | --- | --- | --- | --- | --- | --- |\n" + risk_rows + "\n"
)
out = []
expected = risk_controls.coverage_digest(
    risk_controls.parse_acs(issue_body, out), risk_controls.parse_risks(issue_body, out)
)
evidence = {
    "AC1": "tests/test_report.py::test_report_renders",
    "AC2": "check:verify",
    "R1": "accepted: Single maintainer accepts this residual risk",
}
if scenario.startswith("r0"):
    evidence = {"AC1": "check:verify", "AC2": "check:verify", "R0": "scope:docs"}
if scenario == "unknown":
    evidence["R9"] = "check:verify"
if scenario == "missing-file":
    evidence["AC1"] = "tests/test_absent.py"
if scenario == "missing-name":
    evidence["AC1"] = "tests/test_report.py::test_absent"
coverage = "sha256:" + "0" * 64 if scenario == "stale" else expected
section = (
    f"\n\n## Requirement evidence\n\nIssue: #42\nCoverage: {coverage}\n\n"
    "| ID | 證據 |\n| --- | --- |\n"
    + "".join(f"| {key} | {value} |\n" for key, value in evidence.items())
)
pr_body = "Closes #42" + ("" if scenario == "no-section" else section)
assignee = "someone-else" if scenario == "owner" else "contributor"
write("pulls/41", {
    "number": 41, "state": "open", "merged": False, "body": pr_body,
    "base": {"ref": "main"}, "head": {"ref": "feat/42-report", "sha": head},
})
write("issues/42", {"number": 42, "body": issue_body, "assignees": [{"login": assignee}]})
files = {"r0-agents": "AGENTS.md", "r0-script": "scripts/report.py"}.get(scenario, "docs/report.md")
write("pulls/41/files?per_page=100", [[{"filename": files}]])
content = base64.b64encode(b"def test_report_renders():\n    pass\n").decode()
write(f"contents/tests/test_report.py?ref={head}", {"type": "file", "content": content})
write(f"contents/tests?ref={head}", [{"type": "file"}])
PY
}
trace_case() {
  PR_REQUIREMENT_TRACE_REQUIRED=true \
    TRACE_API="$trace_dir/api" \
    PATH="$trace_dir/bin:$PATH" \
    PR_CANDIDATE_CONFIG="$base_config_text" \
    PR_LABELS="enhancement" \
    governance_case
}
while IFS='|' read -r scenario expected; do
  case_count=$((case_count + 1))
  trace_fixture "$scenario"
  if trace_case; then
    result=pass
  else
    result=fail
  fi
  if [[ "$result" != "$expected" ]]; then
    echo "ERROR: Requirement trace regression: scenario $scenario should $expected but did $result. Fix the requirement trace in 'risk_controls.py'." >&2
    exit 1
  fi
done <<'CASES'
complete|pass
no-section|fail
stale|fail
mislabeled|fail
unknown|fail
missing-file|fail
missing-name|fail
owner|fail
r0-docs|pass
r0-agents|fail
r0-script|fail
CASES
case_count=$((case_count + 1))
trace_fixture no-section
if ! PR_DRAFT=true trace_case; then
  echo "ERROR: Requirement trace regression: it blocked a Draft pull request. Fix the requirement trace in 'risk_controls.py'." >&2
  exit 1
fi
case_count=$((case_count + 1))
trace_fixture complete
trace_output="$(
  PR_REQUIREMENT_TRACE_REQUIRED=true TRACE_API="$trace_dir/api" \
    PATH="$trace_dir/bin:$PATH" PR_CANDIDATE_CONFIG="$base_config_text" \
    PR_LABELS="enhancement" PR_BRANCH_STRATEGY="main" \
    PR_TITLE="feat(api): add report" PR_BASE="main" PR_HEAD="feat/42-report" \
    PR_BODY="Closes #42" PR_ISSUE_STATE="open" \
    PR_ISSUE_TITLE="Add verified report workflow" "$validator" 2>&1
)"
if [[ "$trace_output" != *"requirement-trace: #42 self-accepted: R1(high)"* ]]; then
  echo "ERROR: Requirement trace regression: it did not list the self-accepted high risk. Fix the requirement trace in 'risk_controls.py'." >&2
  exit 1
fi

echo "OK: PR policy regression cases passed: $case_count."

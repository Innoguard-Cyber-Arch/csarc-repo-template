#!/usr/bin/env bash
set -Eeuo pipefail

# "Repository contracts" stage of scripts/verify-template.sh: changed-tree
# hygiene, unresolved Copier/merge conflict markers, secret scanning, script
# message patterns on changed lines, and known-vulnerability scanning of
# dependency lockfiles. Runnable standalone to re-check just this stage
# without paying for the full run; aggregated
# in order by scripts/verify-template.sh. See docs/ci-policy.md.

control_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$control_root/scripts/verification-step"
repo_root="$(verification_subject_root "$control_root")"
# Checks below must not inherit the subject override into nested fixtures.
unset CSARC_VERIFICATION_SUBJECT_ROOT
cd "$repo_root"
# Issue #1333: security checks come from the control root and read the
# subject; the message pattern check stays the subject's own.
checks="$control_root/scripts"
subject=(env "CSARC_VERIFICATION_SUBJECT_ROOT=$repo_root")

verification_step "Changed-tree hygiene" git diff --check
verification_step "Conflict-marker check" \
  "${subject[@]}" "$checks/check-update-conflicts"
verification_step "Secret scan" "${subject[@]}" "$checks/scan-secrets"
verification_step "Message pattern check" ./scripts/check-message-style
verification_step "Dependency scan" \
  "${subject[@]}" "$checks/verify-dependencies"

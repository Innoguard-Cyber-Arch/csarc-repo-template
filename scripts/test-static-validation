#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
actionlint_bin="$("$repo_root/scripts/install-actionlint")"
shellcheck_bin="$("$repo_root/scripts/install-shellcheck")"

grep -Fq -- '-shellcheck=' \
  "$repo_root/scripts/lint-workflows-shell"

if "$actionlint_bin" \
  "$repo_root/tests/fixtures/static-validation/invalid-workflow.yml" \
  >/dev/null 2>&1; then
  echo "ERROR: Actionlint self-test failed: it accepted an invalid workflow. Fix the lint setup." >&2
  exit 1
fi
if "$shellcheck_bin" \
  "$repo_root/tests/fixtures/static-validation/invalid-shell.sh" \
  >/dev/null 2>&1; then
  echo "ERROR: ShellCheck self-test failed: it accepted an invalid script. Fix the lint setup." >&2
  exit 1
fi

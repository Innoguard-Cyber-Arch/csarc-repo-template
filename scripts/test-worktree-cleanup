#!/usr/bin/env bash
set -euo pipefail

script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cleanup-worktrees"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT
repo="$fixture_root/repo"
mkdir -p "$fixture_root/bin"

git init -q -b main "$repo"
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name "Worktree Test"
printf 'base\n' >"$repo/content.txt"
git -C "$repo" add content.txt
git -C "$repo" commit -q -m base

add_worktree() {
  local branch="$1"
  local path="$2"
  git -C "$repo" worktree add -q -b "$branch" "$path" main
  printf '%s\n' "$branch" >"$path/$branch.txt"
  git -C "$path" add .
  git -C "$path" commit -q -m "$branch"
}

merged="$fixture_root/merged"
dirty="$fixture_root/dirty"
unmerged="$fixture_root/unmerged"
squashed="$fixture_root/squashed"
current="$fixture_root/current"
locked="$fixture_root/locked"
detached="$fixture_root/detached"
add_worktree merged "$merged"
add_worktree dirty "$dirty"
add_worktree unmerged "$unmerged"
add_worktree squashed "$squashed"
add_worktree current "$current"
add_worktree locked "$locked"
git -C "$repo" worktree add -q --detach "$detached" main

for branch in merged dirty current locked; do
  git -C "$repo" merge -q --no-ff -m "merge $branch" "$branch"
done
git -C "$repo" merge -q --squash squashed >/dev/null 2>&1
git -C "$repo" commit -q -m "squash squashed"
printf 'dirty\n' >>"$dirty/dirty.txt"
git -C "$repo" worktree lock "$locked"

integration_sha="$(git -C "$repo" rev-parse main)"
for path in "$merged" "$dirty" "$squashed" "$current" "$locked"; do
  head_sha="$(git -C "$path" rev-parse HEAD)"
  printf '%s %s\n' "$head_sha" "$integration_sha" >>"$fixture_root/merged-prs"
done

cat >"$fixture_root/bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

sha="${2%/pulls}"
sha="${sha##*/}"
awk -v sha="$sha" '$1 == sha { print "closed|" $2 }' "$MOCK_MERGED_PRS"
EOF
chmod +x "$fixture_root/bin/gh"
export MOCK_MERGED_PRS="$fixture_root/merged-prs"

dry_run="$(cd "$repo" && PATH="$fixture_root/bin:$PATH" "$script_path" main)"
grep -Fq $'candidate\tmerged\t' <<<"$dry_run"
grep -Fq $'candidate\tsquashed\t' <<<"$dry_run"
grep -Fq $'skip\tdirty\t' <<<"$dry_run"
grep -Fq $'skip\tlocked\t' <<<"$dry_run"
grep -Fq $'skip\tnot verified merged\t' <<<"$dry_run"
grep -Fq $'skip\tdetached\t' <<<"$dry_run"

current_run="$(cd "$current" && PATH="$fixture_root/bin:$PATH" "$script_path" main)"
grep -Fq $'skip\tcurrent worktree\t' <<<"$current_run"

(cd "$repo" && PATH="$fixture_root/bin:$PATH" "$script_path" \
  --apply --worktree "$merged" main >/dev/null)
test ! -e "$merged"
test -e "$squashed"

(cd "$repo" && PATH="$fixture_root/bin:$PATH" "$script_path" --apply main >/dev/null)
test ! -e "$squashed"
test ! -e "$current"
test -e "$dirty"
test -e "$unmerged"
test -e "$detached"
test -e "$locked"

echo "Worktree cleanup cases passed: 8"

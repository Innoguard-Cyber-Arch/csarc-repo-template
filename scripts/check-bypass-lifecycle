#!/usr/bin/env bash
set -euo pipefail

# Fail closed if required checks share a bypassable Ruleset, or if the review
# Ruleset contains an unrecognized bypass actor. Per-work release levels now
# decide whether the known review bypass can be used; required checks never
# inherit it.
#
# Usage: scripts/check-bypass-lifecycle

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 "$repo_root/scripts/release_phase_rulesets.py" check

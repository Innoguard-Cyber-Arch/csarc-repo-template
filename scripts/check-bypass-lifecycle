#!/usr/bin/env bash
set -euo pipefail

# Fail closed if required checks share a bypassable Ruleset, or if the review
# Ruleset contains an unrecognized bypass actor. Per-work release levels now
# decide whether the known review bypass can be used; required checks never
# inherit it.
#
# Usage: scripts/check-bypass-lifecycle

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Issue #1333: tools and settings come from this checkout; a trusted
# copy names the tree it checks in CSARC_VERIFICATION_SUBJECT_ROOT.
repo_root="$(cd "${CSARC_VERIFICATION_SUBJECT_ROOT:-$script_root}" && pwd)"
exec python3 -I "$script_root/scripts/release_phase_rulesets.py" check \
  --review-ruleset "$repo_root/policies/rulesets.json" \
  --required-checks-ruleset "$repo_root/policies/rulesets-required-checks.json"

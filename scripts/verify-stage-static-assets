#!/usr/bin/env bash
set -Eeuo pipefail

# "Static assets and paired files" stage of scripts/verify-template.sh: the
# repo site renders reproducibly, workflow/shell static analysis passes,
# the static-validation fixtures reject known-bad inputs, and root/template
# paired files stay byte-identical. Runnable standalone to re-check just this
# stage without paying for the full run; aggregated in order by
# scripts/verify-template.sh. See docs/ci-policy.md.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
source "$repo_root/scripts/verification-step"

verification_step "Repository site render" ./scripts/build-repo-site --check
verification_step "Workflow and shell lint" ./scripts/lint-workflows-shell
verification_step "Static-validation fixtures" ./scripts/test-static-validation
verification_step "Paired-file drift" ./scripts/sync-paired-files.sh --check

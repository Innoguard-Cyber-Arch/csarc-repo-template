#!/usr/bin/env python3
"""Validate trusted hosted verification for one exact commit."""

from __future__ import annotations

import argparse
import importlib
import json
import sys
from pathlib import Path
from types import ModuleType
from typing import TYPE_CHECKING, Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

if TYPE_CHECKING:
    from pr_lifecycle import GitHub


def lifecycle() -> ModuleType:
    """Load the PR lifecycle module only when a command needs GitHub.

    Argument parsing and --help never import it, so the lifecycle and its
    siblings stay optional for this entry point.
    """
    return importlib.import_module("pr_lifecycle")


def policy_max_age_hours(requested: float | None) -> float:
    """Resolve the evidence freshness window after argument parsing."""
    module = importlib.import_module("evidence_freshness")
    return module.policy_max_age_hours(requested)


def dependabot_coordinates_eligible(
    author: str, head_ref: str, head_repo: str, repo: str
) -> tuple[bool, str]:
    """Delegate Dependabot coordinate checks to their owning module."""
    module = importlib.import_module("authenticate_dependabot_head")
    return module.dependabot_coordinates_eligible(
        author, head_ref, head_repo, repo
    )


def require_trusted_verification(
    *args: object, **kwargs: object
) -> dict[str, object]:
    """Validate hosted evidence through the lazily loaded lifecycle."""
    return lifecycle().require_trusted_verification(*args, **kwargs)


def trusted_required_check_runs(
    *args: object, **kwargs: object
) -> tuple[dict[tuple[str, int], dict[str, Any]], object]:
    """Select trusted check rows through the lazily loaded lifecycle."""
    return lifecycle().trusted_required_check_runs(*args, **kwargs)


def write_outputs(path: Path | None, values: dict[str, object]) -> None:
    """Append simple scalar results to one GitHub Actions output file."""
    if path is None:
        return
    with path.open("a", encoding="utf-8") as output:
        for key, value in values.items():
            rendered = str(value).lower() if isinstance(value, bool) else value
            output.write(f"{key}={rendered}\n")


def find_reusable_evidence(
    github: GitHub,
    repo: str,
    head_sha: str,
    *,
    tier: str,
    scopes: str,
    command: str,
    base: str,
    base_sha: str,
    labels: str,
    release_level: str,
    exclude_run_id: int | None,
    max_age_hours: float | None = None,
) -> dict[str, object] | None:
    """Find the newest same-head original execution for an identical route."""
    expected = {
        "tier": tier,
        "scopes": sorted(filter(None, scopes.split(","))),
        "command": command,
        "base": base,
        "base_sha": base_sha,
        "labels": labels,
        "release_level": release_level,
    }
    checks = github.collection(
        repo,
        f"commits/{head_sha}/check-runs?filter=all&per_page=100",
        "check_runs",
    )
    matches: list[dict[str, object]] = []
    for check in checks:
        try:
            evidence = require_trusted_verification(
                github,
                repo,
                head_sha,
                lifecycle().GITHUB_ACTIONS_APP_ID,
                max_age_hours=max_age_hours,
                check_runs=[check],
            )
        except RuntimeError:
            continue
        if evidence.get("reused") is True:
            continue
        if (
            exclude_run_id is not None
            and evidence.get("run_id") == exclude_run_id
        ):
            continue
        if all(evidence.get(key) == value for key, value in expected.items()):
            matches.append(evidence)
    if not matches:
        return None
    return max(matches, key=lambda item: int(item["check_run_id"]))


def _merged_source(
    github: GitHub, repo: str, commit: str, branch: str = "main"
) -> tuple[dict[str, Any], str]:
    """Return one merged commit's unique source PR and identical head tree."""
    pulls = github.pages(repo, f"commits/{commit}/pulls?per_page=100")
    matches: list[dict[str, Any]] = []
    for pull in pulls:
        base = pull.get("base")
        if (
            pull.get("merged_at")
            and pull.get("merge_commit_sha") == commit
            and isinstance(base, dict)
            and base.get("ref") == branch
        ):
            matches.append(pull)
    if len(matches) != 1:
        raise RuntimeError(
            f"Bad source: no one merged-{branch} source PR. "
            "Pass a squash merge."
        )
    head = matches[0].get("head")
    head_sha = head.get("sha") if isinstance(head, dict) else None
    if not isinstance(head_sha, str):
        raise RuntimeError(
            "Source PR head is unavailable: no SHA. "
            "Run 'gh auth status', then run it again."
        )
    merge_commit = github.get(repo, f"git/commits/{commit}")
    source_commit = github.get(repo, f"git/commits/{head_sha}")
    merge_tree = (
        merge_commit.get("tree") if isinstance(merge_commit, dict) else None
    )
    source_tree = (
        source_commit.get("tree") if isinstance(source_commit, dict) else None
    )
    if (
        not isinstance(merge_tree, dict)
        or not isinstance(source_tree, dict)
        or merge_tree.get("sha") != source_tree.get("sha")
    ):
        raise RuntimeError(
            f"Merged {branch} tree does not match: source differs. "
            "Verify the merge."
        )
    return matches[0], head_sha


def resolve_merge_source(
    github: GitHub, repo: str, commit: str, branch: str = "main"
) -> str:
    """Resolve one merged commit on `branch` to its unique source PR head."""
    return _merged_source(github, repo, commit, branch)[1]


def resolve_release_source(
    github: GitHub, repo: str, commit: str, branch: str = "main"
) -> str:
    """Select a reviewed source whose pre-squash history owns the version."""
    pull, head_sha = _merged_source(github, repo, commit, branch)
    head = pull.get("head")
    head_ref = head.get("ref") if isinstance(head, dict) else None
    if isinstance(head_ref, str) and head_ref.startswith("promote/m"):
        return head_sha

    user = pull.get("user")
    author = user.get("login") if isinstance(user, dict) else None
    author_type = user.get("type") if isinstance(user, dict) else None
    head_repo = head.get("repo") if isinstance(head, dict) else None
    head_repo_name = (
        head_repo.get("full_name") if isinstance(head_repo, dict) else None
    )
    eligible, _ = dependabot_coordinates_eligible(
        str(author or ""), str(head_ref or ""), str(head_repo_name or ""), repo
    )
    if not eligible or author_type != "Bot":
        return ""

    identity = (
        lifecycle().DEPENDABOT_ELIGIBILITY_CONTEXT,
        lifecycle().GITHUB_ACTIONS_APP_ID,
    )
    checks = github.collection(
        repo,
        f"commits/{head_sha}/check-runs?filter=latest&per_page=100",
        "check_runs",
    )
    selected, _ = trusted_required_check_runs(
        github, repo, head_sha, {identity}, checks
    )
    check = selected.get(identity)
    if (
        check is None
        or check.get("status") != "completed"
        or check.get("conclusion") != "success"
    ):
        raise RuntimeError(
            "Dependabot source lacks trusted exact-head eligibility: no "
            "pass. Wait for its 'verify' check."
        )
    return head_sha


def main() -> None:
    """Validate one trusted verification run and print its claims."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("commit")
    parser.add_argument("--github-repo", required=True)
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--resolve-merge-source", action="store_true")
    source.add_argument("--resolve-release-source", action="store_true")
    source.add_argument("--find-reusable", action="store_true")
    parser.add_argument("--merge-branch", default="main")
    # Issue #1075: the window is trusted policy; this flag may only tighten
    # it, and a wider value fails closed in the shared freshness check.
    parser.add_argument("--max-age-hours", type=float, default=None)
    parser.add_argument("--required-tier", choices=("docs", "fast", "full"))
    parser.add_argument("--tier", choices=("docs", "fast", "full"))
    parser.add_argument("--scopes", default="")
    parser.add_argument("--command", default="")
    parser.add_argument("--base", default="")
    parser.add_argument("--base-sha", default="")
    parser.add_argument("--labels", default="")
    parser.add_argument("--release-level", default="none")
    parser.add_argument("--exclude-run-id", type=int)
    parser.add_argument("--github-output", type=Path)
    args = parser.parse_args()
    args.max_age_hours = policy_max_age_hours(args.max_age_hours)
    github = lifecycle().GitHub()
    if args.resolve_release_source:
        source_sha = resolve_release_source(
            github, args.github_repo, args.commit, args.merge_branch
        )
        write_outputs(args.github_output, {"sha": source_sha})
        # message-pattern: allow X1 JSON output
        sys.stdout.write(json.dumps({"sha": source_sha}) + "\n")
        return
    head_sha = (
        resolve_merge_source(
            github, args.github_repo, args.commit, args.merge_branch
        )
        if args.resolve_merge_source
        else args.commit
    )
    if args.find_reusable:
        if (
            args.resolve_merge_source
            or args.required_tier is not None
            or args.tier is None
            or not args.scopes
            or not args.command
            or not args.base
            or len(args.base_sha) != 40
            or len(args.labels) != 64
        ):
            parser.error("reusable evidence requires one complete route")
        evidence = find_reusable_evidence(
            github,
            args.github_repo,
            head_sha,
            tier=args.tier,
            scopes=args.scopes,
            command=args.command,
            base=args.base,
            base_sha=args.base_sha,
            labels=args.labels,
            release_level=args.release_level,
            exclude_run_id=args.exclude_run_id,
            max_age_hours=args.max_age_hours,
        )
        if evidence is None:
            write_outputs(args.github_output, {"reuse": False})
            # message-pattern: allow X1 JSON output
            sys.stdout.write(json.dumps({"reuse": False}) + "\n")
            return
        outputs = {
            "reuse": True,
            "source_run": evidence["run_id"],
            "source_job": evidence["job_id"],
            "source_check": evidence["check_run_id"],
        }
        write_outputs(args.github_output, outputs)
        payload = json.dumps({**outputs, "evidence": evidence}, sort_keys=True)
        # message-pattern: allow X1 JSON output
        sys.stdout.write(payload + "\n")
        return
    evidence = require_trusted_verification(
        github,
        args.github_repo,
        head_sha,
        lifecycle().GITHUB_ACTIONS_APP_ID,
        max_age_hours=args.max_age_hours,
        required_tier=args.required_tier,
    )
    # Reused evidence must come from a pull request into this exact branch.
    if args.resolve_merge_source and evidence.get("base") != args.merge_branch:
        raise RuntimeError(
            f"Evidence base is wrong: {evidence.get('base')!r} is not "
            f"{args.merge_branch!r}. Verify a PR into that branch."
        )
    # message-pattern: allow X1 JSON output
    sys.stdout.write(json.dumps(evidence, sort_keys=True) + "\n")


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as error:
        sys.stderr.write(f"ERROR: {error}\n")
        raise SystemExit(1) from error

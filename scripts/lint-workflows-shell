#!/usr/bin/env bash
set -euo pipefail

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Issue #1333: tools and settings come from this checkout; a trusted
# copy names the tree it checks in CSARC_VERIFICATION_SUBJECT_ROOT.
repo_root="$(cd "${CSARC_VERIFICATION_SUBJECT_ROOT:-$script_root}" && pwd)"
actionlint_bin="$("$script_root/scripts/install-actionlint")"
shellcheck_bin="$("$script_root/scripts/install-shellcheck")"

workflow_files=()
while IFS= read -r -d '' file_path; do
  workflow_files+=("$file_path")
done < <(
  find "$repo_root/.github/workflows" -type f \
    \( -name '*.yml' -o -name '*.yaml' \) -print0 2>/dev/null || true
)
if ((${#workflow_files[@]})); then
  "$actionlint_bin" -shellcheck="$shellcheck_bin" "${workflow_files[@]}"
fi

shell_files=()
while IFS= read -r -d '' file_path; do
  if IFS= read -r first_line < "$file_path" && \
    [[ "$first_line" == '#!/usr/bin/env bash' ]]; then
    shell_files+=("$file_path")
  fi
done < <(find "$repo_root/scripts" -maxdepth 1 -type f -print0 2>/dev/null || true)
if ((${#shell_files[@]})); then
  "$shellcheck_bin" --external-sources "${shell_files[@]}"
fi

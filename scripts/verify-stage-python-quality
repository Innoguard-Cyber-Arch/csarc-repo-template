#!/usr/bin/env bash
set -Eeuo pipefail
# Issue #1340: bash reads a script while it runs, so candidate code could
# rewrite the rest of this file. The group below is parsed whole first.
{

# "Python quality" stage of scripts/verify-template.sh: formatting, lint, and
# static typing on the same source tree the regression tests and package
# smoke test exercise. Runnable standalone to re-check just this stage
# without paying for the full run; aggregated in order by
# scripts/verify-template.sh. See docs/ci-policy.md.

control_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$control_root/scripts/verification-step"
repo_root="$(verification_subject_root "$control_root")"
# Checks below must not inherit the subject override into nested fixtures.
unset CSARC_VERIFICATION_SUBJECT_ROOT
cache_root="$("$control_root/scripts/resolve-cache-root")"
if [[ -n "${CSARC_CACHE_ROOT:-}" ]]; then
  export UV_CACHE_DIR="$cache_root/uv"
else
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$cache_root/uv}"
fi
export UV_PYTHON="${CSARC_PYTHON_VERSION:-3.14}"
cd "$repo_root"

verification_step "Python formatting" uv run ruff format --check src scripts tests
verification_step "Python lint" uv run ruff check src scripts tests
verification_step "Python type check" uv run ty check
}; exit

#!/usr/bin/env bash
set -Eeuo pipefail

# "GitHub Actions audit" stage of scripts/verify-template.sh: zizmor's
# workflow-permission and injection audit across the checked-in workflows.
# Runnable standalone to re-check just this stage without paying for the
# full run; aggregated in order by scripts/verify-template.sh. See
# docs/ci-policy.md.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_root="$("$repo_root/scripts/resolve-cache-root")"
if [[ -n "${CSARC_CACHE_ROOT:-}" ]]; then
  export UV_CACHE_DIR="$cache_root/uv"
else
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$cache_root/uv}"
fi
export UV_PYTHON="${CSARC_PYTHON_VERSION:-3.14}"
cd "$repo_root"
source "$repo_root/scripts/verification-step"

# Issue #755: zizmor's auto-discovered config resolved to a stale
# zizmor.yml outside this worktree when run without --config (observed
# in a linked git worktree, where auto-discovery's directory walk landed
# on the primary checkout's copy instead of this one's own edits) --
# pass the path explicitly so the audit always validates against this
# tree's own suppression rules, not whatever auto-discovery happens to
# find first.
verification_step "GitHub Actions security audit" \
  uv run zizmor --config zizmor.yml . --format plain
verification_step "GitHub Actions pin check" python3 scripts/check_action_pins.py

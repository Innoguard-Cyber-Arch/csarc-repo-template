#!/usr/bin/env bash
set -euo pipefail

# Regression test for scripts/check-base-only-remerge (Issue #468): proves
# the "base-only re-merge" exception condition correctly distinguishes a
# qualifying re-merge from each documented non-qualifying case (file
# overlap, verification-infrastructure movement, and a real conflict that
# does not overlap by file name). Every case forks directly from the same
# fixed base_sha so cases cannot interfere with each other.

script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/check-base-only-remerge"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT
repo="$fixture_root/repo"

git init -q -b main "$repo"
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name "Base-Only Remerge Test"
printf 'base\n' >"$repo/base.txt"
git -C "$repo" add base.txt
git -C "$repo" commit -q -m base
base_sha="$(git -C "$repo" rev-parse HEAD)"

# Case 1: qualifies. Own branch touches fileA only; upstream base movement
# touches a disjoint fileB only; no conflict.
git -C "$repo" checkout -q -b own-clean "$base_sha"
printf 'own change\n' >"$repo/fileA.txt"
git -C "$repo" add fileA.txt
git -C "$repo" commit -q -m own_change
own_clean_sha="$(git -C "$repo" rev-parse HEAD)"

git -C "$repo" checkout -q -b upstream-clean "$base_sha"
printf 'upstream change\n' >"$repo/fileB.txt"
git -C "$repo" add fileB.txt
git -C "$repo" commit -q -m upstream_clean
upstream_clean_sha="$(git -C "$repo" rev-parse HEAD)"

qualifies_out="$(cd "$repo" && "$script_path" "$own_clean_sha" "$upstream_clean_sha" "$base_sha")"
grep -Fq 'QUALIFIES' <<<"$qualifies_out"

# Case 2: does not qualify -- file overlap. Own branch and upstream each
# edit a different line of the same fileC (no textual conflict on its own,
# but the same file is touched by both, so it must be rejected).
git -C "$repo" checkout -q -b overlap-base "$base_sha"
printf 'line1\nline2\n' >"$repo/fileC.txt"
git -C "$repo" add fileC.txt
git -C "$repo" commit -q -m base_fileC
overlap_base_sha="$(git -C "$repo" rev-parse HEAD)"

git -C "$repo" checkout -q -b own-overlap "$overlap_base_sha"
printf 'line1-own\nline2\n' >"$repo/fileC.txt"
git -C "$repo" commit -q -am own_edits_fileC
own_overlap_sha="$(git -C "$repo" rev-parse HEAD)"

git -C "$repo" checkout -q -b upstream-overlap "$overlap_base_sha"
printf 'line1\nline2-upstream\n' >"$repo/fileC.txt"
git -C "$repo" commit -q -am upstream_edits_fileC
upstream_overlap_sha="$(git -C "$repo" rev-parse HEAD)"

set +e
overlap_out="$(cd "$repo" && "$script_path" "$own_overlap_sha" "$upstream_overlap_sha" "$overlap_base_sha" 2>&1)"
overlap_status=$?
set -e
[[ "$overlap_status" -ne 0 ]]
grep -Fq 'REQUIRES-FULL-RERUN' <<<"$overlap_out"
grep -Fq 'fileC.txt' <<<"$overlap_out"

# Case 3: does not qualify -- incoming base movement touches verification
# infrastructure, even though it never touches the branch's own file
# (fileA.txt), so overlap alone would not catch it.
git -C "$repo" checkout -q -b upstream-infra "$base_sha"
mkdir -p "$repo/scripts"
printf '#!/usr/bin/env bash\necho fast\n' >"$repo/scripts/verify-fast"
git -C "$repo" add scripts/verify-fast
git -C "$repo" commit -q -m upstream_touches_verify_fast
upstream_infra_sha="$(git -C "$repo" rev-parse HEAD)"

set +e
infra_out="$(cd "$repo" && "$script_path" "$own_clean_sha" "$upstream_infra_sha" "$base_sha" 2>&1)"
infra_status=$?
set -e
[[ "$infra_status" -ne 0 ]]
grep -Fq 'REQUIRES-FULL-RERUN' <<<"$infra_out"
grep -Fq 'scripts/verify-fast' <<<"$infra_out"

# Case 4: does not qualify -- a real merge conflict with zero file-name
# overlap: the branch adds a *directory* at "widget/config.txt" while
# upstream, independently, adds a plain *file* named "widget". The two
# diffs never name the same path ("widget/config.txt" vs "widget"), so the
# overlap check alone would miss this; `git merge-tree` still correctly
# reports a file/directory conflict.
git -C "$repo" checkout -q -b own-dir-conflict "$base_sha"
mkdir -p "$repo/widget"
printf 'cfg\n' >"$repo/widget/config.txt"
git -C "$repo" add widget/config.txt
git -C "$repo" commit -q -m own_adds_widget_dir
own_dir_sha="$(git -C "$repo" rev-parse HEAD)"

git -C "$repo" checkout -q -b upstream-dir-conflict "$base_sha"
printf 'file-not-dir\n' >"$repo/widget"
git -C "$repo" add widget
git -C "$repo" commit -q -m upstream_adds_widget_file
upstream_dir_sha="$(git -C "$repo" rev-parse HEAD)"

# Confirm the fixture really is file-name disjoint, so the assertion below
# proves the merge-tree check (not the overlap check) is what fires.
own_names="$(git -C "$repo" diff --name-only "$base_sha" "$own_dir_sha")"
upstream_names="$(git -C "$repo" diff --name-only "$base_sha" "$upstream_dir_sha")"
if comm -12 <(sort -u <<<"$own_names") <(sort -u <<<"$upstream_names") | grep -q .; then
  echo "fixture bug: own and upstream diffs unexpectedly share a file name" >&2
  exit 1
fi

set +e
conflict_out="$(cd "$repo" && "$script_path" "$own_dir_sha" "$upstream_dir_sha" "$base_sha" 2>&1)"
conflict_status=$?
set -e
[[ "$conflict_status" -ne 0 ]]
grep -Fq 'REQUIRES-FULL-RERUN' <<<"$conflict_out"
grep -Fq 'conflict' <<<"$conflict_out"

echo "Base-only re-merge cases passed: 4"

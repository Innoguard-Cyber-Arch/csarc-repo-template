#!/usr/bin/env bash
set -euo pipefail

version="0.165.0"
checksums_sha256="f167bf5c6263099ab5a5228245bc645461a0c2b85b0fc08d18eed5ac1f58ec70"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v hugo >/dev/null 2>&1 \
  && hugo version | grep -q "hugo v${version}"; then
  command -v hugo
  exit 0
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) asset="hugo_${version}_linux-amd64.tar.gz" ;;
  Linux-aarch64 | Linux-arm64) asset="hugo_${version}_linux-arm64.tar.gz" ;;
  Darwin-*)
    printf 'Install Hugo %s with Homebrew before building the preview.\n' \
      "$version" >&2
    exit 1
    ;;
  *)
    printf 'Unsupported platform. Install Hugo %s and place it on PATH.\n' \
      "$version" >&2
    exit 1
    ;;
esac

cache_root="$("$repo_root/scripts/resolve-cache-root")"
cache_dir="$cache_root/hugo/$version/$asset"
binary="$cache_dir/hugo"
mkdir -p "$cache_dir"
base_url="https://github.com/gohugoio/hugo/releases/download/v${version}"
if [[ ! -f "$cache_dir/checksums.txt" ]] ||
  [[ "$(shasum -a 256 "$cache_dir/checksums.txt" | awk '{print $1}')" != \
    "$checksums_sha256" ]]; then
  curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused \
    "$base_url/hugo_${version}_checksums.txt" \
    -o "$cache_dir/checksums.txt.tmp.$$"
  mv "$cache_dir/checksums.txt.tmp.$$" "$cache_dir/checksums.txt"
fi
actual_checksums_sha256="$(
  shasum -a 256 "$cache_dir/checksums.txt" | awk '{print $1}'
)"
if [[ "$actual_checksums_sha256" != "$checksums_sha256" ]]; then
  printf 'Hugo checksum manifest does not match the pinned digest.\n' >&2
  exit 1
fi

expected_asset_sha256="$(
  awk -v name="$asset" '$2 == name {print $1}' "$cache_dir/checksums.txt"
)"
if [[ -z "$expected_asset_sha256" ]]; then
  printf 'Hugo release manifest does not contain the selected asset.\n' >&2
  exit 1
fi
if [[ ! -f "$cache_dir/$asset" ]] ||
  [[ "$(shasum -a 256 "$cache_dir/$asset" | awk '{print $1}')" != \
    "$expected_asset_sha256" ]]; then
  curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused \
    "$base_url/$asset" -o "$cache_dir/$asset.tmp.$$"
  mv "$cache_dir/$asset.tmp.$$" "$cache_dir/$asset"
fi
actual_asset_sha256="$(shasum -a 256 "$cache_dir/$asset" | awk '{print $1}')"
if [[ -z "$expected_asset_sha256" \
  || "$actual_asset_sha256" != "$expected_asset_sha256" ]]; then
  printf 'Hugo archive does not match the pinned release manifest.\n' >&2
  exit 1
fi

extract_dir="$(mktemp -d "$cache_dir/.extract.XXXXXX")"
trap 'rm -rf "$extract_dir"' EXIT
tar -xzf "$cache_dir/$asset" -C "$extract_dir" hugo
install -m 0755 "$extract_dir/hugo" "$binary"
printf '%s\n' "$binary"

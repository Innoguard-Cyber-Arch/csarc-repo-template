#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "--check" ]]; }; then
  printf 'Usage: scripts/build-decision-site [--check]\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 "$repo_root/scripts/check-decision-site-navigation"
python3 "$repo_root/scripts/check-decision-site-versions"

build_dir="$repo_root/dist/decision-site"
python3 "$repo_root/scripts/build_decision_site.py" \
  --root "$repo_root" \
  --output-dir "$build_dir"

sources=("$build_dir/index.html" "$build_dir/index.en.html")
outputs=(docs/index.html docs/index.en.html)

for index in 0 1; do
  render_args=(
    --root "$repo_root"
    --source "${sources[$index]}"
    --output "${outputs[$index]}"
  )
  if (($# == 1)); then
    render_args+=(--check)
  fi
  python3 "$repo_root/scripts/render_site.py" "${render_args[@]}"
done

llms_source="$build_dir/llms.txt"
llms_outputs=(llms.txt docs/llms.txt)

if (($# == 1)); then
  for output in "${llms_outputs[@]}"; do
    if ! cmp -s "$llms_source" "$repo_root/$output"; then
      printf '%s is stale; run scripts/build-decision-site\n' "$output" >&2
      exit 1
    fi
  done
else
  for output in "${llms_outputs[@]}"; do
    cp "$llms_source" "$repo_root/$output"
  done
fi

printf 'Decision site: %s, %s\n' \
  "$repo_root/${outputs[0]}" "$repo_root/${outputs[1]}"
printf 'LLM indexes: %s, %s\n' \
  "$repo_root/${llms_outputs[0]}" "$repo_root/${llms_outputs[1]}"

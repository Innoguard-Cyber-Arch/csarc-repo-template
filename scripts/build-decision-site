#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ "$1" != "--check" ]]; }; then
  printf 'Usage: scripts/build-decision-site [--check]\n' >&2
  exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hugo_bin="$("$repo_root/scripts/install-hugo")"

python3 "$repo_root/scripts/check-decision-site-navigation"

"$hugo_bin" \
  --source "$repo_root" \
  --config site/hugo.toml \
  --destination "$repo_root/dist/hugo-site" \
  --cleanDestinationDir \
  --noBuildLock \
  --environment production \
  --quiet

sources=(dist/hugo-site/index.html dist/hugo-site/en/index.html)
outputs=(docs/index.html docs/index.en.html)

for index in 0 1; do
  render_args=(
    --root "$repo_root"
    --source "${sources[$index]}"
    --output "${outputs[$index]}"
  )
  if (($# == 1)); then
    render_args+=(--check)
  fi
  python3 "$repo_root/scripts/render_site.py" "${render_args[@]}"
done

# Keep an ignored, bundled copy of the replaced page for visual regression checks.
python3 "$repo_root/scripts/render_site.py" \
  --root "$repo_root" \
  --source dist/hugo-site/fidelity.html \
  --output dist/hugo-fidelity.html

llms_source=dist/hugo-site/llms.txt
llms_translation_source=dist/hugo-site/en/llms.txt
llms_outputs=(llms.txt docs/llms.txt)

if ! cmp -s "$repo_root/$llms_source" "$repo_root/$llms_translation_source"; then
  printf 'Bilingual Hugo builds produced different llms.txt indexes.\n' >&2
  exit 1
fi

if (($# == 1)); then
  for output in "${llms_outputs[@]}"; do
    if ! cmp -s "$repo_root/$llms_source" "$repo_root/$output"; then
      printf '%s is stale; run scripts/build-decision-site\n' "$output" >&2
      exit 1
    fi
  done
else
  for output in "${llms_outputs[@]}"; do
    cp "$repo_root/$llms_source" "$repo_root/$output"
  done
fi

printf 'Decision site: %s, %s\n' \
  "$repo_root/${outputs[0]}" "$repo_root/${outputs[1]}"
printf 'Legacy visual baseline: %s\n' "$repo_root/dist/hugo-fidelity.html"
printf 'LLM indexes: %s, %s\n' \
  "$repo_root/${llms_outputs[0]}" "$repo_root/${llms_outputs[1]}"

#!/usr/bin/env bash
set -euo pipefail

# Ensure exactly one tag and one draft Release exist for a release candidate
# SHA, converging a repeated or resent event to the same single outcome
# instead of creating a duplicate. Extracted from .github/workflows/release.yml
# so the convergence logic can be exercised directly by
# tests/test_release_convergence.py against a fake `gh`, not only asserted to
# exist in the workflow source.

usage() {
  echo "Usage: $0 --repo OWNER/NAME --sha SHA --tag TAG" >&2
  exit 2
}

repo=""
sha=""
tag=""
while (($#)); do
  case "$1" in
    --repo)
      repo="$2"
      shift 2
      ;;
    --sha)
      sha="$2"
      shift 2
      ;;
    --tag)
      tag="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done
[[ -n "$repo" && -n "$sha" && -n "$tag" ]] || usage
if ! [[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-beta\.[1-9][0-9]*)?$ ]]; then
  echo "Unsupported release tag: $tag" >&2
  exit 1
fi

if tag_sha="$(gh api "repos/$repo/git/ref/tags/$tag" --jq .object.sha 2>/dev/null)"; then
  test "$tag_sha" = "$sha"
else
  gh api --method POST "repos/$repo/git/refs" \
    -f ref="refs/tags/$tag" -f sha="$sha" >/dev/null
fi

if ! gh release view "$tag" >/dev/null 2>&1; then
  # Issue #918: a `-beta.N` tag must be created as a GitHub
  # prerelease so release_identity()'s prerelease-flag/tag-shape
  # consistency check (src/csarc_cli/cli.py) and the CLI's SemVer-
  # precedence "latest" selection both see a self-consistent Release.
  # This pattern must stay byte-identical to scripts/release_phase.py's
  # canonical `_VERSION_RE` suffix (`N` never 0 or zero-padded) and to
  # the matching checks in scripts/publish-release and
  # scripts/check-release-drift -- there is no shared regex source
  # between bash and Python here, so all four copies are kept in sync by
  # hand and by
  # tests/test_release_phase.py::test_prerelease_suffix_regex_is_consistent_everywhere.
  prerelease_flags=()
  if [[ "$tag" =~ -beta\.[1-9][0-9]*$ ]]; then
    prerelease_flags=(--prerelease)
  fi
  gh release create "$tag" --target "$sha" \
    --title "$tag" --draft --generate-notes "${prerelease_flags[@]}"
fi

#!/usr/bin/env python3
"""Verify that the repo-site translations have the same structure."""

from __future__ import annotations

import argparse
import runpy
import sys
import tomllib
from pathlib import Path
from typing import Final

LANGUAGE_FILES = ("_index.zh-tw.md", "_index.en.md")
type Shape = str | dict[str, "Shape"]
type Block = tuple[str, str, tuple[str, ...]]

# Shared with scripts/build_repo_site.py so the two only-Hugo-block-
# syntax consumers (this shape checker and the render engine) parse
# `{{< name attr="value" >}}...{{< /name >}}` the same way instead of each
# keeping its own regex.
_BLOCKS: Final = runpy.run_path(
    str(Path(__file__).resolve().parent / "repo_site_blocks.py")
)
BLOCK = _BLOCKS["BLOCK"]
ATTRIBUTE = _BLOCKS["ATTRIBUTE"]
NESTED_BLOCK = _BLOCKS["NESTED_BLOCK"]


def shape(value: object) -> Shape:
    """Return only the nested keys and value types from front matter."""
    if isinstance(value, dict):
        return {key: shape(child) for key, child in value.items()}
    if isinstance(value, str) and not value.strip():
        raise ValueError(
            "Bad front matter: a text is empty. Write the empty value."
        )
    return type(value).__name__


def read_source(path: Path) -> tuple[Shape, list[Block]]:
    """Read one source and return its front-matter and ordered content keys."""
    text = path.read_text(encoding="utf-8")
    parts = text.split("+++", 2)
    if len(parts) != 3 or parts[0].strip():
        raise ValueError(
            f"{path}: no TOML front matter. Start the file with '+++'."
        )
    metadata = tomllib.loads(parts[1])
    blocks: list[Block] = []
    seen_keys: set[str] = set()
    for block_type, raw_attributes, body in BLOCK.findall(parts[2]):
        attributes = dict(ATTRIBUTE.findall(raw_attributes))
        key = attributes.get("key", "")
        if not key:
            raise ValueError(
                f"{path}: {block_type} has no key. Add 'key=...' to it."
            )
        if not attributes.get("title", "").strip():
            raise ValueError(
                f"{path}: {block_type} {key!r} has no title. Add 'title=...'."
            )
        if any(not value.strip() for value in attributes.values()):
            raise ValueError(
                f"{path}: {block_type} {key!r} has a blank. "
                "Fill each attribute."
            )
        if not body.strip():
            raise ValueError(
                f"{path}: {block_type} {key!r} has no body. Write its body."
            )
        if block_type == "slide" and not NESTED_BLOCK.sub("", body).strip():
            raise ValueError(
                f"{path}: slide {key!r} has no direct body. "
                "Add text outside blocks."
            )
        if key in seen_keys:
            raise ValueError(
                f"{path}: {key!r} repeats. Give each block its own key."
            )
        seen_keys.add(key)
        blocks.append((block_type, key, tuple(sorted(attributes))))
    if not blocks:
        raise ValueError(
            f"{path}: no keyed sections. Add a block with 'key=...'."
        )
    return shape(metadata), blocks


def main() -> int:
    """Compare both language sources and report the first structural drift."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--content-dir", type=Path, default=Path("site/content")
    )
    args = parser.parse_args()
    try:
        sources = [
            read_source(args.content_dir / name) for name in LANGUAGE_FILES
        ]
    except (
        OSError,
        UnicodeError,
        ValueError,
        tomllib.TOMLDecodeError,
    ) as error:
        sys.stderr.write(f"ERROR: {error}\n")
        return 1
    if sources[0][0] != sources[1][0]:
        sys.stderr.write(
            "ERROR: Translations differ: front matter. Use the same keys.\n"
        )
        return 1
    if sources[0][1] != sources[1][1]:
        sys.stderr.write(
            "ERROR: Translations differ: content keys. Use the same blocks.\n"
        )
        return 1
    sys.stdout.write(
        f"OK: Repo-site translations match: {len(sources[0][1])} blocks.\n"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

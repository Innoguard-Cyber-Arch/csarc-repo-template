#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"

# Print one ERROR message and stop (#1253).
fail() {
  echo "ERROR: $1" >&2
  exit 1
}

if [[ ! "$PR_TITLE" =~ ^(feat|fix|docs|refactor|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?(!)?:\ .+ ]]; then
  fail "PR title: not 'type(scope): summary'. Use type feat, fix, docs, refactor, test, build, ci, chore, or revert, and an optional scope of lowercase letters, numbers, '.', '_', '/', or '-'."
fi
pr_title_type="${BASH_REMATCH[1]}"
if printf '%s' "$PR_TITLE" | LC_ALL=C grep -q '[^ -~]'; then
  fail "PR title: non-ASCII characters. Use ASCII only; the PR body can use Chinese."
fi

if [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]]; then
  pr_assignees="${PR_ASSIGNEES:-${PR_AUTHOR:-}}"
  pr_milestone_number="${PR_MILESTONE_NUMBER:-${PR_ISSUE_MILESTONE_NUMBER:-0}}"
else
  if ! pr_payload="$(${GH_BINARY:-gh} api --method GET \
    "repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER")" || \
    [[ -z "$pr_payload" ]]; then
    fail "Pull request metadata: cannot read it. Retry the check."
  fi
  if ! jq -e '
    type == "object" and
    (.labels | type) == "array" and (.labels | length) > 0 and
    all(.labels[]; type == "object" and (.name | type) == "string" and (.name | length) > 0) and
    (.assignees | type) == "array" and
    all(.assignees[]; type == "object" and (.login | type) == "string" and (.login | length) > 0) and
    has("milestone") and
    (.milestone == null or ((.milestone | type) == "object" and (.milestone.number | type) == "number" and .milestone.number > 0 and .milestone.number == (.milestone.number | floor))) and
    has("body") and (.body == null or (.body | type) == "string")
  ' <<<"$pr_payload" >/dev/null; then
    fail "Pull request metadata: incomplete or malformed. Retry the check."
  fi
  PR_LABELS="$(jq -r '[.labels[].name] | join(",")' <<<"$pr_payload")"
  pr_assignees="$(jq -r '[.assignees[].login] | join(",")' <<<"$pr_payload")"
  pr_milestone_number="$(jq -r '.milestone.number // 0' <<<"$pr_payload")"
  PR_BODY="$(jq -r '.body // ""' <<<"$pr_payload")"
fi

release_intent="no-release"
if [[ "$PR_TITLE" =~ ^[^:]+!:\  ]]; then
  release_intent="major"
elif [[ "$pr_title_type" == "feat" ]]; then
  release_intent="minor"
elif [[ "$pr_title_type" == "fix" || "$pr_title_type" == "revert" ]]; then
  release_intent="patch"
fi
release_message="Release intent: ${release_intent}; exact version is allocated at the reviewed release boundary."
echo "NOTICE: $release_message"
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  echo "$release_message" >> "$GITHUB_STEP_SUMMARY"
fi

selected_label=""
selected_count=0
for label in bug enhancement documentation; do
  if [[ ",${PR_LABELS:-}," == *",${label},"* ]]; then
    selected_label="$label"
    selected_count=$((selected_count + 1))
  fi
done
if (( selected_count != 1 )); then
  fail "PR label: not exactly one classification label. Select bug, enhancement, or documentation."
fi
if [[ ",${PR_LABELS:-}," == *,duplicate,* ]]; then
  fail "PR label: 'duplicate' is an Issue disposition. Remove it."
fi

validate_documentation_review() {
  local required="${PR_DOCUMENTATION_REVIEW_REQUIRED:-true}"
  if [[ "${PR_POLICY_FIXTURE:-false}" == "true" &&
    -z "${PR_DOCUMENTATION_REVIEW_REQUIRED+x}" ]]; then
    required=false
  fi
  local cutover="${PR_DOCUMENTATION_REVIEW_CUTOVER_PR:-1}"
  if [[ ! "$cutover" =~ ^[0-9]+$ ]]; then
    fail "PR_DOCUMENTATION_REVIEW_CUTOVER_PR: not a non-negative integer. Fix the workflow env."
  fi
  if [[ "${PR_DRAFT:-false}" != "true" && "$required" == "true" &&
    "$PR_NUMBER" -ge "$cutover" ]]; then
    local documentation_mode
    documentation_mode="$(python3 "$script_dir/csarc_config.py" documentation_mode)"
    DOCUMENTATION_MODE="$documentation_mode" \
      PR_BODY="${PR_BODY:-}" \
      PR_HEAD_SHA="${PR_HEAD_SHA:-}" \
      python3 "$script_dir/documentation_review.py"
  fi
}

validate_large_test_justification() {
  # A net new @pytest.mark.large test must state what it replaces or why a
  # smaller test cannot cover it; see docs/ci-policy.md's verification-cost
  # section (#999). Like the checklist gate, it applies once not a draft.
  if [[ "${PR_DRAFT:-false}" == "true" || "${promotion:-false}" == "true" ]]; then
    return 0
  fi
  local files_json
  if [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]]; then
    [[ "${PR_CHANGED_FILES_JSON+x}" == "x" ]] || return 0
    files_json="$PR_CHANGED_FILES_JSON"
  elif ! files_json="$(
    gh api --paginate --slurp \
      "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/files?per_page=100"
  )"; then
    fail "Large-test check: cannot read the file list. Retry the check."
  fi
  if ! PR_BODY="${PR_BODY:-}" python3 "$script_dir/verification_cost.py" \
    check-large-justification --files-json - <<<"$files_json"; then
    exit 1
  fi
}

validate_requirement_trace() {
  # SPEC-010: the trusted lifecycle checks a Ready work pull request's trace.
  local default=true
  [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]] && default=false
  [[ "${PR_DRAFT:-false}" != "true" && "${promotion:-false}" != "true" &&
    "${PR_REQUIREMENT_TRACE_REQUIRED:-$default}" == "true" ]] || return 0
  python3 "$script_dir/pr_lifecycle.py" trace --repo "$GITHUB_REPOSITORY" \
    --pr-number "$PR_NUMBER" --head-sha "${PR_HEAD_SHA:-}" || exit 1
}

validate_governance_route() {
  # Issue #1069: changing .csarc/scripts or relaxing a governance value only
  # lands through the governance-switch route. This trusted base reads both
  # configurations and decides; the candidate's own rules never run here.
  # A promotion re-lands work that was already routed into its branch.
  if [[ "${promotion:-false}" == "true" ]]; then
    return 0
  fi
  local scratch files_json candidate_config provenance
  scratch="$(mktemp -d)"
  files_json="$scratch/pull-files.json"
  candidate_config="$scratch/candidate-config.yml"
  provenance="$scratch/candidate-provenance.json"
  if [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]]; then
    if [[ "${PR_CANDIDATE_CONFIG+x}" != "x" ]]; then
      rm -rf "$scratch"
      return 0
    fi
    printf '%s\n' "${PR_CHANGED_FILES_JSON:-[[]]}" >"$files_json"
    printf '%s\n' "$PR_CANDIDATE_CONFIG" >"$candidate_config"
  else
    if ! gh api --paginate --slurp \
      "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/files?per_page=100" \
      >"$files_json"; then
      rm -rf "$scratch"
      fail "Governance route: cannot read the file list. Retry the check."
    fi
    if ! gh api "repos/$GITHUB_REPOSITORY/contents/.csarc/config.yml?ref=$PR_HEAD_SHA" \
      --jq '.content' |
      python3 -c 'import base64, sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' \
        >"$candidate_config"; then
      rm -rf "$scratch"
      fail "Governance route: cannot read the candidate configuration. Retry the check."
    fi
    # Issue #1239: names the release whose schema may judge new settings.
    gh api -H "Accept: application/vnd.github.raw+json" >"$provenance" \
      "repos/$GITHUB_REPOSITORY/contents/.csarc/provenance.json?ref=$PR_HEAD_SHA" || true
  fi
  if ! python3 "$script_dir/trusted_executor.py" route \
    --base-config "$repo_root/.csarc/config.yml" \
    --candidate-config "$candidate_config" \
    --candidate-provenance "$provenance" \
    --pull-files "$files_json" \
    --labels "${PR_LABELS:-}" \
    --enforce; then
    rm -rf "$scratch"
    exit 1
  fi
  rm -rf "$scratch"
}

# Delivery routing is derived from trusted Issue and Milestone metadata.
branch_strategy="delivery"
release_ownership="${PR_RELEASE_OWNERSHIP:-}"
if [[ -z "$release_ownership" ]]; then
  # The saved release_ownership is the only authority (Issue #1068): the
  # shared reader fails closed with a stable error that points to
  # `csarc update` when the value is missing, unknown, or contradictory,
  # instead of re-deriving an owner from project_mode or defaults.
  if ! release_ownership="$(python3 scripts/csarc_config.py release_ownership)"; then
    exit 1
  fi
fi
if [[ "$release_ownership" != "csarc-owned" &&
  "$release_ownership" != "product-owned" &&
  "$release_ownership" != "verification-only" ]]; then
  fail "release_ownership: invalid value. Use csarc-owned, product-owned, or verification-only."
fi
delivery_cutover_issue="${PR_DELIVERY_CUTOVER_ISSUE:-0}"
if [[ ! "$delivery_cutover_issue" =~ ^[0-9]+$ ]]; then
  fail "PR_DELIVERY_CUTOVER_ISSUE: not a non-negative integer. Fix the workflow env."
fi

release_recovery=false
if [[ ",${PR_LABELS:-}," == *,release-recovery,* ]]; then
  if [[ "$pr_title_type" != "fix" || "$PR_HEAD" != fix/* || "$PR_BASE" != "main" || ",${PR_LABELS:-}," == *,hotfix,* ]]; then
    fail "Release recovery: invalid route. Use a fix/* branch to main with a fix title and no hotfix label."
  fi
  release_recovery=true
fi

if [[ ",${PR_LABELS:-}," == *,hotfix,* ]] && \
  [[ "$pr_title_type" != "fix" || "$PR_HEAD" != fix/* || "$PR_BASE" != "main" ]]; then
  fail "Hotfix: invalid route. Use a fix/* branch to main with a fix title."
fi

if [[ "$PR_BASE" == "main" ]] &&
  [[ "$PR_HEAD" == release-please--* || "$PR_HEAD" == release/v* ]]; then
  validate_documentation_review
  if [[ "$release_ownership" != "csarc-owned" ]]; then
    echo "NOTICE: Release ownership is $release_ownership, so the CSARC release follow-up policy does not apply."
    exit 0
  fi
  if [[ "$PR_HEAD" == release/v* ]]; then
    guided_version="${PR_HEAD#release/v}"
    if [[ ! "$guided_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-beta\.[1-9][0-9]*)?$ ]] ||
      [[ "$PR_TITLE" != "chore(main): release $guided_version" ]]; then
      fail "Guided release: invalid route. Use release/v<version> and the matching chore(main) title."
    fi
  fi
  release_files="${RUNNER_TEMP:-/tmp}/release-follow-up-files-${GITHUB_RUN_ID:-$$}.txt"
  gh api --paginate \
    "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/files?per_page=100" \
    --jq '.[] | .filename, (.previous_filename // empty)' \
    > "$release_files"
  release_commits="${RUNNER_TEMP:-/tmp}/release-follow-up-commits-${GITHUB_RUN_ID:-$$}.json"
  gh api --paginate --slurp \
    "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/commits?per_page=100" \
    > "$release_commits"
  actor_permission=""
  if [[ "$PR_AUTHOR" != "github-actions[bot]" ]]; then
    encoded_actor="$(jq -rn --arg value "$PR_AUTHOR" '$value | @uri')"
    actor_permission="$(
      gh api "repos/$GITHUB_REPOSITORY/collaborators/$encoded_actor/permission" \
        --jq '.permission // empty'
    )"
  fi
  python3 scripts/release_policy.py verify-release-follow-up \
    --repo "$GITHUB_REPOSITORY" \
    --head "$PR_HEAD" \
    --head-repo "$PR_HEAD_REPOSITORY" \
    --head-sha "$PR_HEAD_SHA" \
    --actor "$PR_AUTHOR" \
    --actor-permission "$actor_permission" \
    --changed-files "$release_files" \
    --commits "$release_commits"
  rm "$release_files" "$release_commits"
  exit 0
fi
if [[ "$branch_strategy" == "delivery" ]]; then
  if [[ "$PR_HEAD" =~ ^sync/main-to-(m[0-9]+-[a-z0-9][a-z0-9-]*|i[0-9]+-[a-z0-9][a-z0-9-]*)-[0-9a-f]{7,40}$ ]]; then
    if [[ "$PR_BASE" == "dev/${BASH_REMATCH[1]}" ]]; then
      exit 0
    fi
    fail "Main sync branch: wrong base. Target its matching delivery branch."
  fi

  if [[ "$PR_HEAD" == dependabot/* || "$PR_HEAD" == automation/* ]]; then
    if [[ "$PR_BASE" == "main" ]]; then
      exit 0
    fi
    fail "Automated maintenance: wrong base. Target main."
  fi

  promotion_milestone=""
  promotion=false
  tracker_promotion=false
  deferred_tracker_close=false
  if [[ "$PR_BASE" == "main" && "$PR_HEAD" =~ ^dev/m([0-9]+)-[a-z0-9][a-z0-9-]*$ ]]; then
    promotion=true
    promotion_milestone="${BASH_REMATCH[1]}"
  elif [[ "$PR_BASE" == "main" && "$PR_HEAD" =~ ^promote/m([0-9]+)-[a-z0-9][a-z0-9-]*$ ]]; then
    if [[ ",${PR_LABELS:-}," != *,promotion,* ]]; then
      fail "Promotion bridge: no promotion label. Add it."
    fi
    promotion=true
    tracker_promotion=true
    promotion_milestone="${BASH_REMATCH[1]}"
  elif [[ "$PR_BASE" == "main" && "$PR_HEAD" =~ ^dev/i([0-9]+)-[a-z0-9][a-z0-9-]*$ ]]; then
    promotion=true
    promotion_issue="${BASH_REMATCH[1]}"
  fi
  if [[ -n "$promotion_milestone" && ! -f scripts/promotion_gate.py ]]; then
    fail "Milestone promotion: needs lifecycle: milestones. Set it."
  fi
  if [[ "$promotion" == "true" && ",${PR_LABELS:-}," != *,promotion,* ]]; then
    fail "Delivery promotion: no promotion label. Add it."
  fi
  if [[ "$PR_HEAD" == dev/m* && "$release_ownership" == "csarc-owned" ]]; then
    fail "CSARC-owned Milestone: no promote/m* bridge. Use one so the delivery PR reviews the version."
  fi
  if [[ "$tracker_promotion" == "true" && "$release_ownership" == "csarc-owned" ]]; then
    deferred_tracker_close=true
  fi
elif [[ "$PR_HEAD" == dependabot/* || "$PR_HEAD" == automation/* ]]; then
  exit 0
fi

branch_pattern='^(feat|fix|docs|refactor|test|build|ci|chore|revert)/([0-9]+)-[a-z0-9][a-z0-9-]*$'
if [[ "${promotion:-false}" == "true" ]]; then
  if [[ "${deferred_tracker_close:-false}" == "true" ]]; then
    tracker_issue_pattern='([Rr][Ee][Ff][Ss])[[:space:]]+#([0-9]+)([^0-9]|$)'
    closing_issue_pattern='(Closes|Fixes|Resolves)[[:space:]]+#[0-9]+([^0-9]|$)'
    if [[ ! "${PR_BODY:-}" =~ $tracker_issue_pattern ]]; then
      fail "Milestone promotion: no tracker reference. Add 'Refs #N'."
    fi
    issue_number="${BASH_REMATCH[2]}"
    if [[ "${PR_BODY:-}" =~ $closing_issue_pattern ]]; then
      fail "Milestone promotion: closes its tracker before release. Use 'Refs #N'."
    fi
  else
    closing_issue_pattern='(Closes|Fixes|Resolves)[[:space:]]+#([0-9]+)([^0-9]|$)'
    if [[ ! "${PR_BODY:-}" =~ $closing_issue_pattern ]]; then
      fail "Delivery promotion: does not close its promotion Issue. Add 'Closes #N'."
    fi
    issue_number="${BASH_REMATCH[2]}"
  fi
else
  if [[ ! "$PR_HEAD" =~ $branch_pattern ]]; then
    fail "Branch: invalid name. Use 'type/<issue-number>-short-slug'."
  fi
  issue_number="${BASH_REMATCH[2]}"
  issue_link_pattern="(Closes|Fixes|Resolves)[[:space:]]+#${issue_number}([^[:alnum:]_]|$)"
  if [[ ! "${PR_BODY:-}" =~ $issue_link_pattern ]]; then
    fail "PR body: no closing keyword. Add 'Closes #${issue_number}'."
  fi
fi
unchecked_task_pattern='^[[:space:]]*-[[:space:]]+\[[[:space:]]*\]'
# The acceptance-checklist gate (this PR-body check and the linked Issue check
# below) only enforces completeness once a pull request is not a draft: a
# draft cannot be merged anyway, so re-validating an admittedly-unfinished
# checklist on every push while still drafting only produces certain,
# repeated failures (#430, PR #448 needed 49 pushes before the checklist was
# actually done). Marking the pull request ready for review re-triggers this
# workflow (`ready_for_review`) and revalidates in full; see docs/ci-policy.md's
# "Acceptance-checklist 驗證時機（#573）" section.
pr_draft="${PR_DRAFT:-false}"
if [[ "$pr_draft" == "true" ]]; then
  # message-pattern: allow X1 workflow annotation
  echo "::notice::Skipping acceptance-checklist validation while the pull request is a draft; it revalidates in full when marked ready for review."
fi
validate_documentation_review
if [[ "$pr_draft" != "true" ]] && grep -Eq "$unchecked_task_pattern" <<<"${PR_BODY:-}"; then
  fail "PR checklist: unchecked items. Complete every item."
fi
validate_large_test_justification
validate_governance_route

if [[ "${PR_ISSUE_STATE+x}" == "x" ]]; then
  issue_state="$PR_ISSUE_STATE"
  issue_title="${PR_ISSUE_TITLE:-}"
  issue_body="${PR_ISSUE_BODY:-}"
  issue_milestone_number="${PR_ISSUE_MILESTONE_NUMBER:-0}"
  issue_labels="${PR_ISSUE_LABELS-$PR_LABELS}"
  issue_type="${PR_ISSUE_TYPE:-}"
  issue_assignees="${PR_ISSUE_ASSIGNEES:-}"
  issue_has_unchecked=false
  if grep -Eq "$unchecked_task_pattern" <<<"$issue_body"; then
    issue_has_unchecked=true
  fi
else
  issue_payload="$(
    gh api "repos/$GITHUB_REPOSITORY/issues/$issue_number" \
      --jq 'select(.pull_request | not) | [.state, .title, ((.body // "") | test("(?m)^\\s*-\\s+\\[\\s*\\]")), (.milestone.number // 0), (([.labels[].name] | join(",")) | if . == "" then "-" else . end), (.type.name // "-"), (([.assignees[].login] | join(",")) | if . == "" then "-" else . end)] | @tsv' \
      2>/dev/null || true
  )"
  IFS=$'\t' read -r issue_state issue_title issue_has_unchecked \
    issue_milestone_number issue_labels issue_type issue_assignees \
    <<<"$issue_payload"
  [[ "$issue_labels" == "-" ]] && issue_labels=""
  [[ "$issue_type" == "-" ]] && issue_type=""
  [[ "$issue_assignees" == "-" ]] && issue_assignees=""
  if [[ "${tracker_promotion:-false}" == "true" ]]; then
    issue_body="$(
      gh api "repos/$GITHUB_REPOSITORY/issues/$issue_number" \
        --jq 'select(.pull_request | not) | .body // ""' \
        2>/dev/null || true
    )"
  fi
fi
if [[ "$issue_state" != "open" ]]; then
  fail "Issue #${issue_number}: missing or closed. Reopen it until merge."
fi
if [[ -z "$pr_assignees" ]]; then
  fail "Pull request: no assignee. Assign its human author."
fi
if [[ -n "${PR_AUTHOR:-}" && ",${pr_assignees}," != *",${PR_AUTHOR},"* ]]; then
  fail "Pull request: author is not an assignee. Assign the author."
fi
if [[ "$pr_milestone_number" != "$issue_milestone_number" ]]; then
  fail "Pull request Milestone: differs from Issue #${issue_number}. Run 'gh api repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER} --method PATCH -F milestone=${issue_milestone_number/#0/null}'."
fi
if [[ "$pr_milestone_number" == "0" && "$issue_milestone_number" == "0" && "${PR_POLICY_READ_ONLY:-false}" != "true" ]]; then
  # Issue #551: the match check above only catches a Milestone
  # *mismatch*; it cannot catch "both silently unset", which is exactly
  # how #546-#550 slipped through during Milestone 8 cleanup. This is a
  # non-blocking nudge only -- many Issues/pull requests genuinely have
  # nothing to do with any Milestone (see Issue #551's boundary section)
  # -- so it must never fail this check, only make the omission visible
  # once via a pull request comment. It shares the same "exactly one open
  # Milestone" heuristic as scripts/gh-issue-create's local prompt, via
  # scripts/detect-open-milestone, so the two safeguards never drift on
  # what counts as "detected". See docs/ci-policy.md's Milestone
  # safeguard section.
  if milestone_hint="$(./scripts/detect-open-milestone --repo "$GITHUB_REPOSITORY" 2>/dev/null)"; then
    hint_number="${milestone_hint%%$'\t'*}"
    hint_title="${milestone_hint#*$'\t'}"
    reminder_marker="<!-- csarc-milestone-safeguard:551 -->"
    # A bare `var="$(cmd)"` assignment is NOT exempt from `set -e` the way
    # an `if`/`&&` condition is -- a failing gh call here would otherwise
    # abort this entire policy check, which is exactly the fail-closed
    # behavior this safeguard must never have. The "||" fallback keeps a
    # transient listing failure from doing anything worse than a rare
    # duplicate reminder comment.
    existing_comment_bodies="$(
      gh api --paginate "repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments" \
        --jq '[.[].body]' 2>/dev/null
    )" || existing_comment_bodies="[]"
    [[ -z "$existing_comment_bodies" ]] && existing_comment_bodies="[]"
    if ! jq -e --arg marker "$reminder_marker" \
      'type == "array" and any(.[]; type == "string" and contains($marker))' \
      <<<"$existing_comment_bodies" >/dev/null 2>&1; then
      reminder_body="${reminder_marker}
Neither this pull request nor Issue #${issue_number} has a Milestone, and exactly one Milestone is currently open: #${hint_number} ${hint_title}.

If this work belongs to it, attach the Milestone to the Issue (see docs/ci-policy.md, section \"Milestone 掛勾與持續同步\", for the closed-Milestone REST API workaround) and to this pull request. Otherwise no action is needed -- many Issues and pull requests are not tied to any Milestone."
      if ! gh issue comment "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" \
        --body "$reminder_body" >/dev/null 2>&1; then
        # message-pattern: allow X1 workflow annotation
        echo "::notice::Could not post the Milestone safeguard reminder (non-blocking, Issue #551)."
      fi
    fi
  fi
fi
issue_selected_label=""
issue_selected_count=0
for label in bug enhancement documentation; do
  if [[ ",${issue_labels:-}," == *",${label},"* ]]; then
    issue_selected_label="$label"
    issue_selected_count=$((issue_selected_count + 1))
  fi
done
if (( issue_selected_count > 1 )); then
  fail "Issue #${issue_number}: conflicting classification labels. Keep one."
fi
issue_expected_label=""
case "$issue_type" in
  Bug) issue_expected_label="bug" ;;
  Feature) issue_expected_label="enhancement" ;;
  Task)
    if [[ "$issue_selected_label" == "documentation" ]]; then
      issue_expected_label="documentation"
    else
      issue_expected_label="enhancement"
    fi
    ;;
  "") issue_expected_label="$issue_selected_label" ;;
  *)
    fail "Issue #${issue_number}: unsupported native Type. Use Bug, Feature, or Task."
    ;;
esac
issue_fix="python3 scripts/pr_lifecycle.py issue-edit --repo ${GITHUB_REPOSITORY} --issue-number ${issue_number}"
if [[ -n "$issue_type" && -n "$issue_selected_label" && "$issue_selected_label" != "documentation" ]]; then
  fail "Issue #${issue_number}: work-kind label repeats its Type. Run '${issue_fix} --remove-label ${issue_selected_label}'."
fi
# Issue #1344: local and self-hosted modes have no hosted work-item
# automation to turn an Issue form's fallback label into a native Type or to
# assign the Issue, so the local lifecycle check requires both itself. A
# repository without Issue Types (or an unreadable count) keeps the fallback
# label path.
if [[ "${PR_POLICY_LOCAL:-}" == "true" ]]; then
  if [[ -z "$issue_type" && "${PR_REPO_ISSUE_TYPES-$(gh api graphql -f query="{repository(owner:\"${GITHUB_REPOSITORY%%/*}\",name:\"${GITHUB_REPOSITORY#*/}\"){issueTypes(first:1){totalCount}}}" --jq .data.repository.issueTypes.totalCount 2>/dev/null || true)}" =~ ^[1-9] ]]; then
    case "$issue_selected_label" in
      bug) type_fix="Bug --remove-label bug" ;;
      enhancement) type_fix="Feature --remove-label enhancement" ;;
      documentation) type_fix="Task" ;;
      *) type_fix="<Bug|Feature|Task>" ;;
    esac
    fail "Issue #${issue_number}: no native Type. Run '${issue_fix} --type ${type_fix}'."
  fi
  if [[ -z "$issue_assignees" ]]; then
    fail "Issue #${issue_number}: no assignee. Run '${issue_fix} --add-assignee @me'."
  fi
fi
if [[ -z "$issue_expected_label" || "$selected_label" != "$issue_expected_label" ]]; then
  fail "PR label: differs from Issue #${issue_number}'s Type or label. Match it."
fi
development_cutover_pr="${PR_DEVELOPMENT_CUTOVER_PR:-1}"
if [[ ! "$development_cutover_pr" =~ ^[0-9]+$ || ! "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
  fail "PR_DEVELOPMENT_CUTOVER_PR or PR_NUMBER: not a non-negative integer. Fix the workflow env."
fi
if [[ "${promotion:-false}" != "true" ]] && (( PR_NUMBER >= development_cutover_pr )); then
  if [[ "$PR_BASE" == "main" ]]; then
    if [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]]; then
      if [[ "${PR_CLOSING_ISSUES_JSON+x}" == "x" ]]; then
        closing_issues="$PR_CLOSING_ISSUES_JSON"
      else
        closing_issues="$(
          jq -cn \
            --arg repo "$GITHUB_REPOSITORY" \
            --argjson pr "$PR_NUMBER" \
            --argjson issue "$issue_number" \
            '{data: {repository: {pullRequest: {number: $pr, closingIssuesReferences: {nodes: [{number: $issue, repository: {nameWithOwner: $repo}}], pageInfo: {hasNextPage: false}}}}}}'
        )"
      fi
    else
      repo_owner="${GITHUB_REPOSITORY%%/*}"
      repo_name="${GITHUB_REPOSITORY#*/}"
      if ! closing_issues="$(
        # shellcheck disable=SC2016 # GraphQL variables must remain literal.
        gh api graphql \
          -f query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){number closingIssuesReferences(first:100){nodes{number repository{nameWithOwner}} pageInfo{hasNextPage}}}}}' \
          -f owner="$repo_owner" -f name="$repo_name" -F number="$PR_NUMBER"
      )" || [[ -z "$closing_issues" ]]; then
        fail "Closing Issue relationship: cannot read it. Retry the check."
      fi
    fi
    if ! jq -e \
      --arg repo "$GITHUB_REPOSITORY" \
      --argjson pr "$PR_NUMBER" \
      --argjson issue "$issue_number" '
        .data.repository.pullRequest as $pull |
        ($pull | type == "object") and
        ($pull.number == $pr) and
        ($pull.closingIssuesReferences | type == "object") and
        ($pull.closingIssuesReferences.nodes | type == "array") and
        ($pull.closingIssuesReferences.nodes | length == 1) and
        ($pull.closingIssuesReferences.pageInfo.hasNextPage == false) and
        ($pull.closingIssuesReferences.nodes[0] |
          type == "object" and
          .number == $issue and
          (.repository | type == "object") and
          (.repository.nameWithOwner | type == "string") and
          ((.repository.nameWithOwner | ascii_downcase) == ($repo | ascii_downcase)))
      ' <<<"$closing_issues" >/dev/null; then
      fail "PR #${PR_NUMBER}: not exactly one closing Issue link to ${GITHUB_REPOSITORY}#${issue_number}. Fix the PR body."
    fi
  else
    body_closing_issues=()
    while IFS= read -r body_closing_issue; do
      [[ -n "$body_closing_issue" ]] && body_closing_issues+=("$body_closing_issue")
    done < <(
      python3 -c 'import re, sys; sys.stdout.writelines(f"{match}\n" for match in re.findall(r"(?<!\w)(?:Closes|Fixes|Resolves)[ \t]+#([0-9]+)(?!\w)", sys.stdin.read()))' \
        <<<"${PR_BODY:-}"
    )
    if (( ${#body_closing_issues[@]} != 1 )) || [[ "${body_closing_issues[0]}" != "$issue_number" ]]; then
      fail "PR body: not exactly one closing keyword for Issue #${issue_number}. Keep one 'Closes #${issue_number}'."
    fi
  fi
fi
if [[ "${tracker_promotion:-false}" != "true" ]] && [[ "$pr_draft" != "true" ]] && [[ "$issue_has_unchecked" == "true" ]]; then
  fail "Issue #${issue_number}: unchecked acceptance tasks. Complete them."
fi
validate_requirement_trace
if [[ "${tracker_promotion:-false}" == "true" ]]; then
  if [[ "$issue_title" != "Milestone ${promotion_milestone}: "* ]]; then
    fail "Milestone ${promotion_milestone} promotion: wrong tracker Issue. Reference its own tracker."
  fi
  if [[ "$issue_milestone_number" != "$promotion_milestone" ]]; then
    fail "Tracker Issue Milestone: differs from the delivery branch. Set the tracker Milestone."
  fi
  python3 scripts/promotion_gate.py check-alignment \
    --body "${PR_BODY:-}" --head-sha "${PR_HEAD_SHA:-}"
  if ! printf '%s' "$issue_body" | python3 scripts/sync_milestone_state.py check-promotion; then
    exit 1
  fi
fi
if [[ -x ./scripts/validate-issue-title ]]; then
  ./scripts/validate-issue-title "$issue_title"
fi

if [[ "${promotion:-false}" == "true" ]]; then
    if [[ "${tracker_promotion:-false}" != "true" ]]; then
      if [[ ",${issue_labels:-}," != *,promotion,* ]]; then
        fail "Delivery promotion: closed Issue has no promotion label. Add it."
      fi
      if [[ -n "${promotion_milestone:-}" && "$issue_milestone_number" != "$promotion_milestone" ]]; then
        fail "Promotion Issue Milestone: differs from the delivery branch. Set the Issue Milestone."
      fi
      if [[ -n "${promotion_issue:-}" && "$issue_number" != "$promotion_issue" ]]; then
        fail "Isolated delivery branch: number differs from its Issue. Use dev/i<Issue>-<slug>."
      fi
      if [[ -z "${promotion_milestone:-}" && "$issue_milestone_number" != "0" ]]; then
        fail "Standalone promotion Issue: has a Milestone. Remove it."
      fi
    fi
    if [[ -n "${promotion_milestone:-}" ]]; then
      if [[ "${PR_POLICY_FIXTURE:-false}" == "true" ]]; then
        included_titles="${PR_INCLUDED_TITLES_JSON:-$(jq -cn --arg title "$PR_TITLE" '[$title]')}"
        python3 scripts/promotion_gate.py check-intent \
          --title "$PR_TITLE" \
          --titles-json "$included_titles"
      elif [[ -n "${PR_INCLUDED_TITLES_JSON:-}" ]]; then
        # Test-only override: exercise title/intent validation without a
        # live GitHub compare call. Real runs never set this variable.
        python3 scripts/promotion_gate.py check-intent \
          --title "$PR_TITLE" \
          --titles-json "$PR_INCLUDED_TITLES_JSON"
      else
        if [[ -z "${PR_BASE_SHA:-}" || -z "${PR_HEAD_SHA:-}" ]]; then
          fail "Promotion intent: no exact base and head SHAs. Set PR_BASE_SHA and PR_HEAD_SHA."
        fi
        delivery_branch="$PR_HEAD"
        bridge_arguments=()
        if [[ "$PR_HEAD" == promote/* ]]; then
          delivery_branch="dev/${PR_HEAD#promote/}"
          bridge_arguments=(--bridge-head-sha "$PR_HEAD_SHA")
        fi
        python3 scripts/promotion_gate.py check-intent \
          --repo "$GITHUB_REPOSITORY" \
          --base-sha "$PR_BASE_SHA" \
          --head-sha "$PR_HEAD_SHA" \
          --delivery-branch "$delivery_branch" \
          --milestone "$promotion_milestone" \
          --title "$PR_TITLE" \
          "${bridge_arguments[@]}"
      fi
    fi
    exit 0
fi

if (( delivery_cutover_issue > 0 && issue_number < delivery_cutover_issue )); then
    expected_base_kind="exact"
    expected_base="main"
  elif [[ "$PR_BASE" == "main" ]]; then
    if [[ "$release_recovery" == "true" ]]; then
      exit 0
    fi
    if [[ "$PR_HEAD" == fix/* && ",${PR_LABELS:-}," == *,hotfix,* ]]; then
      if [[ "$issue_milestone_number" != "0" ]]; then
        fail "Direct hotfix: has a Milestone. Remove it."
      fi
      exit 0
    fi
    if [[ "$issue_milestone_number" != "0" ]]; then
      fail "Milestone work: wrong base. Target its dev/m<Milestone>-* branch."
    fi
    expected_base_kind="exact"
    expected_base="main"
  elif [[ "$issue_milestone_number" == "0" ]]; then
    expected_base_kind="exact"
    expected_base="main"
  else
    expected_base_kind="milestone"
    expected_base="dev/m${issue_milestone_number}-"
  fi

  if [[ "$PR_BASE" =~ ^dev/m([0-9]+)-[a-z0-9][a-z0-9-]*$ ]] &&
    [[ "$issue_milestone_number" != "${BASH_REMATCH[1]}" ]]; then
    if [[ "$issue_milestone_number" == "0" ]]; then
      issue_milestone_description="none (number 0)"
    else
      issue_milestone_description="${issue_milestone_number}"
    fi
    fail "Issue #${issue_number} Milestone ${issue_milestone_description}: base '${PR_BASE}' is wrong. Use '${expected_base}'."
fi

base_branch="$PR_BASE"
seen_bases="|"
while true; do
  if [[ "$base_branch" == "dev/next" || "$base_branch" == "promote/next" ]]; then
    fail "PR base: legacy standalone delivery branch. Use a current base."
  fi
  if [[ "$expected_base_kind" == "exact" && "$base_branch" == "$expected_base" ]]; then
    break
  fi
  if [[ "$expected_base_kind" == "milestone" && "$base_branch" =~ ^${expected_base}[a-z0-9][a-z0-9-]*$ ]]; then
    break
  fi
  if [[ "$seen_bases" == *"|${base_branch}|"* ]]; then
    fail "PR base chain: cycle at ${base_branch}. Fix the bases."
  fi
  seen_bases+="${base_branch}|"

  if ! parent_output="$(
    gh api --paginate --method GET "repos/$GITHUB_REPOSITORY/pulls" \
      -f state=open \
      -f head="${GITHUB_REPOSITORY%%/*}:${base_branch}" \
      --jq '.[].base.ref'
  )"; then
    fail "Base branch ${base_branch}: cannot read its open PR. Retry the check."
  fi
  parent_bases=()
  while IFS= read -r parent_base; do
    [[ -n "$parent_base" ]] && parent_bases+=("$parent_base")
  done <<<"$parent_output"
  if (( ${#parent_bases[@]} != 1 )); then
    fail "Base branch ${base_branch}: not exactly one open PR. Chain it to '${expected_base}'."
  fi
  base_branch="${parent_bases[0]}"
done

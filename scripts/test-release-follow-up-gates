#!/usr/bin/env bash
# shellcheck disable=SC2016 # Assertions intentionally match literal workflow expressions.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

required_workflows=(
  promotion-post-merge.yml
  promotion.yml
  release-follow-up-policy.yml
  release-please.yml
)
for workflow in "${required_workflows[@]}"; do
  if [[ ! -f "$repo_root/.github/workflows/$workflow" ]]; then
    echo "Release follow-up workflow tests skipped: workflows are archived."
    exit 0
  fi
done

fixture="$(mktemp -d)"
gate="$fixture/post-merge-gate"
premerge_gate="$fixture/pre-merge-gate"
release_gate="$fixture/release-source-gate"
trap 'rm -rf "$fixture"' EXIT

{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  awk '
    /^      - name: Resolve the merged pull request and its evidence$/ { found = 1; next }
    found && /^        run: \|$/ { in_run = 1; next }
    in_run && /^$/ { print; next }
    in_run && /^          / { sub(/^          /, ""); print; next }
    in_run { exit }
  ' "$repo_root/.github/workflows/promotion-post-merge.yml"
} > "$gate"
chmod +x "$gate"

{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  awk '
    /^          if \[\[ "\$GITHUB_EVENT_NAME" == "pull_request" && "\$PR_HEAD" == release-please--\* \]\]; then$/ { in_gate = 1 }
    in_gate && /^          / {
      sub(/^          /, "")
      print
      if ($0 == "fi") exit
    }
  ' "$repo_root/.github/workflows/promotion.yml"
} > "$premerge_gate"
chmod +x "$premerge_gate"

{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  awk '
    /^      - name: Require an eligible main source$/ { found = 1; next }
    found && /^        run: \|$/ { in_run = 1; next }
    in_run && /^$/ { print; next }
    in_run && /^          / { sub(/^          /, ""); print; next }
    in_run { exit }
  ' "$repo_root/.github/workflows/release-please.yml"
} > "$release_gate"
chmod +x "$release_gate"

if ! grep -q 'pull_request_count' "$gate"; then
  echo "Could not extract the post-merge release follow-up gate." >&2
  exit 1
fi
if ! grep -q 'git archive "$PR_BASE_SHA"' "$premerge_gate"; then
  echo "Could not extract the pre-merge release follow-up gate." >&2
  exit 1
fi
if ! grep -q 'pull_request_count' "$release_gate"; then
  echo "Could not extract the release source gate." >&2
  exit 1
fi

for workflow in \
  "$repo_root/.github/workflows/promotion-post-merge.yml" \
  "$repo_root/.github/workflows/release-please.yml"; do
  grep -Fq '.merge_commit_sha == $sha' "$workflow"
  grep -Fq 'commits/$GITHUB_SHA/pulls?per_page=100' "$workflow"
  grep -Fq 'pulls/$pr_number/files?per_page=100' "$workflow"
  grep -Fq 'pulls/$pr_number/commits?per_page=100' "$workflow"
  grep -Fq 'git archive "$base_sha"' "$workflow"
  grep -Fq '"$trusted_root/scripts/release_policy.py" verify-release-follow-up' "$workflow"
  if grep -Fq '"$GITHUB_SHA^" "$GITHUB_SHA"' "$workflow"; then
    echo "Post-merge release verification still checks only the final commit." >&2
    exit 1
  fi
  if grep -Fq 'last // empty' "$workflow"; then
    echo "Post-merge source selection still accepts an arbitrary associated PR." >&2
    exit 1
  fi
done

grep -Fq 'git archive "$PR_BASE_SHA"' \
  "$repo_root/.github/workflows/promotion.yml"
grep -Fq 'commits/$main_sha/pulls?per_page=100' \
  "$repo_root/.github/workflows/release-please.yml"
grep -Fq -- '--paginate --slurp' \
  "$repo_root/.github/workflows/release-please.yml"
grep -Fq 'git describe --tags --abbrev=0 "$GITHUB_SHA^"' \
  "$repo_root/.github/workflows/release-please.yml"
grep -Fq 'git rev-list --first-parent --reverse "$revision"' \
  "$repo_root/.github/workflows/release-please.yml"
grep -Fq -- '--source-kind "$source_kind"' \
  "$repo_root/.github/workflows/release-please.yml"
if grep -Fq -- '--kind main-release-follow-up' \
  "$repo_root/.github/workflows/release-please.yml"; then
  echo "Release follow-up bypasses historical promotion evidence." >&2
  exit 1
fi
grep -Fq '"$base_sha" == "$PUSH_BEFORE"' \
  "$repo_root/.github/workflows/promotion-post-merge.yml"
grep -Fq '"$base_sha" == "$expected_base"' \
  "$repo_root/.github/workflows/release-please.yml"
trusted_workflow="$repo_root/.github/workflows/release-follow-up-policy.yml"
grep -Fq 'pull_request_target:' "$trusted_workflow"
grep -Fq 'ref: ${{ github.event.repository.default_branch }}' "$trusted_workflow"
grep -Fq 'rules/branches/$encoded_base' "$trusted_workflow"
grep -Fq '.type == "workflows"' "$trusted_workflow"
grep -Fq '.path == ".github/workflows/release-follow-up-policy.yml"' \
  "$trusted_workflow"
grep -Fq '.repository_id == $repository_id' "$trusted_workflow"
[[ "$(grep -Fc 'git/ref/heads/$encoded_base' "$trusted_workflow")" == 2 ]]
if grep -Eq 'ref:.*pull_request.*head|checkout.*pull_request.*head' \
  "$trusted_workflow"; then
  echo "Trusted release policy must not check out the pull-request head." >&2
  exit 1
fi
matching_workflows="$(
  grep -RFlx '    name: release-follow-up' "$repo_root/.github/workflows"
)" || {
  echo "Cannot inspect release-follow-up workflow ownership." >&2
  exit 1
}
if grep -Fvx "$trusted_workflow" <<<"$matching_workflows" | grep -q .; then
  echo "An untrusted workflow can spoof the release-follow-up context." >&2
  exit 1
fi

mkdir -p "$fixture/bin"
cat > "$fixture/bin/gh" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

case "$*" in
  *"rules/branches/main"*)
    [[ "${MOCK_RULES_UNAVAILABLE:-false}" != true ]] || exit 1
    jq -cn --argjson repository_id "${MOCK_REPOSITORY_ID:-123}" '[{
      type: "workflows",
      parameters: {workflows: [{
        path: ".github/workflows/release-follow-up-policy.yml",
        ref: "refs/heads/main",
        repository_id: $repository_id
      }]}
    }]'
    ;;
  *"--jq .id"*)
    printf '%s\n' "${MOCK_REPOSITORY_ID:-123}"
    ;;
  "run list "*)
    count_file="$RUNNER_TEMP/post-merge-run-list-count"
    count="$(cat "$count_file" 2>/dev/null || printf '0')"
    count=$((count + 1))
    printf '%s\n' "$count" > "$count_file"
    if [[ "${MOCK_POST_MERGE_RUN:-true}" == true && \
      "$count" -gt "${MOCK_POST_MERGE_PENDING_ATTEMPTS:-0}" ]]; then
      printf '123\n'
    fi
    ;;
  "run download "*)
    output_dir=""
    while [[ "$#" -gt 0 ]]; do
      if [[ "$1" == --dir ]]; then
        output_dir="$2"
        break
      fi
      shift
    done
    [[ -n "$output_dir" ]]
    mkdir -p "$output_dir"
    jq -n \
      --arg repo "$GITHUB_REPOSITORY" \
      --arg head "$MOCK_BOUNDARY_SHA" \
      --arg main "$MOCK_BOUNDARY_SHA" \
      --arg tree_identity "${MOCK_BOUNDARY_TREE_IDENTITY:-verified}" \
      --argjson release_eligible "${MOCK_BOUNDARY_RELEASE_ELIGIBLE:-true}" \
      '{
        gate: "passed",
        release_eligible: $release_eligible,
        repository: $repo,
        pull_request: 50,
        head_sha: $head,
        head_ref: "dev/m7-staged-ci",
        route: {kind: "milestone", milestone: 7},
        included_issues: [{number: 7, title: "Work"}],
        release: {
          intent: "minor",
          included_pull_requests: [{number: 7, title: "feat: work", intent: "minor"}]
        },
        post_merge: {main_sha: $main, tree_identity: $tree_identity}
      }' > "$output_dir/main-promotion-evidence.json"
    ;;
  *"/commits/"*"/pulls?per_page=100"*)
    [[ "$*" == *"--paginate"* && "$*" == *"--slurp"* ]]
    endpoint="${!#}"
    commit_sha="${endpoint#*\/commits\/}"
    commit_sha="${commit_sha%%/pulls*}"
    if [[ -n "${MOCK_STANDALONE_SHA:-}" && "$commit_sha" == "$MOCK_STANDALONE_SHA" ]]; then
      jq -cn --arg sha "$commit_sha" '[[{
        number: 60, title: "feat: standalone", labels: [],
        merged_at: "2026-08-23T00:00:00Z", merge_commit_sha: $sha,
        base: {ref: "main"}, head: {ref: "feat/60-standalone", sha: $sha}
      }]]'
    elif [[ -n "${MOCK_BOT_SHA:-}" && "$commit_sha" == "$MOCK_BOT_SHA" ]]; then
      jq -cn --arg sha "$commit_sha" '[[{
        number: 61, title: "fix: dependency", labels: [],
        merged_at: "2026-08-23T01:00:00Z", merge_commit_sha: $sha,
        base: {ref: "main"}, head: {ref: "dependabot/pip/httpx-1.0", sha: $sha}
      }]]'
    elif [[ -n "${MOCK_BOUNDARY_SHA:-}" &&
      "$*" == *"/commits/$MOCK_BOUNDARY_SHA/pulls?per_page=100"* ]]; then
      printf '%s\n' "$MOCK_BOUNDARY_PULL_REQUEST_PAGES"
    elif [[ -n "${MOCK_PULL_REQUEST_PAGES:-}" ]]; then
      printf '%s\n' "$MOCK_PULL_REQUEST_PAGES"
    else
      jq -cn --argjson page "$MOCK_PULL_REQUESTS" '[$page]'
    fi
    ;;
  *"/collaborators/"*"/permission"*)
    printf '%s\n' "${MOCK_ACTOR_PERMISSION:-write}"
    ;;
  *"/pulls/"*"/commits?per_page=100"*)
    [[ "$*" == *"--paginate"* && "$*" == *"--slurp"* ]]
    jq -cn \
      --arg sha "$MOCK_HEAD_SHA" \
      --arg author "${MOCK_COMMIT_AUTHOR:-github-actions[bot]}" \
      --arg committer "${MOCK_COMMITTER:-web-flow}" \
      '[[{sha: $sha, author: {login: $author}, committer: {login: $committer}, commit: {verification: {verified: true, reason: "valid"}}}]]'
    ;;
  *"/pulls/"*"/files?per_page=100"*)
    [[ "$*" == *"--paginate"* && "$*" == *"--slurp"* ]]
    printf '%s\n' "$MOCK_CHANGED_FILES" | \
      jq -Rsc '
        split("\n")
        | map(
            select(length > 0)
            | if contains("=>") then
                split("=>") | {previous_filename: .[0], filename: .[1]}
              else
                {filename: .}
              end
          )
        | [.]
      '
    ;;
  *"/pulls/"*)
    if [[ -n "${MOCK_FILE_COUNT_OVERRIDE:-}" ]]; then
      printf '%s\n' "$MOCK_FILE_COUNT_OVERRIDE"
    else
      printf '%s\n' "$MOCK_CHANGED_FILES" | awk 'NF { count++ } END { print count + 0 }'
    fi
    ;;
  *)
    echo "Unexpected gh command: $*" >&2
    exit 2
    ;;
esac
SH
chmod +x "$fixture/bin/gh"

setup_repo() {
  local name="$1"
  test_repo="$fixture/$name"
  mkdir -p "$test_repo/scripts"
  git -C "$test_repo" init -q -b main
  git -C "$test_repo" config user.email test@example.com
  git -C "$test_repo" config user.name Test
  cp "$repo_root/scripts/release_policy.py" "$test_repo/scripts/release_policy.py"
  cat > "$test_repo/release-please-config.json" <<'JSON'
{
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "demo"
    }
  }
}
JSON
  printf '0.1.0\n' > "$test_repo/version.txt"
  git -C "$test_repo" add .
  git -C "$test_repo" commit -qm "base"
  base_sha="$(git -C "$test_repo" rev-parse HEAD)"
}

commit_all() {
  local repo="$1"
  local message="$2"
  git -C "$repo" add .
  git -C "$repo" commit -qm "$message"
}

pull_request_json() {
  local base="$1"
  local head="$2"
  local number="${3:-42}"
  local actor="${4:-github-actions[bot]}"
  jq -cn \
    --arg base "$base" \
    --arg head "$head" \
    --argjson number "$number" \
    --arg actor "$actor" \
    '[{
      number: $number,
      title: "chore(main): release 0.2.0",
      labels: [],
      merged_at: "2026-08-24T00:00:00Z",
      merge_commit_sha: $head,
      base: {ref: "main", sha: $base},
      head: {
        ref: "release-please--branches--main--components--demo",
        sha: $head,
        repo: {full_name: "owner/repo"}
      },
      user: {login: $actor}
    }]'
}

run_gate() {
  local repo="$1"
  local pull_requests="$2"
  local changed_files="$3"
  local expected_file_count="${4:-}"
  local pull_request_pages="${5:-}"
  local committer="${6:-web-flow}"
  local author="${7:-github-actions[bot]}"
  local actor_permission="${8:-write}"
  local push_before="${9:-$(git -C "$repo" rev-parse HEAD^)}"
  local runner_temp="$repo/runner-temp"
  mkdir -p "$runner_temp"
  (
    cd "$repo"
    PATH="$fixture/bin:$PATH" \
      MOCK_PULL_REQUESTS="$pull_requests" \
      MOCK_PULL_REQUEST_PAGES="$pull_request_pages" \
      MOCK_CHANGED_FILES="$changed_files" \
      MOCK_FILE_COUNT_OVERRIDE="$expected_file_count" \
      MOCK_HEAD_SHA="$(git rev-parse HEAD)" \
      MOCK_COMMITTER="$committer" \
      MOCK_COMMIT_AUTHOR="$author" \
      MOCK_ACTOR_PERMISSION="$actor_permission" \
      MOCK_RULES_UNAVAILABLE="${MOCK_RULES_UNAVAILABLE:-false}" \
      GITHUB_REPOSITORY="owner/repo" \
      GITHUB_SHA="$(git rev-parse HEAD)" \
      PUSH_BEFORE="$push_before" \
      GITHUB_OUTPUT="$runner_temp/github-output" \
      GH_TOKEN="test-token" \
      RUNNER_TEMP="$runner_temp" \
      "$gate"
  )
}

run_premerge_gate() {
  local repo="$1"
  local base="$2"
  local committer="${3:-web-flow}"
  local runner_temp="$repo/pre-merge-runner-temp"
  mkdir -p "$runner_temp"
  (
    cd "$repo"
    PATH="$fixture/bin:$PATH" \
      MOCK_HEAD_SHA="$(git rev-parse HEAD)" \
      MOCK_COMMITTER="$committer" \
      GITHUB_EVENT_NAME="pull_request" \
      GITHUB_REPOSITORY="owner/repo" \
      PR_AUTHOR="github-actions[bot]" \
      PR_BASE_SHA="$base" \
      PR_HEAD="release-please--branches--main--components--demo" \
      PR_HEAD_REPOSITORY="owner/repo" \
      PR_HEAD_SHA="$(git rev-parse HEAD)" \
      PR_NUMBER="42" \
      RUNNER_TEMP="$runner_temp" \
      "$premerge_gate"
  )
}

run_release_gate() {
  local repo="$1"
  local pull_requests="$2"
  local pull_request_pages="${3:-}"
  local committer="${4:-web-flow}"
  local boundary_pull_request_pages="${5:-}"
  local author="${6:-github-actions[bot]}"
  local actor_permission="${7:-write}"
  local push_before="${8:-$(git -C "$repo" rev-parse HEAD^)}"
  local runner_temp="$repo/release-runner-temp"
  local boundary_sha
  boundary_sha="${MOCK_BOUNDARY_SHA_OVERRIDE:-$(git -C "$repo" rev-parse HEAD^)}"
  if [[ -z "$boundary_pull_request_pages" ]]; then
    boundary_pull_request_pages="$(
      jq -cn --arg sha "$boundary_sha" '[[{
        number: 50,
        title: "feat: promote batch",
        labels: [{name: "promotion"}],
        merged_at: "2026-08-23T00:00:00Z",
        merge_commit_sha: $sha,
        base: {ref: "main"},
        head: {ref: "dev/m7-staged-ci", sha: $sha}
      }]]'
    )"
  fi
  rm -rf "$repo/promotion-boundaries" "$repo/verified-boundaries"
  rm -f "$runner_temp/post-merge-run-list-count"
  mkdir -p "$runner_temp"
  (
    cd "$repo"
    PATH="$fixture/bin:$PATH" \
      MOCK_PULL_REQUESTS="$pull_requests" \
      MOCK_PULL_REQUEST_PAGES="$pull_request_pages" \
      MOCK_BOUNDARY_PULL_REQUEST_PAGES="$boundary_pull_request_pages" \
      MOCK_BOUNDARY_SHA="$boundary_sha" \
      MOCK_BOUNDARY_RELEASE_ELIGIBLE="${MOCK_BOUNDARY_RELEASE_ELIGIBLE:-true}" \
      MOCK_BOUNDARY_TREE_IDENTITY="${MOCK_BOUNDARY_TREE_IDENTITY:-verified}" \
      MOCK_POST_MERGE_RUN="${MOCK_POST_MERGE_RUN:-true}" \
      MOCK_POST_MERGE_PENDING_ATTEMPTS="${MOCK_POST_MERGE_PENDING_ATTEMPTS:-0}" \
      MOCK_STANDALONE_SHA="${MOCK_STANDALONE_SHA:-}" \
      MOCK_BOT_SHA="${MOCK_BOT_SHA:-}" \
      MOCK_CHANGED_FILES="CHANGELOG.md" \
      MOCK_HEAD_SHA="$(git rev-parse HEAD)" \
      MOCK_COMMITTER="$committer" \
      MOCK_COMMIT_AUTHOR="$author" \
      MOCK_ACTOR_PERMISSION="$actor_permission" \
      MOCK_RULES_UNAVAILABLE="${MOCK_RULES_UNAVAILABLE:-false}" \
      CANONICAL_REPOSITORY="canonical/repo" \
      CSARC_POST_MERGE_POLL_SECONDS=0 \
      GITHUB_EVENT_NAME="push" \
      GITHUB_REPOSITORY="owner/repo" \
      GITHUB_SHA="$(git rev-parse HEAD)" \
      PUSH_BEFORE="$push_before" \
      GITHUB_OUTPUT="$runner_temp/github-output" \
      GH_TOKEN="test-token" \
      RUNNER_TEMP="$runner_temp" \
      "$release_gate"
  )
}

setup_repo valid
printf '# Changelog\n' > "$test_repo/CHANGELOG.md"
commit_all "$test_repo" "release"
head_sha="$(git -C "$test_repo" rev-parse HEAD)"
run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  "CHANGELOG.md" >/dev/null
run_premerge_gate "$test_repo" "$base_sha" >/dev/null
run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null
MOCK_POST_MERGE_PENDING_ATTEMPTS=2 run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null
if MOCK_BOUNDARY_RELEASE_ELIGIBLE=false run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null 2>&1; then
  echo "Release source gate accepted release-ineligible promotion evidence." >&2
  exit 1
fi
if MOCK_BOUNDARY_TREE_IDENTITY=failed run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null 2>&1; then
  echo "Release source gate accepted failed post-merge identity evidence." >&2
  exit 1
fi
if MOCK_POST_MERGE_RUN=false run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null 2>&1; then
  echo "Release source gate accepted missing post-merge identity evidence." >&2
  exit 1
fi

(
  setup_repo mixed-history
  git -C "$test_repo" tag v0.1.0
  printf 'standalone\n' > "$test_repo/standalone.txt"
  commit_all "$test_repo" "feat: standalone"
  standalone_sha="$(git -C "$test_repo" rev-parse HEAD)"
  printf 'bot\n' > "$test_repo/bot.txt"
  commit_all "$test_repo" "fix: dependency"
  bot_sha="$(git -C "$test_repo" rev-parse HEAD)"
  printf 'promotion\n' > "$test_repo/promotion.txt"
  commit_all "$test_repo" "feat: promote batch"
  promotion_sha="$(git -C "$test_repo" rev-parse HEAD)"
  printf '# Changelog\n' > "$test_repo/CHANGELOG.md"
  commit_all "$test_repo" "release"
  release_sha="$(git -C "$test_repo" rev-parse HEAD)"
  MOCK_STANDALONE_SHA="$standalone_sha" MOCK_BOT_SHA="$bot_sha" \
    MOCK_BOUNDARY_SHA_OVERRIDE="$promotion_sha" \
    run_release_gate "$test_repo" \
    "$(pull_request_json "$promotion_sha" "$release_sha")" >/dev/null
  jq -e '
    .kind == "release-follow-up" and
    .release.intent == "minor" and
    ([.release.included_pull_requests[].number] | sort) == [7, 60, 61] and
    ([.boundaries[].kind] | unique) == ["main-strategy", "milestone"]
  ' "$test_repo/main-release-source.json" >/dev/null
)
if MOCK_RULES_UNAVAILABLE=true run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  "CHANGELOG.md" >/dev/null 2>&1; then
  echo "Post-merge gate accepted a release follow-up without trusted workflow evidence." >&2
  exit 1
fi
if MOCK_RULES_UNAVAILABLE=true run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" >/dev/null 2>&1; then
  echo "Release source gate accepted a release follow-up without trusted workflow evidence." >&2
  exit 1
fi

human_pull="$(pull_request_json "$base_sha" "$head_sha" 42 maintainer)"
run_gate "$test_repo" "$human_pull" "CHANGELOG.md" "" "" web-flow \
  maintainer maintain >/dev/null
run_release_gate "$test_repo" "$human_pull" "" web-flow "" \
  maintainer maintain >/dev/null
if run_gate "$test_repo" "$human_pull" "CHANGELOG.md" "" "" web-flow \
  maintainer write >/dev/null 2>&1; then
  echo "Post-merge gate accepted a human release owner without maintain permission." >&2
  exit 1
fi
if run_gate "$test_repo" "$(pull_request_json "$base_sha" "$head_sha")" \
  "CHANGELOG.md" "" "" web-flow \
  github-actions\[bot\] write "$(printf 'b%.0s' {1..40})" >/dev/null 2>&1; then
  echo "Post-merge gate accepted a push before SHA that was not the merge parent." >&2
  exit 1
fi
if run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" "" web-flow "" \
  github-actions\[bot\] write "$(printf 'b%.0s' {1..40})" >/dev/null 2>&1; then
  echo "Release source gate accepted a push before SHA that was not the merge parent." >&2
  exit 1
fi

if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  "CHANGELOG.md" "" "" "maintainer" >/dev/null 2>&1; then
  echo "Post-merge gate accepted a human commit on the automation PR." >&2
  exit 1
fi
if run_premerge_gate "$test_repo" "$base_sha" "maintainer" \
  >/dev/null 2>&1; then
  echo "Pre-merge gate accepted a human commit on the automation PR." >&2
  exit 1
fi
if run_release_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" "" "maintainer" \
  >/dev/null 2>&1; then
  echo "Release source gate accepted a human commit on the automation PR." >&2
  exit 1
fi

if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  "CHANGELOG.md" 2 >/dev/null 2>&1; then
  echo "Post-merge gate accepted an incomplete paginated file list." >&2
  exit 1
fi

if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  "src/product.py=>CHANGELOG.md" >/dev/null 2>&1; then
  echo "Post-merge gate ignored a renamed non-release source file." >&2
  exit 1
fi

if run_gate "$test_repo" '[]' "CHANGELOG.md" >/dev/null 2>&1; then
  echo "Post-merge gate accepted a commit without an exact source PR." >&2
  exit 1
fi
if run_release_gate "$test_repo" '[]' >/dev/null 2>&1; then
  echo "Release source gate accepted a commit without an exact source PR." >&2
  exit 1
fi

single_pr="$(pull_request_json "$base_sha" "$head_sha")"
ambiguous="$(jq -cn --argjson first "$single_pr" --argjson second "$single_pr" '$first + ($second | map(.number = 43))')"
if run_gate "$test_repo" "$ambiguous" "CHANGELOG.md" >/dev/null 2>&1; then
  echo "Post-merge gate accepted ambiguous exact source PRs." >&2
  exit 1
fi
if run_release_gate "$test_repo" "$ambiguous" >/dev/null 2>&1; then
  echo "Release source gate accepted ambiguous exact source PRs." >&2
  exit 1
fi

first_page="$(jq -cn --argjson exact "$single_pr" '$exact + [range(29) | {}]')"
second_page="$(pull_request_json "$base_sha" "$head_sha" 43)"
paginated_ambiguous="$(
  jq -cn \
    --argjson first "$first_page" \
    --argjson second "$second_page" \
    '[$first, $second]'
)"
if run_gate \
  "$test_repo" "$single_pr" "CHANGELOG.md" "" "$paginated_ambiguous" \
  >/dev/null 2>&1; then
  echo "Post-merge gate ignored an exact source PR on page two." >&2
  exit 1
fi
if run_release_gate \
  "$test_repo" "$single_pr" "$paginated_ambiguous" >/dev/null 2>&1; then
  echo "Release source gate ignored an exact source PR on page two." >&2
  exit 1
fi

boundary_exact="$(
  jq -cn \
    --arg sha "$base_sha" \
    '[{
      number: 50,
      title: "feat: promote batch",
      labels: [{name: "promotion"}],
      merged_at: "2026-08-23T00:00:00Z",
      merge_commit_sha: $sha,
      base: {ref: "main"},
      head: {ref: "dev/m7-staged-ci", sha: $sha}
    }]'
)"
boundary_page_one="$(
  jq -cn --argjson exact "$boundary_exact" '$exact + [range(29) | {}]'
)"
boundary_page_two="$(jq -cn --argjson exact "$boundary_exact" '$exact | map(.number = 51)')"
boundary_paginated_ambiguous="$(
  jq -cn \
    --argjson first "$boundary_page_one" \
    --argjson second "$boundary_page_two" \
    '[$first, $second]'
)"
if run_release_gate "$test_repo" "$single_pr" "" web-flow \
  "$boundary_paginated_ambiguous" >/dev/null 2>&1; then
  echo "Release source history ignored an exact boundary PR on page two." >&2
  exit 1
fi

setup_repo multi-commit
mkdir -p "$test_repo/src"
printf 'unsafe\n' > "$test_repo/src/product.py"
commit_all "$test_repo" "change product source"
printf '# Changelog\n' > "$test_repo/CHANGELOG.md"
commit_all "$test_repo" "update changelog"
head_sha="$(git -C "$test_repo" rev-parse HEAD)"
if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  $'src/product.py\nCHANGELOG.md' >/dev/null 2>&1; then
  echo "Post-merge gate ignored an earlier release PR source change." >&2
  exit 1
fi

setup_repo config-tamper
mkdir -p "$test_repo/src"
printf 'unsafe\n' > "$test_repo/src/product.py"
cat > "$test_repo/release-please-config.json" <<'JSON'
{
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "demo",
      "extra-files": ["release-please-config.json", "src/product.py"]
    }
  }
}
JSON
commit_all "$test_repo" "expand candidate allowlist"
head_sha="$(git -C "$test_repo" rev-parse HEAD)"
if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  $'release-please-config.json\nsrc/product.py' >/dev/null 2>&1; then
  echo "Post-merge gate trusted a candidate-expanded release allowlist." >&2
  exit 1
fi
if run_premerge_gate "$test_repo" "$base_sha" >/dev/null 2>&1; then
  echo "Pre-merge gate trusted a candidate-expanded release allowlist." >&2
  exit 1
fi

setup_repo validator-tamper
mkdir -p "$test_repo/src"
printf 'unsafe\n' > "$test_repo/src/product.py"
cat > "$test_repo/scripts/release_policy.py" <<'PY'
#!/usr/bin/env python3
raise SystemExit(0)
PY
commit_all "$test_repo" "disable candidate validator"
head_sha="$(git -C "$test_repo" rev-parse HEAD)"
if run_gate "$test_repo" \
  "$(pull_request_json "$base_sha" "$head_sha")" \
  $'scripts/release_policy.py\nsrc/product.py' >/dev/null 2>&1; then
  echo "Post-merge gate trusted a candidate-modified validator." >&2
  exit 1
fi
if run_premerge_gate "$test_repo" "$base_sha" >/dev/null 2>&1; then
  echo "Pre-merge gate trusted a candidate-modified validator." >&2
  exit 1
fi

echo "Release follow-up gate regression cases passed."

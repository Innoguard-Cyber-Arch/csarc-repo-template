#!/usr/bin/env bash
set -Eeuo pipefail

# "Regression tests" stage of scripts/verify-template.sh: the full pytest
# suite (including the `large` Copier create/existing-adoption/update
# preservation coverage that scripts/verify-fast deliberately excludes, and
# the verify-template.sh stage-split regression in tests/test_journey03_ci.py)
# with a coverage floor, plus the Issue-triage, worktree-cleanup,
# PR-policy, apply-repository-settings, repo-capabilities, scope-drift-gate,
# base-only-remerge, gh-issue-create, detect-open-milestone,
# check-branch-fresh, PR-policy-status, release-drift, audit-fleet-adoption,
# create-milestone, and verify-attestation (Issue #661) self-tests.
# This is the single executable regression source for create/adopt/update
# preservation; do not replace it with generated-profile runs elsewhere.
# Runnable standalone to re-check just this stage without paying for the
# full run; aggregated in order by scripts/verify-template.sh. See
# docs/ci-policy.md.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_root="$("$repo_root/scripts/resolve-cache-root")"
if [[ -n "${CSARC_CACHE_ROOT:-}" ]]; then
  export UV_CACHE_DIR="$cache_root/uv"
else
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$cache_root/uv}"
fi
export UV_PYTHON="${CSARC_PYTHON_VERSION:-3.14}"
cd "$repo_root"
source "$repo_root/scripts/verification-step"

verification_step "Python regression suite" \
  uv run pytest -vv --durations=20 \
  --cov=csarc_cli --cov-report=term-missing --cov-fail-under=80
verification_step "Issue-triage self-test" ./scripts/test-issue-triage
verification_step "Worktree-cleanup self-test" ./scripts/test-worktree-cleanup
verification_step "PR-policy self-test" ./scripts/test-pr-policy
verification_step "Repository-settings self-test" \
  ./scripts/test-apply-repository-settings
verification_step "Repository-capabilities self-test" \
  ./scripts/test-check-repo-capabilities
verification_step "Scope-drift-gate self-test" ./scripts/test-check-scope-gate
verification_step "Base-only-remerge self-test" \
  ./scripts/test-check-base-only-remerge
verification_step "Issue-creation self-test" ./scripts/test-gh-issue-create
verification_step "Open-milestone self-test" \
  ./scripts/test-detect-open-milestone
verification_step "Branch-freshness self-test" \
  ./scripts/test-check-branch-fresh
verification_step "PR-policy-status self-test" \
  ./scripts/test-check-pr-policy-status
verification_step "Release-drift self-test" ./scripts/test-check-release-drift
verification_step "Fleet-adoption self-test" \
  ./scripts/test-audit-fleet-adoption
verification_step "Milestone-creation self-test" ./scripts/test-create-milestone
verification_step "Verification-attestation self-test" \
  ./scripts/test-verify-attestation

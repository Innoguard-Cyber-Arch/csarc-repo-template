#!/usr/bin/env bash
set -Eeuo pipefail

# "Regression tests" stage of scripts/verify-template.sh: the full pytest
# suite (including the `large` Copier create/existing-adoption/update
# preservation coverage that scripts/verify-fast deliberately excludes, and
# the verify-template.sh stage-split regression in tests/test_journey03_ci.py)
# with a coverage floor, plus the Issue-triage, worktree-cleanup,
# PR-policy, base-only-remerge, gh-issue-create, and check-branch-fresh
# self-tests. This is the single executable regression source for
# create/adopt/update preservation; do not replace it with generated-profile
# runs elsewhere. Runnable standalone to re-check just this stage without
# paying for the full run; aggregated in order by scripts/verify-template.sh.
# See docs/ci-policy.md.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache_root="$("$repo_root/scripts/resolve-cache-root")"
if [[ -n "${CSARC_CACHE_ROOT:-}" ]]; then
  export UV_CACHE_DIR="$cache_root/uv"
else
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$cache_root/uv}"
fi
export UV_PYTHON="${CSARC_PYTHON_VERSION:-3.14}"
cd "$repo_root"

uv run pytest --cov=csarc_cli --cov-report=term-missing --cov-fail-under=80
./scripts/test-issue-triage
./scripts/test-worktree-cleanup
./scripts/test-pr-policy
./scripts/test-check-base-only-remerge
./scripts/test-gh-issue-create
./scripts/test-check-branch-fresh

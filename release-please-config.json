{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "component": "csarc-repo-template",
      "draft": true,
      "force-tag-creation": true,
      "include-component-in-tag": false,
      "label": "enhancement",
      "release-label": "enhancement",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value==\"csarc-repo-cli\")].version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "site/content/_index.zh-tw.md"
        },
        {
          "type": "generic",
          "path": "site/legacy/index.html"
        },
        {
          "type": "generic",
          "path": "docs/index.html"
        }
      ]
    }
  }
}
